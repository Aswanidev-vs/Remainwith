        async function applySenderEncoding(profile) {
            const sender = getVideoSender();
            if (!sender) return;

            const params = sender.getParameters();
            if (!params.encodings || params.encodings.length === 0) {
                params.encodings = [{}];
            }
            const encodingProfiles = getSimulcastEncodings(profile);
            params.encodings = params.encodings.map((encoding, index) => ({
                ...encoding,
                active: true,
                maxBitrate: encodingProfiles[Math.min(index, encodingProfiles.length - 1)].maxBitrate,
                maxFramerate: encodingProfiles[Math.min(index, encodingProfiles.length - 1)].maxFramerate,
                scaleResolutionDownBy: encodingProfiles[Math.min(index, encodingProfiles.length - 1)].scaleResolutionDownBy
            }));

            try {
                await sender.setParameters(params);
            } catch (error) {
                console.warn('Failed to apply sender parameters:', error);
            }
        }

        function buildVideoConstraints(profile, preferSharpness = false, strict = false) {
            const width = strict ? { min: profile.width, ideal: profile.width } : { ideal: profile.width };
            const height = strict ? { min: profile.height, ideal: profile.height } : { ideal: profile.height };
            const frameRate = preferSharpness
                ? { ideal: Math.min(profile.frameRate, 15), max: Math.min(profile.frameRate, 20) }
                : (strict ? { min: Math.min(profile.frameRate, 24), ideal: profile.frameRate, max: profile.frameRate } : { ideal: profile.frameRate, max: profile.frameRate });

            return { width, height, frameRate };
        }

        function attachTrackLifecycle(track) {
            if (!track) return;
            track.onended = () => {
                console.warn('Local track ended unexpectedly:', track.kind, track.id);
                scheduleReconnect('local-track-ended', 500);
            };
        }

        async function applyTrackConstraints(track, profile, preferSharpness = false) {
            if (!track || !track.applyConstraints) return;

            try {
                await track.applyConstraints(buildVideoConstraints(profile, preferSharpness, false));
            } catch (error) {
                console.warn('Failed to apply video constraints:', error);
            }
        }

        async function requestCameraTrack(profile, strict = false) {
            const stream = await navigator.mediaDevices.getUserMedia({
                video: buildVideoConstraints(profile, false, strict),
                audio: false
            });
            return stream.getVideoTracks()[0] || null;
        }

        async function ensureCameraTrackQuality(profile) {
            if (!cameraVideoTrack || isScreenSharing()) {
                return;
            }

            const settings = cameraVideoTrack.getSettings ? cameraVideoTrack.getSettings() : {};
            const width = settings.width || 0;
            const height = settings.height || 0;
            const alreadyMatches = width >= profile.width && height >= profile.height;

            if (selectedQuality === 'auto') {
                await applyTrackConstraints(cameraVideoTrack, profile, false);
                return;
            }

            if (alreadyMatches) {
                await applyTrackConstraints(cameraVideoTrack, profile, false);
                return;
            }

            let nextTrack = null;
            try {
                nextTrack = await requestCameraTrack(profile, true);
            } catch (error) {
                console.warn('Strict camera quality request failed, retrying with ideal constraints:', error);
                nextTrack = await requestCameraTrack(profile, false);
            }

            if (!nextTrack) {
                return;
            }

            const previousTrack = cameraVideoTrack;
            cameraVideoTrack = nextTrack;
            attachTrackLifecycle(cameraVideoTrack);
            await replaceVideoTrack(cameraVideoTrack);

            if (previousTrack && previousTrack.readyState === 'live') {
                previousTrack.onended = null;
                previousTrack.stop();
            }

            const nextSettings = cameraVideoTrack.getSettings ? cameraVideoTrack.getSettings() : {};
            console.log('Applied camera quality track:', nextSettings);

            if ((nextSettings.width || 0) < profile.width || (nextSettings.height || 0) < profile.height) {
                showPopupCard(
                    'Limited by camera',
                    `Requested ${profile.label}, but this device is sending ${nextSettings.width || '?'}x${nextSettings.height || '?'}.`
                );
            }
        }

        function getSimulcastEncodings(profile) {
            const lowScale = Math.max(1, profile.height / 360);
            const mediumScale = Math.max(1, profile.height / 720);

            return [
                { rid: 'q', maxBitrate: 350000, maxFramerate: Math.min(profile.frameRate, 15), scaleResolutionDownBy: lowScale },
                { rid: 'h', maxBitrate: Math.min(profile.maxBitrate, 1500000), maxFramerate: Math.min(profile.frameRate, 24), scaleResolutionDownBy: mediumScale },
                { rid: 'f', maxBitrate: profile.maxBitrate, maxFramerate: profile.frameRate, scaleResolutionDownBy: 1.0 }
            ];
        }

        async function applyQualityProfile() {
            const profile = getCurrentQualityProfile();
            updateStatsMeta();

            if (cameraVideoTrack) {
                await ensureCameraTrackQuality(profile);
            }
            if (isScreenSharing()) {
                const displayTrack = screenStream.getVideoTracks()[0];
                await applyTrackConstraints(displayTrack, profile, true);
            }

            await applySenderEncoding(profile);
        }

        function addLocalTrackToPeerConnection(track) {
            if (!pc || !localStream) return null;

            if (track.kind === 'video') {
                const transceiver = pc.addTransceiver(track, {
                    direction: 'sendrecv',
                    streams: [localStream],
                    sendEncodings: getSimulcastEncodings(getCurrentQualityProfile())
                });
                videoSender = transceiver.sender;
                return transceiver.sender;
            }

            return pc.addTrack(track, localStream);
        }

        async function replaceVideoTrack(nextTrack) {
            if (!nextTrack || !localStream) return;

            const currentTrack = localStream.getVideoTracks()[0];
            if (currentTrack && currentTrack.id === nextTrack.id) {
                await applyQualityProfile();
                localVideo.srcObject = localStream;
                return;
            }

            if (currentTrack) {
                localStream.removeTrack(currentTrack);
            }
            localStream.addTrack(nextTrack);
            localVideo.srcObject = localStream;

            const sender = getVideoSender();
            if (sender) {
                try {
                    await sender.replaceTrack(nextTrack);
                    videoSender = sender;
                } catch (error) {
                    console.error('Failed to replace outbound video track:', error);
                }
            }

            lastAppliedVideoTrack = nextTrack;
            await applyQualityProfile();
            updateStatsMeta();
        }

