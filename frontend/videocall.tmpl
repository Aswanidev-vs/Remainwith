        }

        function maybeAdjustAutoQuality(availableOutgoingBitrate) {
            if (selectedQuality !== 'auto') return;
            if (!availableOutgoingBitrate || availableOutgoingBitrate <= 0) return;

            let nextLevel = '720p';
            if (availableOutgoingBitrate > 2800000) {
                nextLevel = '1080p';
            } else if (availableOutgoingBitrate > 1400000) {
                nextLevel = '720p';
            } else if (availableOutgoingBitrate > 800000) {
                nextLevel = '480p';
            } else {
                nextLevel = '360p';
            }

            if (autoQualityLevel !== nextLevel) {
                autoQualityLevel = nextLevel;
                applyQualityProfile().catch(err => console.warn('Auto quality update failed:', err));
            }
        }

        async function refreshStatsPanel() {
            if (!pc) return;

            try {
                const stats = await pc.getStats();
                const now = performance.now();
                let outboundBytes = 0;
                let inboundBytes = 0;
                let availableOutgoingBitrate = 0;
                let currentRtt = 0;
                let localCandidateType = 'Unknown';
                let remoteCandidateType = 'Unknown';
                let actualResolution = '-';

                stats.forEach(report => {
                    if (report.type === 'outbound-rtp' && report.kind === 'video') {
                        outboundBytes += report.bytesSent || 0;
                        if (report.frameWidth && report.frameHeight) {
                            actualResolution = `${report.frameWidth}x${report.frameHeight}`;
                        }
                    }
                    if (report.type === 'inbound-rtp' && report.kind === 'video') {
                        inboundBytes += report.bytesReceived || 0;
                    }
                    if (report.type === 'candidate-pair' && report.state === 'succeeded') {
                        availableOutgoingBitrate = report.availableOutgoingBitrate || availableOutgoingBitrate;
                        currentRtt = report.currentRoundTripTime || currentRtt;
                        const localCand = report.localCandidateId ? stats.get(report.localCandidateId) : null;
                        const remoteCand = report.remoteCandidateId ? stats.get(report.remoteCandidateId) : null;
                        localCandidateType = localCand?.candidateType || localCandidateType;
                        remoteCandidateType = remoteCand?.candidateType || remoteCandidateType;
                    }
                });

                if (statsSnapshot) {
                    const elapsedSeconds = Math.max((now - statsSnapshot.timestamp) / 1000, 1);
                    const sendBps = Math.max(0, ((outboundBytes - statsSnapshot.outboundBytes) * 8) / elapsedSeconds);
                    const recvBps = Math.max(0, ((inboundBytes - statsSnapshot.inboundBytes) * 8) / elapsedSeconds);
                    setStatValue('statSendBitrate', formatBitrate(sendBps));
                    setStatValue('statRecvBitrate', formatBitrate(recvBps));
                }

                statsSnapshot = { timestamp: now, outboundBytes, inboundBytes };

                setStatValue('statUplink', availableOutgoingBitrate ? formatBitrate(availableOutgoingBitrate) : 'Unknown');
                setStatValue('statRtt', currentRtt ? `${Math.round(currentRtt * 1000)} ms` : '-');
                setStatValue('statResolution', actualResolution);

                const navConnection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
                if (navConnection) {
                    const downlink = navConnection.downlink ? `${navConnection.downlink} Mbps` : 'Unknown';
                    const effectiveType = navConnection.effectiveType || 'Unknown';
                    setStatValue('statNetwork', `${effectiveType} / ${downlink}`);
                } else {
                    setStatValue('statNetwork', `${localCandidateType} -> ${remoteCandidateType}`);
                }

                maybeAdjustAutoQuality(availableOutgoingBitrate);
                updateStatsMeta();
            } catch (error) {
                console.warn('Stats refresh failed:', error);
            }
        }

        async function changeQuality(nextQuality = selectedQuality) {
            selectedQuality = nextQuality;
            await applyQualityProfile();
            await refreshStatsPanel();
        }

        function changeReceiveQuality(nextQuality = selectedReceiveQuality) {
            selectedReceiveQuality = nextQuality;
            syncQualityControlState();
            sendSFUMessage({
                type: 'quality_preference',
                quality: selectedReceiveQuality
            });
        }

        async function toggleScreenShare() {
            if (isScreenSharing()) {
                await stopScreenShare();
                return;
            }

            try {
                const profile = getCurrentQualityProfile();
                screenStream = await navigator.mediaDevices.getDisplayMedia({
                    video: {
                        width: { ideal: profile.width },
                        height: { ideal: profile.height },
                        frameRate: { ideal: Math.min(profile.frameRate, 15), max: 20 }
                    },
                    audio: false
                });

                const displayTrack = screenStream.getVideoTracks()[0];
                if (!displayTrack) {
                    throw new Error('No display track returned');
                }

                displayTrack.onended = () => {
                    stopScreenShare().catch(err => console.error('Failed to stop screen share cleanly:', err));
                };

                await replaceVideoTrack(displayTrack);
                btnShare.classList.add('sharing');
                btnShare.querySelector('span').textContent = 'stop_screen_share';
                updateStatsMeta();
                showPopupCard('Screen sharing started', 'Your screen is now being shared in this call.', 2200);
            } catch (error) {
                console.error('Screen share failed:', error);
                const message = error && error.name === 'NotAllowedError'
                    ? 'Screen sharing permission was denied.'
                    : (error && error.message ? error.message : 'Unable to start screen sharing.');
                showPopupCard('Screen share unavailable', message);
            }
        }

        async function stopScreenShare() {
            if (!isScreenSharing()) return;

            const displayTrack = screenStream.getVideoTracks()[0];
            if (displayTrack) {
                displayTrack.onended = null;
            }

            screenStream.getTracks().forEach(track => track.stop());
            screenStream = null;

            if (cameraVideoTrack) {
                await replaceVideoTrack(cameraVideoTrack);
            }

            btnShare.classList.remove('sharing');
            btnShare.querySelector('span').textContent = 'screen_share';
            updateStatsMeta();
            showPopupCard('Screen sharing stopped', 'You switched back to your camera.', 2200);
        }

        function updateStatus(status) {
            callStatus.textContent = status;
            if (status === 'Connected') {
                statusOverlay.style.display = 'none';
            }
        }

        function toggleMic() {
            if (!localStream) return;
            const audioTrack = localStream.getAudioTracks()[0];
            if (audioTrack) {
                audioTrack.enabled = !audioTrack.enabled;
                btnMic.classList.toggle('toggled-off', !audioTrack.enabled);
                btnMic.querySelector('span').textContent = audioTrack.enabled ? 'mic' : 'mic_off';

                sendRoomMessage({
                    type: 'mute',
                    data: !audioTrack.enabled
                });
            }
        }

        function toggleCam() {
            if (!localStream) return;
            const videoTrack = localStream.getVideoTracks()[0];
            if (videoTrack) {
                videoTrack.enabled = !videoTrack.enabled;
                btnCam.classList.toggle('toggled-off', !videoTrack.enabled);
                btnCam.querySelector('span').textContent = videoTrack.enabled ? 'videocam' : 'videocam_off';

                sendRoomMessage({
                    type: 'camera_toggle',
                    data: !videoTrack.enabled
                });
            }
        }



        function endCall() {
            stopStatsMonitoring();
            // Close peer connection
            if (pc) {
                pc.close();
                pc = null;
            }

            // Close WebSockets
            if (sfuWs) {
                sfuWs.close();
                sfuWs = null;
            }
            if (roomWs) {
                roomWs.close();
                roomWs = null;
            }

            // Stop local stream
            if (localStream) {
                localStream.getTracks().forEach(track => track.stop());
                localStream = null;
            }
            if (screenStream) {
                screenStream.getTracks().forEach(track => track.stop());
                screenStream = null;
            }

            // Clean up remote videos
            remoteVideos.forEach((videoData) => {
                videoData.card.remove();
            });
            remoteVideos.clear();
            processedStreams.clear();


            window.location.href = '/campfire';
        }


        // Handle page unload to clean up resources
        window.addEventListener('beforeunload', (event) => {
            console.log('Page unloading (beforeunload triggered)');
            pageUnloading = true;
            clearReconnectTimer();
            stopStatsMonitoring();
            if (pc) {
                pc.close();
            }
            if (sfuWs) {
                sfuWs.close();
            }
            if (roomWs) {
                roomWs.close();
            }
            if (localStream) {
                localStream.getTracks().forEach(track => track.stop());
            }
            if (screenStream) {
                screenStream.getTracks().forEach(track => track.stop());
            }
        });

        // Debug function - call from console to see current participant status
        window.debugVideoCall = function() {
            console.log('=== VIDEO CALL DEBUG INFO ===');
            console.log('Local stream tracks:', localStream ? localStream.getTracks().length : 'None');
            console.log('Remote video count:', remoteVideos.size);
            console.log('Stream to participant mappings:', Array.from(streamToParticipant.entries()));
            console.log('Remote video elements:');
            remoteVideos.forEach((videoData, participantId) => {
                console.log(`  ${participantId}:`, {
                    element: videoData.element.id,
                    trackCount: videoData.tracks.size,
                    streamId: videoData.stream.id,
                    tracks: Array.from(videoData.stream.getTracks()).map(t => ({ kind: t.kind, id: t.id, enabled: t.enabled }))
                });
            });
            console.log('Processed tracks:', Array.from(processedStreams).length, 'total');
            console.log('Peer connection state:', pc ? pc.connectionState : 'No PC');
            console.log('Peer connection senders:', pc ? pc.getSenders().map(s => ({ kind: s.track?.kind, id: s.track?.id })) : 'No PC');
        };

        // Initialize - just setup the dialog, don't start call yet
        function init() {
            console.log('Video call initialized - waiting for room selection');
            console.log('💡 Tip: Use window.debugVideoCall() in console to see current participant count');
        }

        if (callMode === 'audio') {
            btnCam.style.display = 'none';
            btnShare.style.display = 'none';
        }

        init();

        if (autoRoomName) {
            roomID = autoRoomName;
            joinRoomIdInput.value = autoRoomName;
            startVideoCall().catch((error) => {
                console.error('Auto-start call failed:', error);
                alert('Could not join the call automatically. ' + error.message);
            });
        }


    </script>
</body>
</html>
