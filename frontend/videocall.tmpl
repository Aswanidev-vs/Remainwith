        // Handle remote track - create video element
        function handleRemoteTrack(stream, track, trackKey) {
            const streamId = stream.id;
            
            console.log('=== HANDLING REMOTE TRACK ===');
            console.log('Track kind:', track.kind, '| Stream ID:', streamId.substring(0, 8) + '...');
            console.log('Current participants:', remoteVideos.size);
            
            // SMART GROUPING: Try to match audio and video from same peer
            let participantId = streamToParticipant.get(streamId);
            
            if (!participantId) {
                // New stream - check if it should pair with existing unmatched participant
                let unmatchedParticipant = null;
                
                for (let [pId, videoData] of remoteVideos) {
                    const hasAudio = videoData.audioTrack !== null;
                    const hasVideo = videoData.videoTrack !== null;
                    
                    if (track.kind === 'video' && hasAudio && !hasVideo) {
                        console.log('✓ Pairing video WITH existing audio!');
                        unmatchedParticipant = pId;
                        break;
                    } else if (track.kind === 'audio' && hasVideo && !hasAudio) {
                        console.log('✓ Pairing audio WITH existing video!');
                        unmatchedParticipant = pId;
                        break;
                    }
                }
                
                if (unmatchedParticipant) {
                    participantId = unmatchedParticipant;
                    streamToParticipant.set(streamId, participantId);
                } else {
                    participantId = 'participant-' + (++participantCounter);
                    streamToParticipant.set(streamId, participantId);
                    console.log('✓ Created NEW participant');
                }
            }
            
            // Hide the static remoteVideo element when we get actual remote tracks
            const staticRemoteVideo = document.getElementById('remoteVideo');
            if (staticRemoteVideo) {
                staticRemoteVideo.style.display = 'none';
            }
            
            // Use stable participant ID to group all tracks from same peer
            let videoData = remoteVideos.get(participantId);
            let videoEl;
            
            if (!videoData) {
                console.log('Creating new video element for participant:', participantId);
                
                // Create new video element for this participant
                videoEl = document.createElement('video');
                videoEl.id = 'video-' + participantId;
                videoEl.autoplay = true;
                videoEl.playsinline = true;
                videoEl.muted = false; // Ensure audio is not muted for remote videos

                const videoCard = document.createElement('div');
                videoCard.className = 'video-card';
                videoCard.dataset.participantId = participantId;

                const videoLabel = document.createElement('div');
                videoLabel.className = 'video-label';
                videoLabel.innerHTML = `<span class="video-badge">Participant ${remoteVideos.size + 1}</span><span class="video-badge">Live</span>`;

                videoCard.appendChild(videoEl);
                videoCard.appendChild(videoLabel);
                
                // Store in our map with metadata
                videoData = {
                    element: videoEl,
                    card: videoCard,
                    label: videoLabel,
                    stream: stream,
                    tracks: new Set([track.id]),
                    audioTrack: track.kind === 'audio' ? track : null,
                    videoTrack: track.kind === 'video' ? track : null,
                    participantId: participantId
                };
                remoteVideos.set(participantId, videoData);
                console.log('Stored video data, total participants:', remoteVideos.size);
                
                // Add to stage area; layout will move cards between stage and rail
                stageCanvas.appendChild(videoCard);
                console.log('Inserted video element into DOM');
                
                // Handle stream ending
                stream.onremovetrack = (e) => {
                    console.log('Track ended:', e.track.kind);
                    const videoData = remoteVideos.get(participantId);
                    if (videoData) {
                        videoData.tracks.delete(e.track.id);
                        if (e.track.kind === 'audio') videoData.audioTrack = null;
                        if (e.track.kind === 'video') videoData.videoTrack = null;
                        
                        if (videoData.tracks.size === 0) {
                            checkAndCleanupRemoteVideo(participantId);
                        }
                    }
                };
                
                // Update layout after adding element
                updateVideoLayout();
                console.log('Updated video layout');
            } else {
                // Add track to existing video element for this participant
                console.log('Adding', track.kind, 'track to existing element');
                videoData.tracks.add(track.id);
                
                // Update track references
                if (track.kind === 'audio') {
                    videoData.audioTrack = track;
                } else if (track.kind === 'video') {
                    videoData.videoTrack = track;
                }
                
                videoEl = videoData.element;
            }
            
            // Set the stream as the source - intelligently merge if needed
            if (videoEl) {
                const existingStream = videoEl.srcObject;
                if (existingStream && existingStream.id !== stream.id) {
                    // Different streams - merge tracks
                    console.log('Merging tracks from different streams');
                    try {
                        stream.getTracks().forEach(t => {
                            const exists = existingStream.getTracks().find(et => et.id === t.id);
                            if (!exists) {
                                existingStream.addTrack(t);
                            }
                        });
                    } catch (e) {
                        console.log('Merge failed:', e.message);
                        videoEl.srcObject = stream;
                    }
                } else {
                    videoEl.srcObject = stream;
                }
                
                // Ensure playback
                videoEl.play().catch(err => console.warn('Play failed:', err.message));
            }
            
            // Update UI
            statusOverlay.style.display = 'none';
            updateStatus('Connected - ' + remoteVideos.size + ' participant(s)');
            console.log('✓ Track complete. Participants:', remoteVideos.size);
        }

        // Update video layout based on number of participants
        function updateVideoLayout() {
            const participantEntries = Array.from(remoteVideos.entries());
            const [primaryParticipant] = participantEntries;

            remoteVideo.style.display = primaryParticipant ? 'none' : 'block';

            participantEntries.forEach(([, videoData], index) => {
                const targetParent = index === 0 ? stageCanvas : participantRail;
                if (videoData.card.parentElement !== targetParent) {
                    targetParent.appendChild(videoData.card);
                }

                videoData.card.classList.toggle('is-stage', index === 0);
                videoData.card.classList.toggle('is-rail', index !== 0);

                if (videoData.label) {
                    videoData.label.innerHTML = `<span class="video-badge">Participant ${index + 1}</span><span class="video-badge">${index === 0 ? 'On Stage' : 'Listening'}</span>`;
                }
            });

            if (!primaryParticipant) {
                statusOverlay.style.display = 'block';
            } else {
                statusOverlay.style.display = 'none';
            }
        }


        
        // Check if all tracks ended and cleanup
        function checkAndCleanupRemoteVideo(participantId) {
            const videoData = remoteVideos.get(participantId);
            if (!videoData) return;
            
            const videoEl = videoData.element;
            const stream = videoData.stream;
            
            // Check if all tracks in the stream have ended
            const allTracksEnded = stream.getTracks().every(t => t.readyState === 'ended');
            if (allTracksEnded) {
                console.log('Removing video element for participant:', participantId);
                videoData.card.remove();
                remoteVideos.delete(participantId);
                
                // Also clean up the stream mapping
                streamToParticipant.forEach((pId, streamId) => {
                    if (pId === participantId) {
                        streamToParticipant.delete(streamId);
                    }
                });
                
                // Update layout for remaining participants
                updateVideoLayout();
                
                // Show status if no more remote videos
                if (remoteVideos.size === 0) {
                    // Show the static remoteVideo again when no participants
                    const staticRemoteVideo = document.getElementById('remoteVideo');
                    if (staticRemoteVideo) {
                        staticRemoteVideo.style.display = 'block';
                    }
                    statusOverlay.style.display = 'block';
                    statusOverlay.querySelector('p').textContent = 'Waiting for others to join...';
                    updateStatus('Waiting for others...');
                } else {
                    updateStatus('Connected - ' + remoteVideos.size + ' participant(s)');
                }
            }
        }


        
        // Handle connection failure with retry
        async function handleConnectionFailure(reason = 'unknown') {
            if (reconnectInProgress || pageUnloading) {
                return;
            }

            reconnectInProgress = true;
            clearReconnectTimer();
            console.log('handleConnectionFailure triggered. Reason:', reason, 'Current PC state:', pc ? pc.connectionState : 'No PC');
            if (reconnectAttempts < MAX_RECONNECT_ATTEMPTS) {
                reconnectAttempts++;
                console.log(`Reconnect attempt ${reconnectAttempts}/${MAX_RECONNECT_ATTEMPTS}`);
                cleanupRemoteState();
                updateStatus('Reconnecting...');
                
                // Close existing connection
                if (pc) {
                    pc.close();
                }

                sfuWs = closeSocket(sfuWs);
                roomWs = closeSocket(roomWs);

                try {
                    await ensureLocalStreamActive();
                    createPeerConnection();
                    connectWebSockets();
                } catch (error) {
                    console.error('Reconnect failed:', error);
                    reconnectInProgress = false;
                    scheduleReconnect('retry-after-failed-reconnect', 2000);
                    return;
                }

                reconnectInProgress = false;
            } else {
                reconnectInProgress = false;
                updateStatus('Connection failed - please refresh');
                statusOverlay.innerHTML = `
                    <span class="material-symbols-outlined status-icon" style="color: #ef4444;">error</span>
                    <p>Connection failed. Please refresh the page.</p>
                `;
                statusOverlay.style.display = 'block';
            }
        }


