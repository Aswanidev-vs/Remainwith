<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <title>Video Call - Remainwith</title>

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&amp;family=Noto+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
  <!-- No external WebRTC library needed, using native WebRTC -->

  <style>
    /* ==================================================
       Remainwith Theme Variables (Consistent with Chat)
       ================================================== */
    :root {
      --font-display: "Newsreader", serif;
      --font-sans: "Noto Sans", sans-serif;
      --radius-sm: 0.375rem;
      --radius-md: 0.5rem;
      --radius-lg: 1rem;
      --radius-xl: 1.5rem;
      --radius-full: 9999px;
      
      --header-height: 70px;
      --control-bar-height: 80px;
      --rail-width: 248px;
    }

    /* Themes */
    html[data-theme="light"] { --bg-body: #f3f4f1; --text-main: #292524; }
    html[data-theme="dark"] { --bg-body: #191a18; --text-main: #e7e5e4; }
    html[data-theme="sepia"] { --bg-body: #f4ecd8; --text-main: #433422; }
    html[data-theme="forest"] { --bg-body: #1a211e; --text-main: #dcece1; }

    /* ==================================================
       Layout & Base
       ================================================== */
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #000; /* Video calls usually default to black background */
      color: #fff;
      font-family: var(--font-sans);
      height: 100dvh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    /* ==================================================
       Header (Overlay)
       ================================================== */
    .call-header {
        height: var(--header-height);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1.5rem;
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 20;
        background: linear-gradient(to bottom, rgba(0,0,0,0.6), transparent);
        pointer-events: none; /* Let clicks pass through to video */
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        pointer-events: auto;
        min-width: 0;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        pointer-events: auto;
    }

    .back-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        color: rgba(255,255,255,0.8);
        text-decoration: none;
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(4px);
        transition: all 0.2s;
    }
    .back-btn:hover { background: rgba(255,255,255,0.2); color: #fff; }

    .participant-info h2 {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 500;
        text-shadow: 0 1px 2px rgba(0,0,0,0.5);
    }
    .participant-info p {
        font-size: 0.8rem;
        opacity: 0.8;
        text-shadow: 0 1px 2px rgba(0,0,0,0.5);
    }

    .participant-info {
        min-width: 0;
        flex: 1;
    }

    .status-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.45rem;
        max-width: min(64rem, 80vw);
        min-width: 0;
    }

    .status-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.38rem;
        min-width: 0;
        max-width: 100%;
        padding: 0.28rem 0.58rem;
        border-radius: 999px;
        background: rgba(12, 14, 18, 0.44);
        border: 1px solid rgba(255,255,255,0.1);
        backdrop-filter: blur(12px);
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
    }

    .status-chip.is-hidden {
        display: none;
    }

    .status-chip-label {
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.62);
        white-space: nowrap;
    }

    .status-chip-value {
        font-size: 0.72rem;
        font-weight: 600;
        color: rgba(255,255,255,0.96);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 12rem;
    }

    /* ==================================================
       Video Stage
       ================================================== */
    .video-stage {
        flex: 1;
        position: relative;
        width: 100%;
        height: 100%;
        padding: 5.75rem 1.5rem calc(var(--control-bar-height) + 2rem);
        background:
            radial-gradient(circle at top, rgba(88, 101, 242, 0.18), transparent 30%),
            linear-gradient(180deg, #2b2d31 0%, #1e1f22 100%);
    }

    .stage-shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr) var(--rail-width);
        gap: 1rem;
        width: 100%;
        height: 100%;
    }

    .stage-main {
        position: relative;
        min-width: 0;
        min-height: 0;
        border-radius: 1.75rem;
        overflow: hidden;
        background: linear-gradient(180deg, rgba(49, 51, 56, 0.92), rgba(26, 27, 30, 0.98));
        border: 1px solid rgba(255,255,255,0.06);
        box-shadow: 0 30px 80px rgba(0,0,0,0.35);
    }

    .stage-canvas {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    .participant-rail {
        display: flex;
        flex-direction: column;
        gap: 0.875rem;
        padding: 0.35rem 0;
        min-height: 0;
        overflow-y: auto;
    }

    .participant-rail::-webkit-scrollbar {
        width: 8px;
    }

    .participant-rail::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.12);
        border-radius: 999px;
    }

    .video-card {
        position: relative;
        overflow: hidden;
        border-radius: 1.35rem;
        background: #111214;
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 18px 40px rgba(0,0,0,0.28);
    }

    .video-card video {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        background: #111;
    }

    .video-card::after {
        content: '';
        position: absolute;
        inset: auto 0 0;
        height: 40%;
        background: linear-gradient(180deg, transparent, rgba(0,0,0,0.72));
        pointer-events: none;
    }

    .video-card.is-stage {
        width: 100%;
        height: 100%;
        border-radius: 0;
        border: none;
        box-shadow: none;
    }

    .video-card.is-stage video {
        height: 100%;
    }

    .video-card.is-rail {
        aspect-ratio: 4 / 5;
        min-height: 158px;
        flex: 0 0 auto;
    }

    .video-card.is-local {
        aspect-ratio: 4 / 5;
        min-height: 172px;
        border-color: rgba(88, 101, 242, 0.35);
    }

    .video-label {
        position: absolute;
        left: 0.85rem;
        right: 0.85rem;
        bottom: 0.75rem;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        text-shadow: 0 1px 6px rgba(0,0,0,0.7);
    }

    .video-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.28rem 0.55rem;
        border-radius: 999px;
        background: rgba(0,0,0,0.48);
        backdrop-filter: blur(10px);
    }

    #remoteVideo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        background: #111;
    }

    /* Dynamic remote video elements for multiple participants */
    video[id^="video-"] {
        display: block;
    }

    #localVideo {
        transform: scaleX(-1); /* Mirror local video */
    }

    /* Status / Loading State */
    .status-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        z-index: 4;
        pointer-events: none;
        width: min(100%, 28rem);
        padding: 1.75rem;
        border-radius: 1.5rem;
        background: rgba(17, 18, 20, 0.58);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,0.08);
    }
    .status-icon {
        font-size: 48px;
        margin-bottom: 1rem;
        animation: pulse 2s infinite;
        opacity: 0.7;
    }
    @keyframes pulse { 0% { opacity: 0.4; } 50% { opacity: 0.8; } 100% { opacity: 0.4; } }

    /* ==================================================
       Controls Bar
       ================================================== */
    .controls-bar {
        height: var(--control-bar-height);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        padding-bottom: 1.5rem;
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 20;
        background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
    }

    .call-tools {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        position: relative;
    }

    .settings-shell {
        position: relative;
    }

    .tool-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        padding: 0;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.16);
        background: rgba(17,18,20,0.82);
        color: #fff;
        font-family: var(--font-sans);
        backdrop-filter: blur(16px);
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    }

    .tool-btn:hover,
    .tool-btn[aria-expanded="true"] {
        background: rgba(34, 37, 43, 0.92);
        border-color: rgba(255,255,255,0.24);
    }

    .tool-btn:focus-visible {
        outline: none;
        border-color: rgba(88, 101, 242, 0.7);
    }

    .tool-btn .material-symbols-outlined {
        font-size: 22px;
    }

    .settings-popover {
        position: absolute;
        top: calc(100% + 0.7rem);
        right: 0;
        width: min(26rem, calc(100vw - 2rem));
        max-height: min(32rem, calc(100dvh - 8rem));
        overflow-y: auto;
        padding: 0.9rem;
        border-radius: 1.15rem;
        background: rgba(22, 24, 29, 0.96);
        border: 1px solid rgba(255,255,255,0.1);
        box-shadow: 0 24px 60px rgba(0,0,0,0.38);
        backdrop-filter: blur(18px);
        pointer-events: auto;
        opacity: 0;
        transform: translateY(-6px);
        visibility: hidden;
        transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
    }

    .settings-popover.is-open {
        opacity: 1;
        transform: translateY(0);
        visibility: visible;
    }

    .settings-section + .settings-section {
        margin-top: 0.9rem;
        padding-top: 0.9rem;
        border-top: 1px solid rgba(255,255,255,0.08);
    }

    .settings-title {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: rgba(255,255,255,0.6);
        margin-bottom: 0.55rem;
    }

    .settings-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .settings-copy {
        min-width: 0;
    }

    .settings-copy strong {
        display: block;
        font-size: 0.92rem;
        font-weight: 600;
        color: #fff;
    }

    .settings-copy span {
        display: block;
        margin-top: 0.18rem;
        font-size: 0.78rem;
        color: rgba(255,255,255,0.65);
    }

    .toggle-switch {
        position: relative;
        width: 46px;
        height: 28px;
        border: none;
        border-radius: 999px;
        background: rgba(255,255,255,0.18);
        cursor: pointer;
        transition: background 0.2s ease;
    }

    .toggle-switch::after {
        content: '';
        position: absolute;
        top: 3px;
        left: 3px;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: #fff;
        transition: transform 0.2s ease;
    }

    .toggle-switch[aria-pressed="true"] {
        background: #5865f2;
    }

    .toggle-switch[aria-pressed="true"]::after {
        transform: translateX(18px);
    }

    .settings-toggle-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.5rem;
    }

    .settings-toggle-item {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 38px;
        padding: 0.55rem 0.7rem;
        border-radius: 0.85rem;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.78);
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .settings-toggle-item:hover {
        background: rgba(255,255,255,0.08);
    }

    .settings-toggle-item.is-active {
        color: #fff;
        background: rgba(88, 101, 242, 0.22);
        border-color: rgba(119, 132, 255, 0.55);
    }

    .quality-pill-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
    }

    .quality-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 4.4rem;
        min-height: 38px;
        padding: 0.55rem 0.78rem;
        border-radius: 0.9rem;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.82);
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .quality-pill:hover {
        background: rgba(255,255,255,0.08);
    }

    .quality-pill.is-active {
        background: linear-gradient(180deg, rgba(88, 101, 242, 0.38), rgba(88, 101, 242, 0.22));
        border-color: rgba(136, 146, 255, 0.7);
        color: #fff;
    }

    .control-btn.pin-active {
        background: #10b981;
        color: white;
    }

    .control-btn.sharing {
        background: #5865f2;
        color: white;
    }

    .control-btn {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        border: none;
        background: rgba(255,255,255,0.15);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        backdrop-filter: blur(10px);
        transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    
    .control-btn .material-symbols-outlined { font-size: 24px; }

    .control-btn:hover {
        background: rgba(255,255,255,0.25);
        transform: scale(1.05);
    }
    
    .control-btn.toggled-off {
        background: #fff;
        color: #000;
    }
    
    .control-btn.danger {
        background: #ef4444;
        color: white;
    }
    .control-btn.danger:hover {
        background: #dc2626;
        transform: scale(1.1);
    }

    .popup-card {
        position: fixed;
        left: 50%;
        bottom: calc(var(--control-bar-height) + env(safe-area-inset-bottom) + 1.25rem);
        z-index: 40;
        width: min(28rem, calc(100vw - 2rem));
        padding: 0.9rem 1rem;
        border-radius: 1rem;
        background: rgba(18, 21, 29, 0.96);
        border: 1px solid rgba(255,255,255,0.1);
        box-shadow: 0 20px 50px rgba(0,0,0,0.35);
        backdrop-filter: blur(18px);
        transform: translate(-50%, 14px);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
    }

    .popup-card.is-visible {
        opacity: 1;
        visibility: visible;
        transform: translate(-50%, 0);
    }

    .popup-card-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .popup-card-copy {
        min-width: 0;
    }

    .popup-card-title {
        display: block;
        font-size: 0.95rem;
        font-weight: 700;
        color: #fff;
    }

    .popup-card-message {
        display: block;
        margin-top: 0.28rem;
        font-size: 0.82rem;
        line-height: 1.45;
        color: rgba(255,255,255,0.72);
    }

    .popup-card-close {
        flex: 0 0 auto;
        width: 34px;
        height: 34px;
        border: none;
        border-radius: 50%;
        background: rgba(255,255,255,0.08);
        color: #fff;
        cursor: pointer;
    }

    .popup-card-close:hover {
        background: rgba(255,255,255,0.14);
    }

    /* ==================================================
       Room Selection Dialog
       ================================================== */
    .room-dialog {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 100;
        backdrop-filter: blur(8px);
    }

    .room-dialog-content {
        background: var(--bg-body, #f3f4f1);
        color: var(--text-main, #292524);
        padding: 2.5rem;
        border-radius: var(--radius-xl);
        max-width: 420px;
        width: 90%;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    }

    .room-dialog-content h2 {
        font-family: var(--font-display);
        font-size: 1.75rem;
        margin-bottom: 0.5rem;
        font-weight: 600;
    }

    .room-dialog-subtitle {
        color: #666;
        margin-bottom: 2rem;
        font-size: 0.95rem;
    }

    .room-section {
        margin-bottom: 1.5rem;
    }

    .room-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        padding: 1rem 1.5rem;
        border: none;
        border-radius: var(--radius-lg);
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }

    .room-btn .material-symbols-outlined {
        font-size: 20px;
    }

    .create-btn {
        background: #10b981;
        color: white;
    }
    .create-btn:hover {
        background: #059669;
        transform: translateY(-1px);
    }

    .join-btn {
        background: #3b82f6;
        color: white;
    }
    .join-btn:hover {
        background: #2563eb;
        transform: translateY(-1px);
    }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 1.5rem 0;
        color: #888;
        font-size: 0.875rem;
    }
    .divider::before,
    .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid #ddd;
    }
    .divider::before { margin-right: 1rem; }
    .divider::after { margin-left: 1rem; }

    .room-input {
        width: 100%;
        padding: 0.875rem 1rem;
        border: 2px solid #e5e5e5;
        border-radius: var(--radius-md);
        font-size: 1.25rem;
        text-align: center;
        letter-spacing: 0.25em;
        margin-bottom: 1rem;
        transition: border-color 0.2s;
    }
    .room-input:focus {
        outline: none;
        border-color: #3b82f6;
    }

    .room-id-display {
        margin-top: 1.5rem;
        padding: 1.5rem;
        background: #f0fdf4;
        border: 2px dashed #10b981;
        border-radius: var(--radius-lg);
    }

    .room-id-box {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        margin: 1rem 0;
    }

    .room-id-text {
        font-family: 'Courier New', monospace;
        font-size: 2rem;
        font-weight: 700;
        color: #059669;
        letter-spacing: 0.15em;
    }

    .copy-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border: none;
        background: #10b981;
        color: white;
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: all 0.2s;
    }
    .copy-btn:hover {
        background: #059669;
    }

    .room-hint {
        font-size: 0.875rem;
        color: #666;
        margin-bottom: 1rem;
    }

    .enter-room-btn {
        width: 100%;
        padding: 0.875rem;
        border: none;
        background: #059669;
        color: white;
        border-radius: var(--radius-md);
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }
    .enter-room-btn:hover {
        background: #047857;
    }

    .join-section {
        display: flex;
        flex-direction: column;
    }

    @media (max-width: 600px) {
        .control-btn { width: 48px; height: 48px; }
        .room-dialog-content { padding: 1.5rem; }
        .room-id-text { font-size: 1.5rem; }
    }

    @media (max-width: 980px) {
        .video-stage {
            padding: 5.35rem 1rem calc(var(--control-bar-height) + 1.75rem);
        }

        .stage-shell {
            grid-template-columns: 1fr;
            grid-template-rows: minmax(0, 1fr) auto;
            gap: 0.85rem;
        }

        .participant-rail {
            flex-direction: row;
            overflow-x: auto;
            overflow-y: hidden;
            padding-bottom: 0.25rem;
        }

        .video-card.is-rail,
        .video-card.is-local {
            width: 168px;
            min-width: 168px;
            min-height: 126px;
            aspect-ratio: 16 / 10;
        }

        .header-right {
            gap: 0.65rem;
        }

        .status-meta {
            max-width: min(52rem, 72vw);
        }

    }

    @media (max-width: 768px) {
        :root {
            --header-height: 64px;
            --control-bar-height: 74px;
        }

        .call-header {
            position: relative;
            top: auto;
            left: auto;
            right: auto;
            height: auto;
            min-height: 0;
            align-items: flex-start;
            gap: 0.7rem;
            padding: calc(0.75rem + env(safe-area-inset-top)) 0.9rem 0.8rem;
            flex-direction: row;
            flex-wrap: wrap;
            background: linear-gradient(180deg, rgba(8, 10, 16, 0.98), rgba(14, 18, 28, 0.9));
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .participant-info h2 {
            font-size: 1rem;
        }

        .participant-info p {
            font-size: 0.75rem;
        }

        .stage-main {
            border-radius: 1.15rem;
        }

        .status-overlay {
            width: calc(100% - 2rem);
            padding: 1.25rem;
        }

        .controls-bar {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            gap: 0.9rem;
            padding-bottom: max(0.9rem, env(safe-area-inset-bottom));
        }

        .header-left,
        .header-right {
            width: 100%;
        }

        .header-left {
            align-items: flex-start;
            gap: 0.8rem;
        }

        .header-right {
            flex-direction: row;
            justify-content: flex-end;
            align-items: flex-start;
        }

        .participant-info {
            width: 100%;
        }

        .status-meta {
            display: flex;
            flex-wrap: nowrap;
            gap: 0.45rem;
            margin-top: 0.55rem;
            max-width: 100%;
            overflow-x: auto;
            overflow-y: hidden;
            padding-bottom: 0.15rem;
            scroll-snap-type: x proximity;
            -webkit-overflow-scrolling: touch;
        }

        .status-meta::-webkit-scrollbar {
            display: none;
        }

        .status-chip {
            flex: 0 0 auto;
            width: auto;
            min-width: max-content;
            scroll-snap-align: start;
        }

        .call-tools {
            width: auto;
        }

        .tool-btn {
            width: 44px;
            height: 44px;
            align-self: flex-start;
        }

        .settings-popover {
            position: fixed;
            left: 0.75rem;
            right: 0.75rem;
            top: auto;
            bottom: calc(var(--control-bar-height) + env(safe-area-inset-bottom) + 0.9rem);
            width: auto;
            max-height: min(30rem, 62dvh);
            transform: translateY(12px);
            border-radius: 1.25rem;
        }

        .popup-card {
            width: calc(100vw - 1.5rem);
            bottom: calc(var(--control-bar-height) + env(safe-area-inset-bottom) + 1rem);
        }

        .settings-row {
            flex-direction: column;
            align-items: stretch;
            gap: 0.7rem;
        }
    }

    @media (max-width: 560px) {
        .video-stage {
            padding: 0.75rem 0.75rem calc(var(--control-bar-height) + env(safe-area-inset-bottom) + 1.4rem);
        }

        .stage-shell {
            gap: 0.7rem;
        }

        .participant-rail {
            gap: 0.65rem;
        }

        .video-card.is-rail,
        .video-card.is-local {
            width: 134px;
            min-width: 134px;
            min-height: 100px;
        }

        .video-label {
            left: 0.55rem;
            right: 0.55rem;
            bottom: 0.5rem;
            font-size: 0.72rem;
        }

        .video-badge {
            padding: 0.22rem 0.45rem;
        }

        .control-btn {
            width: 46px;
            height: 46px;
        }

        .call-tools {
            width: auto;
        }

        .status-meta {
            display: flex;
            grid-template-columns: none;
            gap: 0.38rem;
            width: 100%;
            max-width: 100%;
        }

        .status-chip {
            width: auto;
            min-width: max-content;
            padding: 0.4rem 0.56rem;
            border-radius: 0.9rem;
        }

        .status-chip-label,
        .status-chip-value {
            max-width: 100%;
        }

        .status-chip-label {
            font-size: 0.56rem;
        }

        .status-chip-value {
            font-size: 0.68rem;
            max-width: 7.2rem;
        }

        .popup-card {
            padding: 0.82rem 0.9rem;
            border-radius: 0.95rem;
        }

        .popup-card-title {
            font-size: 0.88rem;
        }

        .popup-card-message {
            font-size: 0.78rem;
        }

        .quality-pill-group {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .quality-pill {
            width: 100%;
            min-width: 0;
        }

        .settings-toggle-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 400px) {
        .call-header {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }

        .header-left {
            gap: 0.7rem;
        }

        .back-btn {
            width: 36px;
            height: 36px;
            flex: 0 0 36px;
        }

        .participant-info h2 {
            font-size: 0.94rem;
        }

        .participant-info p {
            font-size: 0.72rem;
        }

        .quality-pill-group {
            grid-template-columns: 1fr;
        }

        .status-meta {
            gap: 0.34rem;
        }

        .settings-popover {
            left: 0.5rem;
            right: 0.5rem;
            bottom: calc(var(--control-bar-height) + env(safe-area-inset-bottom) + 0.65rem);
            max-height: 58dvh;
        }

        .popup-card {
            width: calc(100vw - 1rem);
            bottom: calc(var(--control-bar-height) + env(safe-area-inset-bottom) + 0.75rem);
        }
    }

    @media (min-width: 1400px) {
        :root {
            --rail-width: 280px;
        }

        .video-stage {
            padding-left: 2rem;
            padding-right: 2rem;
        }
    }
  </style>

</head>
<body>

    <!-- Header Overlay -->
    <header class="call-header">
        <div class="header-left">
            <a href="/campfire" class="back-btn" aria-label="End call and go back">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div class="participant-info">
                <h2 id="remoteName">Campfire Call</h2>
                <p id="callStatus">Connecting...</p>
                <div class="status-meta" id="statusMeta" aria-live="polite">
                    <div class="status-chip" data-stat-key="send">
                        <span class="status-chip-label">Send</span>
                        <span class="status-chip-value" id="statSendBitrate">0 kbps</span>
                    </div>
                    <div class="status-chip" data-stat-key="receive">
                        <span class="status-chip-label">Receive</span>
                        <span class="status-chip-value" id="statRecvBitrate">0 kbps</span>
                    </div>
                    <div class="status-chip" data-stat-key="uplink">
                        <span class="status-chip-label">Uplink</span>
                        <span class="status-chip-value" id="statUplink">Unknown</span>
                    </div>
                    <div class="status-chip" data-stat-key="rtt">
                        <span class="status-chip-label">RTT</span>
                        <span class="status-chip-value" id="statRtt">-</span>
                    </div>
                    <div class="status-chip" data-stat-key="resolution">
                        <span class="status-chip-label">Resolution</span>
                        <span class="status-chip-value" id="statResolution">-</span>
                    </div>
                    <div class="status-chip" data-stat-key="source">
                        <span class="status-chip-label">Source</span>
                        <span class="status-chip-value" id="statSource">Camera</span>
                    </div>
                    <div class="status-chip" data-stat-key="network">
                        <span class="status-chip-label">Network</span>
                        <span class="status-chip-value" id="statNetwork">Unknown</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="header-right">
            <div class="call-tools">
                <div class="settings-shell">
                    <button class="tool-btn" id="settingsButton" type="button" title="Call settings" aria-label="Call settings" aria-expanded="false" aria-controls="settingsPopover">
                        <span class="material-symbols-outlined">settings</span>
                    </button>
                    <div class="settings-popover" id="settingsPopover">
                        <div class="settings-section">
                            <div class="settings-row">
                                <div class="settings-copy">
                                    <strong>Live stats in header</strong>
                                    <span>Show connection and media metrics under the call status.</span>
                                </div>
                                <button class="toggle-switch" id="liveStatsToggle" type="button" aria-pressed="true"></button>
                            </div>
                        </div>
                        <div class="settings-section">
                            <div class="settings-title">Visible Metrics</div>
                            <div class="settings-toggle-grid" id="statsToggleGrid">
                                <button class="settings-toggle-item" type="button" data-stat-toggle="send">Send bitrate</button>
                                <button class="settings-toggle-item" type="button" data-stat-toggle="receive">Receive bitrate</button>
                                <button class="settings-toggle-item" type="button" data-stat-toggle="uplink">Estimated uplink</button>
                                <button class="settings-toggle-item" type="button" data-stat-toggle="rtt">RTT</button>
                                <button class="settings-toggle-item" type="button" data-stat-toggle="resolution">Actual resolution</button>
                                <button class="settings-toggle-item" type="button" data-stat-toggle="source">Source</button>
                                <button class="settings-toggle-item" type="button" data-stat-toggle="network">Network</button>
                            </div>
                        </div>
                        <div class="settings-section">
                            <div class="settings-title">Send Quality</div>
                            <div class="quality-pill-group" id="qualityPresetGroup">
                                <button class="quality-pill" type="button" data-quality="auto">Auto</button>
                                <button class="quality-pill" type="button" data-quality="360p">360p</button>
                                <button class="quality-pill" type="button" data-quality="480p">480p</button>
                                <button class="quality-pill" type="button" data-quality="720p">720p</button>
                                <button class="quality-pill" type="button" data-quality="1080p">1080p</button>
                            </div>
                        </div>
                        <div class="settings-section">
                            <div class="settings-title">View Quality</div>
                            <div class="quality-pill-group" id="receiveQualityPresetGroup">
                                <button class="quality-pill" type="button" data-receive-quality="auto">Auto</button>
                                <button class="quality-pill" type="button" data-receive-quality="360p">360p</button>
                                <button class="quality-pill" type="button" data-receive-quality="480p">480p</button>
                                <button class="quality-pill" type="button" data-receive-quality="720p">720p</button>
                                <button class="quality-pill" type="button" data-receive-quality="1080p">1080p</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Room Selection Dialog -->
    <div class="room-dialog" id="roomDialog">
        <div class="room-dialog-content">
            <h2>Video Call</h2>
            <p class="room-dialog-subtitle">Create a new room or join an existing one</p>
            
            <div class="room-section">
                <button class="room-btn create-btn" onclick="createRoom()">
                    <span class="material-symbols-outlined">add_circle</span>
                    Create Room
                </button>
                <div class="room-id-display" id="createdRoomId" style="display: none;">
                    <p>Your Room ID:</p>
                    <div class="room-id-box">
                        <span id="roomIdText" class="room-id-text"></span>
                        <button class="copy-btn" onclick="copyRoomId()" title="Copy to clipboard">
                            <span class="material-symbols-outlined">content_copy</span>
                        </button>
                    </div>
                    <p class="room-hint">Share this ID with others to join</p>
                    <button class="enter-room-btn" onclick="enterCreatedRoom()">
                        Enter Room
                    </button>
                </div>
            </div>
            
            <div class="divider">or</div>
            
            <div class="room-section">
                <div class="join-section">
                    <input type="text" id="joinRoomId" class="room-input" placeholder="Enter 6-digit Room ID" maxlength="6">
                    <button class="room-btn join-btn" onclick="joinRoom()">
                        <span class="material-symbols-outlined">login</span>
                        Join Room
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Video Stage -->
    <div class="video-stage" id="videoStage" style="display: none;">
        <div class="stage-shell">
            <div class="stage-main">
                <div class="stage-canvas" id="stageCanvas">
                    <div class="status-overlay" id="statusOverlay">
                        <span class="material-symbols-outlined status-icon">sensors</span>
                        <p>Waiting for others to join...</p>
                    </div>
                    <video id="remoteVideo" autoplay playsinline></video>
                </div>
            </div>
            <aside class="participant-rail" id="participantRail">
                <div class="video-card is-local" id="localVideoCard">
                    <video id="localVideo" autoplay playsinline muted></video>
                    <div class="video-label">
                        <span class="video-badge">You</span>
                        <span class="video-badge">Self View</span>
                    </div>
                </div>
            </aside>
        </div>
    </div>


    <!-- Controls -->
    <div class="controls-bar">
        <button class="control-btn" id="btnMic" onclick="toggleMic()">
            <span class="material-symbols-outlined">mic</span>
        </button>
        
        <button class="control-btn danger" id="btnEnd" onclick="endCall()">
            <span class="material-symbols-outlined">call_end</span>
        </button>
        
        <button class="control-btn" id="btnCam" onclick="toggleCam()">
            <span class="material-symbols-outlined">videocam</span>
        </button>

        <button class="control-btn" id="btnShare" onclick="toggleScreenShare()" title="Share screen">
            <span class="material-symbols-outlined">screen_share</span>
        </button>
    </div>

    <div class="popup-card" id="popupCard" role="status" aria-live="polite" aria-hidden="true">
        <div class="popup-card-head">
            <div class="popup-card-copy">
                <strong class="popup-card-title" id="popupCardTitle">Notice</strong>
                <span class="popup-card-message" id="popupCardMessage"></span>
            </div>
            <button class="popup-card-close" id="popupCardClose" type="button" aria-label="Close popup">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
    </div>

    <script>
        // --- Theme Logic (Read-only for consistency) ---
        const storageKey = 'remainwith-theme';
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }
        const savedTheme = getCookie(storageKey);
        if (savedTheme) document.documentElement.setAttribute('data-theme', savedTheme);

        // --- Native WebRTC Video Call Logic ---
        const localVideo = document.getElementById('localVideo');
        const remoteVideo = document.getElementById('remoteVideo');
        const statusOverlay = document.getElementById('statusOverlay');
        const callStatus = document.getElementById('callStatus');
        const statusMeta = document.getElementById('statusMeta');
        const btnMic = document.getElementById('btnMic');
        const btnCam = document.getElementById('btnCam');
        const btnShare = document.getElementById('btnShare');
        const popupCard = document.getElementById('popupCard');
        const popupCardTitle = document.getElementById('popupCardTitle');
        const popupCardMessage = document.getElementById('popupCardMessage');
        const popupCardClose = document.getElementById('popupCardClose');
        const settingsButton = document.getElementById('settingsButton');
        const settingsPopover = document.getElementById('settingsPopover');
        const liveStatsToggle = document.getElementById('liveStatsToggle');
        const statsToggleGrid = document.getElementById('statsToggleGrid');
        const qualityPresetGroup = document.getElementById('qualityPresetGroup');
        const receiveQualityPresetGroup = document.getElementById('receiveQualityPresetGroup');
        const roomDialog = document.getElementById('roomDialog');
        const videoStage = document.getElementById('videoStage');
        const stageCanvas = document.getElementById('stageCanvas');
        const participantRail = document.getElementById('participantRail');
        const createdRoomIdDiv = document.getElementById('createdRoomId');
        const roomIdText = document.getElementById('roomIdText');
        const joinRoomIdInput = document.getElementById('joinRoomId');
        const pageParams = new URLSearchParams(window.location.search);
        const autoRoomName = pageParams.get('room_name');
        const autoRoomLabel = pageParams.get('room_label');
        const initialCallMode = pageParams.get('mode') === 'audio' ? 'audio' : 'video';

        let localStream = null;
        let pc = null; // Peer connection to SFU
        let sfuWs = null; // WebSocket for SFU (WebRTC signaling)
        let roomWs = null; // WebSocket for room management
        let roomID = null;
        let generatedRoomId = null;
        let isConnecting = false;
        let reconnectAttempts = 0;
        const MAX_RECONNECT_ATTEMPTS = 3;
        let reconnectTimer = null;
        let reconnectInProgress = false;
        let pageUnloading = false;
        let popupTimer = null;
        let screenStream = null;
        let cameraVideoTrack = null;
        let videoSender = null;
        let callMode = initialCallMode;
        let selectedQuality = 'auto';
        let selectedReceiveQuality = 'auto';
        let statsInterval = null;
        let statsSnapshot = null;
        let autoQualityLevel = '720p';
        let lastAppliedVideoTrack = null;
        const statsPreferenceStorageKey = 'remainwith-call-stats-preferences';

        const qualityProfiles = {
            auto: { label: 'Auto', width: 1280, height: 720, frameRate: 24, maxBitrate: 1500000 },
            '360p': { label: '360p', width: 640, height: 360, frameRate: 24, maxBitrate: 600000 },
            '480p': { label: '480p', width: 854, height: 480, frameRate: 24, maxBitrate: 900000 },
            '720p': { label: '720p', width: 1280, height: 720, frameRate: 30, maxBitrate: 1800000 },
            '1080p': { label: '1080p', width: 1920, height: 1080, frameRate: 30, maxBitrate: 3500000 }
        };
        const defaultStatsPreferences = {
            liveStats: true,
            visibleStats: {
                send: true,
                receive: true,
                uplink: true,
                rtt: true,
                resolution: true,
                source: true,
                network: true
            }
        };
        let statsPreferences = loadStatsPreferences();
        
        // Port forwarding detection
        const isPortForwarded = window.location.protocol === 'http:' || 
                              window.location.hostname === 'localhost' || 
                              window.location.hostname === '127.0.0.1' ||
                              window.location.hostname.includes('.app.github.dev'); // VS Code tunnels
        
        // Map to track remote video elements by participant (using stable participant ID)
        const remoteVideos = new Map(); // participantID -> {element, stream, tracks, audioTrack, videoTrack}
        // Track which streams we've already processed to avoid duplicates
        const processedStreams = new Set();
        // Map of stream IDs to participant IDs for grouping tracks
        const streamToParticipant = new Map();
        // Counter for participant IDs to ensure consistency
        let participantCounter = 0;

        
        // Connection state tracking
        let connectionState = 'new'; // new, connecting, connected, disconnected, failed

        function loadStatsPreferences() {
            try {
                const raw = localStorage.getItem(statsPreferenceStorageKey);
                if (!raw) {
                    return JSON.parse(JSON.stringify(defaultStatsPreferences));
                }

                const parsed = JSON.parse(raw);
                return {
                    liveStats: parsed.liveStats ?? defaultStatsPreferences.liveStats,
                    visibleStats: {
                        ...defaultStatsPreferences.visibleStats,
                        ...(parsed.visibleStats || {})
                    }
                };
            } catch (error) {
                console.warn('Failed to load stats preferences:', error);
                return JSON.parse(JSON.stringify(defaultStatsPreferences));
            }
        }

        function saveStatsPreferences() {
            try {
                localStorage.setItem(statsPreferenceStorageKey, JSON.stringify(statsPreferences));
            } catch (error) {
                console.warn('Failed to save stats preferences:', error);
            }
        }

        function hidePopupCard() {
            if (!popupCard) return;
            popupCard.classList.remove('is-visible');
            popupCard.setAttribute('aria-hidden', 'true');
            if (popupTimer) {
                clearTimeout(popupTimer);
                popupTimer = null;
            }
        }

        function showPopupCard(title, message, duration = 4200) {
            if (!popupCard || !popupCardTitle || !popupCardMessage) return;

            popupCardTitle.textContent = title;
            popupCardMessage.textContent = message;
            popupCard.classList.add('is-visible');
            popupCard.setAttribute('aria-hidden', 'false');

            if (popupTimer) {
                clearTimeout(popupTimer);
            }

            if (duration > 0) {
                popupTimer = setTimeout(() => {
                    hidePopupCard();
                }, duration);
            }
        }

        function updateSettingsSummary() {
            return;
        }

        function syncQualityControlState() {
            if (qualityPresetGroup) {
                qualityPresetGroup.querySelectorAll('[data-quality]').forEach((button) => {
                    button.classList.toggle('is-active', button.dataset.quality === selectedQuality);
                });
            }

            if (receiveQualityPresetGroup) {
                receiveQualityPresetGroup.querySelectorAll('[data-receive-quality]').forEach((button) => {
                    button.classList.toggle('is-active', button.dataset.receiveQuality === selectedReceiveQuality);
                });
            }
        }

        function applyStatsPreferenceUI() {
            let visibleCount = 0;
            if (statusMeta) {
                statusMeta.querySelectorAll('[data-stat-key]').forEach((chip) => {
                    const key = chip.dataset.statKey;
                    const isVisible = !!statsPreferences.visibleStats[key];
                    chip.classList.toggle('is-hidden', !isVisible);
                    if (isVisible) {
                        visibleCount += 1;
                    }
                });
                statusMeta.style.display = statsPreferences.liveStats && visibleCount > 0 ? 'flex' : 'none';
            }

            if (liveStatsToggle) {
                liveStatsToggle.setAttribute('aria-pressed', String(!!statsPreferences.liveStats));
            }

            if (statsToggleGrid) {
                statsToggleGrid.querySelectorAll('[data-stat-toggle]').forEach((button) => {
                    const key = button.dataset.statToggle;
                    button.classList.toggle('is-active', !!statsPreferences.visibleStats[key]);
                    button.disabled = !statsPreferences.liveStats;
                    button.style.opacity = statsPreferences.liveStats ? '1' : '0.45';
                });
            }
        }

        function setSettingsPopoverOpen(isOpen) {
            if (!settingsPopover || !settingsButton) return;
            settingsPopover.classList.toggle('is-open', isOpen);
            settingsButton.setAttribute('aria-expanded', String(isOpen));
        }

        function cleanupRemoteState() {
            remoteVideos.forEach((videoData) => {
                videoData.card.remove();
            });
            remoteVideos.clear();
            processedStreams.clear();
            streamToParticipant.clear();
            participantCounter = 0;
            remoteVideo.style.display = 'block';
            statusOverlay.style.display = 'block';
            const statusText = statusOverlay.querySelector('p');
            if (statusText) {
                statusText.textContent = 'Reconnecting...';
            }
        }

        function closeSocket(socket) {
            if (!socket) return null;
            try {
                socket.onopen = null;
                socket.onmessage = null;
                socket.onerror = null;
                socket.onclose = null;
                if (socket.readyState === WebSocket.OPEN || socket.readyState === WebSocket.CONNECTING) {
                    socket.close();
                }
            } catch (error) {
                console.warn('Socket close failed:', error);
            }
            return null;
        }

        function clearReconnectTimer() {
            if (reconnectTimer) {
                clearTimeout(reconnectTimer);
                reconnectTimer = null;
            }
        }

        async function ensureLocalStreamActive() {
            const needsRestart = !localStream || localStream.getTracks().some(track => track.readyState === 'ended');
            if (needsRestart) {
                if (localStream) {
                    localStream.getTracks().forEach(track => track.stop());
                }
                localStream = null;
                await startLocalStream();
                return;
            }

            if (!localVideo.srcObject && localStream) {
                localVideo.srcObject = localStream;
            }
        }

        function scheduleReconnect(reason, delay = 1500) {
            if (pageUnloading || reconnectInProgress) {
                return;
            }

            if (reconnectAttempts >= MAX_RECONNECT_ATTEMPTS) {
                updateStatus('Connection failed - please refresh');
                statusOverlay.innerHTML = `
                    <span class="material-symbols-outlined status-icon" style="color: #ef4444;">error</span>
                    <p>Connection failed. Please refresh the page.</p>
                `;
                statusOverlay.style.display = 'block';
                return;
            }

            clearReconnectTimer();
            reconnectTimer = setTimeout(() => {
                reconnectTimer = null;
                handleConnectionFailure(reason);
            }, delay);
        }

        function getCurrentQualityProfile() {
            if (selectedQuality !== 'auto') {
                return qualityProfiles[selectedQuality];
            }

            if (isScreenSharing()) {
                return { ...qualityProfiles[autoQualityLevel], frameRate: 12 };
            }

            return qualityProfiles[autoQualityLevel];
        }

        function isScreenSharing() {
            return !!(screenStream && screenStream.getVideoTracks().length > 0);
        }

        function getActiveVideoTrack() {
            if (isScreenSharing()) {
                return screenStream.getVideoTracks()[0] || null;
            }
            return cameraVideoTrack;
        }

        function getVideoSender() {
            if (videoSender && videoSender.track) {
                return videoSender;
            }
            if (!pc) return null;
            videoSender = pc.getSenders().find(sender => sender.track && sender.track.kind === 'video') || null;
