                const createResponse = await fetch('/api/video/create-room', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ room_name: roomID })
                });

                let roomIdFromCreate = null;
                if (createResponse.ok) {
                    const createData = await createResponse.json();
                    roomIdFromCreate = createData.room_id;
                    console.log('Room created or exists:', roomIdFromCreate);
                }

                // Join room
                const joinResponse = await fetch('/api/video/join-room', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        room_name: roomID,
                        participant_name: userName,
                        participant_identity: userID.toString()
                    })
                });

                if (!joinResponse.ok) {
                    throw new Error('Failed to join room');
                }

                const joinData = await joinResponse.json();
                roomID = joinData.room_id || roomIdFromCreate;
                
                console.log('Joined room:', roomID);

