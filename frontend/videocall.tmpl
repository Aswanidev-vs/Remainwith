<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <title>Video Call · Remainwith</title>

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&amp;family=Noto+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
  <!-- No external WebRTC library needed, using native WebRTC -->

  <style>
    /* ==================================================
       Remainwith Theme Variables (Consistent with Chat)
       ================================================== */
    :root {
      --font-display: "Newsreader", serif;
      --font-sans: "Noto Sans", sans-serif;
      --radius-sm: 0.375rem;
      --radius-md: 0.5rem;
      --radius-lg: 1rem;
      --radius-xl: 1.5rem;
      --radius-full: 9999px;
      
      --header-height: 70px;
      --control-bar-height: 80px;
    }

    /* Themes */
    html[data-theme="light"] { --bg-body: #f3f4f1; --text-main: #292524; }
    html[data-theme="dark"] { --bg-body: #191a18; --text-main: #e7e5e4; }
    html[data-theme="sepia"] { --bg-body: #f4ecd8; --text-main: #433422; }
    html[data-theme="forest"] { --bg-body: #1a211e; --text-main: #dcece1; }

    /* ==================================================
       Layout & Base
       ================================================== */
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #000; /* Video calls usually default to black background */
      color: #fff;
      font-family: var(--font-sans);
      height: 100dvh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    /* ==================================================
       Header (Overlay)
       ================================================== */
    .call-header {
        height: var(--header-height);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1.5rem;
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 20;
        background: linear-gradient(to bottom, rgba(0,0,0,0.6), transparent);
        pointer-events: none; /* Let clicks pass through to video */
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        pointer-events: auto;
    }

    .back-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        color: rgba(255,255,255,0.8);
        text-decoration: none;
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(4px);
        transition: all 0.2s;
    }
    .back-btn:hover { background: rgba(255,255,255,0.2); color: #fff; }

    .participant-info h2 {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 500;
        text-shadow: 0 1px 2px rgba(0,0,0,0.5);
    }
    .participant-info p {
        font-size: 0.8rem;
        opacity: 0.8;
        text-shadow: 0 1px 2px rgba(0,0,0,0.5);
    }

    /* ==================================================
       Video Stage
       ================================================== */
    .video-stage {
        flex: 1;
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    #remoteVideo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        background: #111;
    }

    /* Dynamic remote video elements for multiple participants */
    video[id^="video-"] {
        object-fit: cover;
        background: #111;
        position: absolute;
        z-index: 5;
        top: 0;
        left: 0;
        display: block;
    }

    #localVideo {
        position: absolute;
        bottom: 100px; /* Space for controls */
        right: 1.5rem;
        width: 120px;
        height: 160px;
        object-fit: cover;
        border-radius: var(--radius-lg);
        border: 2px solid rgba(255,255,255,0.1);
        background: #222;
        box-shadow: 0 8px 24px rgba(0,0,0,0.4);
        transition: all 0.3s ease;
        z-index: 10;
        transform: scaleX(-1); /* Mirror local video */
    }

    /* Status / Loading State */
    .status-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        z-index: 5;
        pointer-events: none;
    }
    .status-icon {
        font-size: 48px;
        margin-bottom: 1rem;
        animation: pulse 2s infinite;
        opacity: 0.7;
    }
    @keyframes pulse { 0% { opacity: 0.4; } 50% { opacity: 0.8; } 100% { opacity: 0.4; } }

    /* ==================================================
       Controls Bar
       ================================================== */
    .controls-bar {
        height: var(--control-bar-height);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        padding-bottom: 1.5rem;
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 20;
        background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
    }

    .control-btn.pin-active {
        background: #10b981;
        color: white;
    }

    .control-btn {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        border: none;
        background: rgba(255,255,255,0.15);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        backdrop-filter: blur(10px);
        transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    
    .control-btn .material-symbols-outlined { font-size: 24px; }

    .control-btn:hover {
        background: rgba(255,255,255,0.25);
        transform: scale(1.05);
    }
    
    .control-btn.toggled-off {
        background: #fff;
        color: #000;
    }
    
    .control-btn.danger {
        background: #ef4444;
        color: white;
    }
    .control-btn.danger:hover {
        background: #dc2626;
        transform: scale(1.1);
    }

    /* ==================================================
       Room Selection Dialog
       ================================================== */
    .room-dialog {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 100;
        backdrop-filter: blur(8px);
    }

    .room-dialog-content {
        background: var(--bg-body, #f3f4f1);
        color: var(--text-main, #292524);
        padding: 2.5rem;
        border-radius: var(--radius-xl);
        max-width: 420px;
        width: 90%;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    }

    .room-dialog-content h2 {
        font-family: var(--font-display);
        font-size: 1.75rem;
        margin-bottom: 0.5rem;
        font-weight: 600;
    }

    .room-dialog-subtitle {
        color: #666;
        margin-bottom: 2rem;
        font-size: 0.95rem;
    }

    .room-section {
        margin-bottom: 1.5rem;
    }

    .room-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        padding: 1rem 1.5rem;
        border: none;
        border-radius: var(--radius-lg);
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }

    .room-btn .material-symbols-outlined {
        font-size: 20px;
    }

    .create-btn {
        background: #10b981;
        color: white;
    }
    .create-btn:hover {
        background: #059669;
        transform: translateY(-1px);
    }

    .join-btn {
        background: #3b82f6;
        color: white;
    }
    .join-btn:hover {
        background: #2563eb;
        transform: translateY(-1px);
    }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 1.5rem 0;
        color: #888;
        font-size: 0.875rem;
    }
    .divider::before,
    .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid #ddd;
    }
    .divider::before { margin-right: 1rem; }
    .divider::after { margin-left: 1rem; }

    .room-input {
        width: 100%;
        padding: 0.875rem 1rem;
        border: 2px solid #e5e5e5;
        border-radius: var(--radius-md);
        font-size: 1.25rem;
        text-align: center;
        letter-spacing: 0.25em;
        margin-bottom: 1rem;
        transition: border-color 0.2s;
    }
    .room-input:focus {
        outline: none;
        border-color: #3b82f6;
    }

    .room-id-display {
        margin-top: 1.5rem;
        padding: 1.5rem;
        background: #f0fdf4;
        border: 2px dashed #10b981;
        border-radius: var(--radius-lg);
    }

    .room-id-box {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        margin: 1rem 0;
    }

    .room-id-text {
        font-family: 'Courier New', monospace;
        font-size: 2rem;
        font-weight: 700;
        color: #059669;
        letter-spacing: 0.15em;
    }

    .copy-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border: none;
        background: #10b981;
        color: white;
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: all 0.2s;
    }
    .copy-btn:hover {
        background: #059669;
    }

    .room-hint {
        font-size: 0.875rem;
        color: #666;
        margin-bottom: 1rem;
    }

    .enter-room-btn {
        width: 100%;
        padding: 0.875rem;
        border: none;
        background: #059669;
        color: white;
        border-radius: var(--radius-md);
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }
    .enter-room-btn:hover {
        background: #047857;
    }

    .join-section {
        display: flex;
        flex-direction: column;
    }

    @media (max-width: 600px) {
        #localVideo { width: 90px; height: 120px; bottom: 90px; right: 1rem; }
        .control-btn { width: 48px; height: 48px; }
        .room-dialog-content { padding: 1.5rem; }
        .room-id-text { font-size: 1.5rem; }
    }
  </style>

</head>
<body>

    <!-- Header Overlay -->
    <header class="call-header">
        <div class="header-left">
            <a href="/campfire" class="back-btn" aria-label="End call and go back">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div class="participant-info">
                <h2 id="remoteName">Campfire Call</h2>
                <p id="callStatus">Connecting...</p>
            </div>
        </div>
    </header>

    <!-- Room Selection Dialog -->
    <div class="room-dialog" id="roomDialog">
        <div class="room-dialog-content">
            <h2>Video Call</h2>
            <p class="room-dialog-subtitle">Create a new room or join an existing one</p>
            
            <div class="room-section">
                <button class="room-btn create-btn" onclick="createRoom()">
                    <span class="material-symbols-outlined">add_circle</span>
                    Create Room
                </button>
                <div class="room-id-display" id="createdRoomId" style="display: none;">
                    <p>Your Room ID:</p>
                    <div class="room-id-box">
                        <span id="roomIdText" class="room-id-text"></span>
                        <button class="copy-btn" onclick="copyRoomId()" title="Copy to clipboard">
                            <span class="material-symbols-outlined">content_copy</span>
                        </button>
                    </div>
                    <p class="room-hint">Share this ID with others to join</p>
                    <button class="enter-room-btn" onclick="enterCreatedRoom()">
                        Enter Room
                    </button>
                </div>
            </div>
            
            <div class="divider">or</div>
            
            <div class="room-section">
                <div class="join-section">
                    <input type="text" id="joinRoomId" class="room-input" placeholder="Enter 6-digit Room ID" maxlength="6">
                    <button class="room-btn join-btn" onclick="joinRoom()">
                        <span class="material-symbols-outlined">login</span>
                        Join Room
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Video Stage -->
    <div class="video-stage" id="videoStage" style="display: none;">
        <div class="status-overlay" id="statusOverlay">
            <span class="material-symbols-outlined status-icon">sensors</span>
            <p>Waiting for others to join...</p>
        </div>
        <video id="remoteVideo" autoplay playsinline></video>
        <video id="localVideo" autoplay playsinline muted></video>
    </div>


    <!-- Controls -->
    <div class="controls-bar">
        <button class="control-btn" id="btnMic" onclick="toggleMic()">
            <span class="material-symbols-outlined">mic</span>
        </button>
        
        <button class="control-btn danger" id="btnEnd" onclick="endCall()">
            <span class="material-symbols-outlined">call_end</span>
        </button>
        
        <button class="control-btn" id="btnCam" onclick="toggleCam()">
            <span class="material-symbols-outlined">videocam</span>
        </button>
    </div>

    <script>
        // --- Theme Logic (Read-only for consistency) ---
        const storageKey = 'remainwith-theme';
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }
        const savedTheme = getCookie(storageKey);
        if (savedTheme) document.documentElement.setAttribute('data-theme', savedTheme);

        // --- Native WebRTC Video Call Logic ---
        const localVideo = document.getElementById('localVideo');
        const remoteVideo = document.getElementById('remoteVideo');
        const statusOverlay = document.getElementById('statusOverlay');
        const callStatus = document.getElementById('callStatus');
        const btnMic = document.getElementById('btnMic');
        const btnCam = document.getElementById('btnCam');
        const roomDialog = document.getElementById('roomDialog');
        const videoStage = document.getElementById('videoStage');
        const createdRoomIdDiv = document.getElementById('createdRoomId');
        const roomIdText = document.getElementById('roomIdText');
        const joinRoomIdInput = document.getElementById('joinRoomId');

        let localStream = null;
        let pc = null; // Peer connection to SFU
        let sfuWs = null; // WebSocket for SFU (WebRTC signaling)
        let roomWs = null; // WebSocket for room management
        let roomID = null;
        let generatedRoomId = null;
        let isConnecting = false;
        let reconnectAttempts = 0;
        const MAX_RECONNECT_ATTEMPTS = 3;
        
        // Port forwarding detection
        const isPortForwarded = window.location.protocol === 'http:' || 
                              window.location.hostname === 'localhost' || 
                              window.location.hostname === '127.0.0.1' ||
                              window.location.hostname.includes('.app.github.dev'); // VS Code tunnels
        
        // Map to track remote video elements by participant (using stable participant ID)
        const remoteVideos = new Map(); // participantID -> {element, stream, tracks, audioTrack, videoTrack}
        // Track which streams we've already processed to avoid duplicates
        const processedStreams = new Set();
        // Map of stream IDs to participant IDs for grouping tracks
        const streamToParticipant = new Map();
        // Counter for participant IDs to ensure consistency
        let participantCounter = 0;

        
        // Connection state tracking
        let connectionState = 'new'; // new, connecting, connected, disconnected, failed



        // Get user info from backend
        const userID = {{.UserID}};
        const userName = "{{.UserName}}";

        // WebRTC configuration with STUN and TURN servers
        // Enhanced configuration for VS Code port forwarding and restrictive NATs
        // For port forwarding, we rely heavily on TURN servers since direct P2P is blocked
        const rtcConfig = {
            iceServers: [
                // TURN servers FIRST - these work through port forwarding
                // OpenRelay (free, public TURN servers)
                {
                    urls: ['turn:openrelay.metered.ca:80', 'turn:openrelay.metered.ca:443', 'turn:openrelay.metered.ca:443?transport=tcp'],
                    username: 'openrelayproject',
                    credential: 'openrelayproject'
                },
                // Additional TURN server options for reliability
                {
                    urls: 'turn:45.33.52.3:3478?transport=tcp',
                    username: 'webrtc',
                    credential: 'webrtc'
                },
                // STUN servers as fallback (less reliable with port forwarding)
                { urls: 'stun:stun.l.google.com:19302' },
                { urls: 'stun:stun1.l.google.com:19302' },
                { urls: 'stun:stun2.l.google.com:19302' },
                { urls: 'stun:stun.cloudflare.com:3478' }
            ],
            // ICE candidate policies for port forwarding
            iceTransportPolicy: 'all', // Try all candidates (host, srflx, relay)
            // Bundle: Use single transport for all media (important for forwarding)
            bundlePolicy: 'max-bundle',
            // RTCP mux: Share transport (important for conserving connections)
            rtcpMuxPolicy: 'require',
            // ICE pool size
            iceCandidatePoolSize: 10
        };


        // Video constraints for optimal streaming (fixes video packet issues)
        const videoConstraints = {
            width: { ideal: 1280, min: 640 },
            height: { ideal: 720, min: 480 },
            frameRate: { ideal: 30, min: 15 }
        };
        
        // Aggressive audio processing to fix echo and robotic sound
        const audioConstraints = {
            echoCancellation: true,
            noiseSuppression: true,
            autoGainControl: true,
            // Additional constraints for better audio quality
            sampleRate: 48000,
            channelCount: 1, // Mono to reduce echo
            latency: 0.01, // Low latency
            // Advanced processing
            voiceIsolation: true,
            sampleSize: 16
        };


        // Generate a 6-digit room ID
        function generateRoomId() {
            return Math.floor(100000 + Math.random() * 900000).toString();
        }

        // Create a new room
        async function createRoom() {
            generatedRoomId = generateRoomId();
            roomIdText.textContent = generatedRoomId;
            createdRoomIdDiv.style.display = 'block';
            console.log('Generated room ID:', generatedRoomId);
        }

        // Copy room ID to clipboard
        async function copyRoomId() {
            try {
                await navigator.clipboard.writeText(generatedRoomId);
                const copyBtn = document.querySelector('.copy-btn');
                copyBtn.innerHTML = '<span class="material-symbols-outlined">check</span>';
                setTimeout(() => {
                    copyBtn.innerHTML = '<span class="material-symbols-outlined">content_copy</span>';
                }, 2000);
            } catch (err) {
                console.error('Failed to copy:', err);
                // Fallback: select text
                const range = document.createRange();
                range.selectNode(roomIdText);
                window.getSelection().removeAllRanges();
                window.getSelection().addRange(range);
            }
        }

        // Enter the created room
        async function enterCreatedRoom() {
            if (!generatedRoomId) return;
            roomID = generatedRoomId;
            await startVideoCall();
        }

        // Join an existing room
        async function joinRoom() {
            const enteredId = joinRoomIdInput.value.trim();
            if (!enteredId || enteredId.length !== 6 || !/^\d{6}$/.test(enteredId)) {
                alert('Please enter a valid 6-digit room ID');
                return;
            }
            roomID = enteredId;
            await startVideoCall();
        }

        // Start the video call after room selection
        async function startVideoCall() {
            // Hide dialog, show video stage
            roomDialog.style.display = 'none';
            videoStage.style.display = 'flex';
            
            // Update header
            document.querySelector('.participant-info h2').textContent = 'Room: ' + roomID;
            
            // Start local stream first
            await startLocalStream();
            
            // Create peer connection before connecting WebSocket
            createPeerConnection();
            
            // Now connect to room and WebSockets
            await createOrJoinRoom();
        }
        
        // Create peer connection early, before WebSocket connection
        // CRITICAL: Do NOT add tracks here - add them after receiving the offer
        function createPeerConnection() {
            if (pc) {
                pc.close();
            }
            
            console.log('Creating peer connection with config:', rtcConfig);
            pc = new RTCPeerConnection(rtcConfig);
            console.log('Peer connection created');
            
            // DO NOT add transceivers or tracks here
            // We will add tracks AFTER receiving the offer from the server
            // This ensures proper sendrecv direction negotiation


            
            // Handle remote tracks - create new video elements for each remote participant
            pc.ontrack = (event) => {
                console.log('=== REMOTE TRACK RECEIVED ===');
                console.log('Track kind:', event.track.kind);
                console.log('Track ID:', event.track.id);
                console.log('Track enabled:', event.track.enabled);
                console.log('Stream count:', event.streams.length);
                console.log('Current remote video count:', remoteVideos.size);
                
                if (event.streams.length > 0) {
                    console.log('Stream ID:', event.streams[0].id);
                    console.log('Stream tracks:', event.streams[0].getTracks().length);
                    event.streams[0].getTracks().forEach(t => {
                        console.log('  - Track:', t.kind, t.id, 'enabled:', t.enabled);
                    });
                }
                
                const stream = event.streams[0];
                const track = event.track;
                
                if (!stream) {
                    console.warn('No stream associated with track:', track.id);
                    return;
                }
                
                // Create a unique key for this track
                const trackKey = `${stream.id}-${track.kind}-${track.id}`;
                
                // Check if we've already processed this exact track
                if (processedStreams.has(trackKey)) {
                    console.log('Already processing track:', trackKey);
                    return;
                }
                processedStreams.add(trackKey);
                
                // Safety check - ensure we're not creating too many video elements
                if (remoteVideos.size >= 10) {
                    console.warn('⚠️ Too many video elements created:', remoteVideos.size, '- possible bug in participant grouping');
                }
                
                handleRemoteTrack(stream, track, trackKey);
            };




            // Handle ICE candidates - send immediately
            pc.onicecandidate = (event) => {
                if (event.candidate && sfuWs && sfuWs.readyState === WebSocket.OPEN) {
                    sendSFUMessage({
                        type: 'candidate',
                        candidate: {
                            candidate: event.candidate.candidate,
                            sdpMid: event.candidate.sdpMid,
                            sdpMLineIndex: event.candidate.sdpMLineIndex
                        }
                    });
                }
            };
            
            // Handle connection state changes
            pc.onconnectionstatechange = () => {
                console.log('Connection state:', pc.connectionState);
                connectionState = pc.connectionState;
                
                if (pc.connectionState === 'connected') {
                    updateStatus('Connected');
                    statusOverlay.style.display = 'none';
                    reconnectAttempts = 0; // Reset reconnect attempts on success
                    
                    // Check if local tracks are being sent
                    console.log('Checking local track senders...');
                    const senders = pc.getSenders();
                    console.log('Number of senders:', senders.length);
                    
                    senders.forEach((sender, index) => {
                        if (sender.track) {
                            console.log(`Sender ${index}:`, {
                                kind: sender.track.kind,
                                id: sender.track.id,
                                enabled: sender.track.enabled,
                                readyState: sender.track.readyState
                            });
                            
                            // Monitor sender stats
                            pc.getStats(sender).then(stats => {
                                stats.forEach(report => {
                                    if (report.type === 'outbound-rtp') {
                                        console.log(`Outbound RTP (${sender.track.kind}):`, {
                                            bytesSent: report.bytesSent,
                                            packetsSent: report.packetsSent,
                                            framesEncoded: report.framesEncoded,
                                            qualityLimitation: report.qualityLimitation
                                        });
                                        
                                        if (report.bytesSent === 0 && report.packetsSent === 0) {
                                            console.warn(`⚠️  ${sender.track.kind.toUpperCase()} track not sending data! Check firewall/network.`);
                                            if (isPortForwarded) {
                                                console.warn('ℹ️  Using port forwarding - ensure TURN relay is being used, not direct connection.');
                                            }
                                        } else {
                                            console.log(`✓ ${sender.track.kind.toUpperCase()} track is sending data`);
                                        }
                                    }
                                });
                            });
                        }
                    });
                    
                } else if (pc.connectionState === 'connecting') {
                    updateStatus('Connecting...');
                } else if (pc.connectionState === 'failed') {
                    console.error('Connection failed');
                    updateStatus('Connection failed - retrying...');
                    handleConnectionFailure();
                } else if (pc.connectionState === 'disconnected') {
                    updateStatus('Disconnected');
                    // Don't immediately reconnect, wait to see if it recovers
                    setTimeout(() => {
                        if (pc && pc.connectionState === 'disconnected') {
                            handleConnectionFailure();
                        }
                    }, 5000);
                }
            };
            
            // Handle ICE connection state changes
            pc.oniceconnectionstatechange = () => {
                console.log('ICE connection state:', pc.iceConnectionState);
                
                // Log ICE connection details
                pc.getStats().then(stats => {
                    stats.forEach(report => {
                        if (report.type === 'candidate-pair' && report.state === 'succeeded') {
                            console.log('Active ICE candidate pair:', {
                                local: report.localCandidateId ? stats.get(report.localCandidateId)?.candidate : 'unknown',
                                remote: report.remoteCandidateId ? stats.get(report.remoteCandidateId)?.candidate : 'unknown',
                                currentRoundTripTime: report.currentRoundTripTime,
                                availableOutgoingBitrate: report.availableOutgoingBitrate
                            });
                        }
                    });
                });
                
                // Warn if using host candidate (direct connection) instead of relay
                if (pc.iceConnectionState === 'connected' || pc.iceConnectionState === 'completed') {
                    pc.getStats().then(stats => {
                        let isUsingRelay = false;
                        stats.forEach(report => {
                            if (report.type === 'candidate-pair' && report.state === 'succeeded') {
                                const localCand = stats.get(report.localCandidateId);
                                if (localCand && (localCand.candidateType === 'relay' || localCand.candidateType === 'prflx')) {
                                    isUsingRelay = true;
                                }
                            }
                        });
                        
                        if (!isUsingRelay) {
                            console.warn('⚠️  Using direct connection (not relay). If media doesn\'t flow through port forwarding, this may be an issue.');
                            console.log('📡 For port forwarding, prefer TURN relay candidates. Ensure TURN servers are configured.');
                        } else {
                            console.log('✓ Using TURN relay candidate (good for port forwarding)');
                        }
                    });
                }
            };
            
            console.log('Peer connection created');
        }
        
        // Handle remote track - create video element
        function handleRemoteTrack(stream, track, trackKey) {
            const streamId = stream.id;
            
            console.log('=== HANDLING REMOTE TRACK ===');
            console.log('Track kind:', track.kind, '| Stream ID:', streamId.substring(0, 8) + '...');
            console.log('Current participants:', remoteVideos.size);
            
            // SMART GROUPING: Try to match audio and video from same peer
            let participantId = streamToParticipant.get(streamId);
            
            if (!participantId) {
                // New stream - check if it should pair with existing unmatched participant
                let unmatchedParticipant = null;
                
                for (let [pId, videoData] of remoteVideos) {
                    const hasAudio = videoData.audioTrack !== null;
                    const hasVideo = videoData.videoTrack !== null;
                    
                    if (track.kind === 'video' && hasAudio && !hasVideo) {
                        console.log('✓ Pairing video WITH existing audio!');
                        unmatchedParticipant = pId;
                        break;
                    } else if (track.kind === 'audio' && hasVideo && !hasAudio) {
                        console.log('✓ Pairing audio WITH existing video!');
                        unmatchedParticipant = pId;
                        break;
                    }
                }
                
                if (unmatchedParticipant) {
                    participantId = unmatchedParticipant;
                    streamToParticipant.set(streamId, participantId);
                } else {
                    participantId = 'participant-' + (++participantCounter);
                    streamToParticipant.set(streamId, participantId);
                    console.log('✓ Created NEW participant');
                }
            }
            
            // Hide the static remoteVideo element when we get actual remote tracks
            const staticRemoteVideo = document.getElementById('remoteVideo');
            if (staticRemoteVideo) {
                staticRemoteVideo.style.display = 'none';
            }
            
            // Use stable participant ID to group all tracks from same peer
            let videoData = remoteVideos.get(participantId);
            let videoEl;
            
            if (!videoData) {
                console.log('Creating new video element for participant:', participantId);
                
                // Create new video element for this participant
                videoEl = document.createElement('video');
                videoEl.id = 'video-' + participantId;
                videoEl.autoplay = true;
                videoEl.playsinline = true;
                videoEl.muted = false; // Ensure audio is not muted for remote videos
                
                // Apply base styles for video element
                videoEl.style.objectFit = 'cover';
                videoEl.style.background = '#111';
                videoEl.style.borderRadius = 'var(--radius-lg)';
                videoEl.style.zIndex = '5';
                videoEl.style.position = 'absolute';
                videoEl.style.top = '0';
                videoEl.style.left = '0';
                
                // Store in our map with metadata
                videoData = {
                    element: videoEl,
                    stream: stream,
                    tracks: new Set([track.id]),
                    audioTrack: track.kind === 'audio' ? track : null,
                    videoTrack: track.kind === 'video' ? track : null,
                    participantId: participantId
                };
                remoteVideos.set(participantId, videoData);
                console.log('Stored video data, total participants:', remoteVideos.size);
                
                // Add to video stage (before the status overlay)
                const videoStage = document.querySelector('.video-stage');
                videoStage.insertBefore(videoEl, statusOverlay);
                console.log('Inserted video element into DOM');
                
                // Handle stream ending
                stream.onremovetrack = (e) => {
                    console.log('Track ended:', e.track.kind);
                    const videoData = remoteVideos.get(participantId);
                    if (videoData) {
                        videoData.tracks.delete(e.track.id);
                        if (e.track.kind === 'audio') videoData.audioTrack = null;
                        if (e.track.kind === 'video') videoData.videoTrack = null;
                        
                        if (videoData.tracks.size === 0) {
                            checkAndCleanupRemoteVideo(participantId);
                        }
                    }
                };
                
                // Update layout after adding element
                updateVideoLayout();
                console.log('Updated video layout');
            } else {
                // Add track to existing video element for this participant
                console.log('Adding', track.kind, 'track to existing element');
                videoData.tracks.add(track.id);
                
                // Update track references
                if (track.kind === 'audio') {
                    videoData.audioTrack = track;
                } else if (track.kind === 'video') {
                    videoData.videoTrack = track;
                }
                
                videoEl = videoData.element;
            }
            
            // Set the stream as the source - intelligently merge if needed
            if (videoEl) {
                const existingStream = videoEl.srcObject;
                if (existingStream && existingStream.id !== stream.id) {
                    // Different streams - merge tracks
                    console.log('Merging tracks from different streams');
                    try {
                        stream.getTracks().forEach(t => {
                            const exists = existingStream.getTracks().find(et => et.id === t.id);
                            if (!exists) {
                                existingStream.addTrack(t);
                            }
                        });
                    } catch (e) {
                        console.log('Merge failed:', e.message);
                        videoEl.srcObject = stream;
                    }
                } else {
                    videoEl.srcObject = stream;
                }
                
                // Ensure playback
                videoEl.play().catch(err => console.warn('Play failed:', err.message));
            }
            
            // Update UI
            statusOverlay.style.display = 'none';
            updateStatus('Connected - ' + remoteVideos.size + ' participant(s)');
            console.log('✓ Track complete. Participants:', remoteVideos.size);
        }

        // Update video layout based on number of participants
        function updateVideoLayout() {
            const count = remoteVideos.size + 1; // +1 for local video
            
            remoteVideos.forEach((videoData, participantId) => {
                const videoEl = videoData.element;
                
                if (count <= 2) {
                    // One remote participant - full screen
                    videoEl.style.width = '100%';
                    videoEl.style.height = '100%';
                    videoEl.style.position = 'absolute';
                    videoEl.style.top = '0';
                    videoEl.style.left = '0';
                    videoEl.style.objectFit = 'cover';
                    videoEl.style.zIndex = '5';
                    videoEl.style.borderRadius = '0';
                } else {
                    // Multiple participants - grid layout
                    videoEl.style.width = '50%';
                    videoEl.style.height = '50%';
                    videoEl.style.position = 'absolute';
                    videoEl.style.objectFit = 'cover';
                    videoEl.style.zIndex = '5';
                    videoEl.style.borderRadius = '0';
                    
                    // Position based on index
                    const index = Array.from(remoteVideos.keys()).indexOf(participantId);
                    const row = Math.floor(index / 2);
                    const col = index % 2;
                    videoEl.style.top = (row * 50) + '%';
                    videoEl.style.left = (col * 50) + '%';
                }
            });
        }




        
        // Check if all tracks ended and cleanup
        function checkAndCleanupRemoteVideo(participantId) {
            const videoData = remoteVideos.get(participantId);
            if (!videoData) return;
            
            const videoEl = videoData.element;
            const stream = videoData.stream;
            
            // Check if all tracks in the stream have ended
            const allTracksEnded = stream.getTracks().every(t => t.readyState === 'ended');
            if (allTracksEnded) {
                console.log('Removing video element for participant:', participantId);
                videoEl.remove();
                remoteVideos.delete(participantId);
                
                // Also clean up the stream mapping
                streamToParticipant.forEach((pId, streamId) => {
                    if (pId === participantId) {
                        streamToParticipant.delete(streamId);
                    }
                });
                
                // Update layout for remaining participants
                updateVideoLayout();
                
                // Show status if no more remote videos
                if (remoteVideos.size === 0) {
                    // Show the static remoteVideo again when no participants
                    const staticRemoteVideo = document.getElementById('remoteVideo');
                    if (staticRemoteVideo) {
                        staticRemoteVideo.style.display = 'block';
                    }
                    statusOverlay.style.display = 'block';
                    statusOverlay.querySelector('p').textContent = 'Waiting for others to join...';
                    updateStatus('Waiting for others...');
                } else {
                    updateStatus('Connected - ' + remoteVideos.size + ' participant(s)');
                }
            }
        }


        
        // Handle connection failure with retry
        function handleConnectionFailure() {
            if (reconnectAttempts < MAX_RECONNECT_ATTEMPTS) {
                reconnectAttempts++;
                console.log(`Reconnect attempt ${reconnectAttempts}/${MAX_RECONNECT_ATTEMPTS}`);
                
                // Close existing connection
                if (pc) {
                    pc.close();
                }
                
                // Recreate peer connection
                createPeerConnection();
                
                // Reconnect WebSocket if needed
                if (sfuWs && sfuWs.readyState !== WebSocket.OPEN) {
                    connectWebSockets();
                }
            } else {
                updateStatus('Connection failed - please refresh');
                statusOverlay.innerHTML = `
                    <span class="material-symbols-outlined status-icon" style="color: #ef4444;">error</span>
                    <p>Connection failed. Please refresh the page.</p>
                `;
                statusOverlay.style.display = 'block';
            }
        }


