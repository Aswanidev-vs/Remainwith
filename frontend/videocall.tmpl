        function connectWebSockets() {
            if (isConnecting) return;
            isConnecting = true;
            
            const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';

            sfuWs = closeSocket(sfuWs);
            roomWs = closeSocket(roomWs);

            // Connect to SFU for WebRTC signaling
            const sfuUrl = `${protocol}//${window.location.host}/ws/sfu?client_id=${userID}&room_id=${roomID}`;
            sfuWs = new WebSocket(sfuUrl);

            sfuWs.onopen = async () => {
                console.log('SFU WebSocket connected');
                isConnecting = false;

                // Send ready signal to SFU
                sendSFUMessage({ type: 'ready' });
                sendSFUMessage({ type: 'quality_preference', quality: selectedReceiveQuality });
                console.log('Sent ready signal to SFU');

                // Immediately create and send an offer to publish our local tracks.
                // The SFU is configured to receive offers from the client (not send them).
                try {
                    console.log('Creating initial offer to publish local tracks...');
                    const offer = await pc.createOffer();
                    console.log('Created local offer:', { type: offer.type, sdpSnippet: offer.sdp.substring(0, 200) + '...' });
                    await pc.setLocalDescription(offer);
                    console.log('Set local description (offer)');

                    // Wait for ICE gathering to complete before sending
                    await waitForIceGathering();

                    const finalOffer = pc.localDescription;
                    if (!finalOffer) {
                        throw new Error('Local description is null after ICE gathering');
                    }
                    console.log('Sending initial offer to SFU, SDP length:', finalOffer.sdp.length);
                    const hasSendRecv = finalOffer.sdp.includes('a=sendrecv');
                    const hasSendOnly = finalOffer.sdp.includes('a=sendonly');
                    console.log('Offer directions - sendrecv:', hasSendRecv, 'sendonly:', hasSendOnly);
                    sendSFUMessage({
                        type: 'offer',
                        offer: finalOffer.sdp
                    });
                    console.log('✓ Initial offer sent to SFU');
                } catch (err) {
                    console.error('Failed to send initial offer to SFU:', err);
                }
            };

            sfuWs.onmessage = (event) => {
                const msg = JSON.parse(event.data);
                handleSFUMessage(msg);
            };

            sfuWs.onclose = (event) => {
                console.log('SFU WebSocket closed', {
                    code: event.code,
                    reason: event.reason,
                    wasClean: event.wasClean
                });
                isConnecting = false;
                callStatus.textContent = 'Disconnected';
                
                // Attempt to reconnect after a delay
                if (reconnectAttempts < MAX_RECONNECT_ATTEMPTS) {
                    console.log('Attempting to reconnect...');
                    scheduleReconnect('sfu-websocket-closed', 2000);
                }
            };

            sfuWs.onerror = (error) => {
                console.error('SFU WebSocket error:', error);
                isConnecting = false;
            };

            // Connect to signaling for room management
            const signalingUrl = `${protocol}//${window.location.host}/ws/signaling?user_id=${userID}&room_id=${roomID}`;
            roomWs = new WebSocket(signalingUrl);

            roomWs.onopen = () => {
                console.log('Room WebSocket connected');
                // Send join message
                sendRoomMessage({
                    type: 'join'
                });
            };

            roomWs.onmessage = (event) => {
                const msg = JSON.parse(event.data);
                handleRoomMessage(msg);
            };

            roomWs.onclose = (event) => {
                console.log('Room WebSocket closed', {
                    code: event.code,
                    reason: event.reason,
                    wasClean: event.wasClean
                });
                if ((event.code === 1005 || !event.wasClean) && reconnectAttempts < MAX_RECONNECT_ATTEMPTS) {
                    if (!roomWs || roomWs.readyState === WebSocket.CLOSED) {
                        scheduleReconnect('room-websocket-closed', 1500);
                    }
                }
            };

            roomWs.onerror = (error) => {
                console.error('Room WebSocket error:', error);
            };

        }

        function sendSFUMessage(msg) {
            if (sfuWs && sfuWs.readyState === WebSocket.OPEN) {
                sfuWs.send(JSON.stringify(msg));
            }
        }

        function sendRoomMessage(msg) {
            if (roomWs && roomWs.readyState === WebSocket.OPEN) {
                roomWs.send(JSON.stringify(msg));
            }
        }

        function handleSFUMessage(msg) {
            switch (msg.type) {
                case 'offer':
                    handleOffer(msg);
                    break;
                case 'answer':
                    handleAnswer(msg);
                    break;
                case 'candidate':
                    handleCandidate(msg);
                    break;
                case 'reconnect':
                    // Server signaled us to reconnect - this happens when connection was lost
                    console.log('Received reconnect signal from server');
                    scheduleReconnect('server-reconnect-signal', 0);
                    break;
            }
        }


        function handleRoomMessage(msg) {
            // Handle room management messages (mute_status, camera_status, etc.)
            console.log('Room message:', msg);
            const participant = msg.data || {};
            
            switch (msg.type) {
                case 'participant_joined':
                    console.log('Participant joined:', participant.name || msg.participant_name || participant.id || msg.participant_id);
                    // Hide waiting overlay when a participant joins
                    if ((participant.id || msg.participant_id) && (participant.id || msg.participant_id) !== userID.toString()) {
                        statusOverlay.style.display = 'none';
                        updateStatus('Connected - ' + (participant.name || msg.participant_name || 'Participant'));
                    }
                    break;
                case 'participant_left':
                    console.log('Participant left:', participant.id || msg.participant_id);
                    // Show waiting overlay if no more participants
                    if (remoteVideos.size === 0) {
                        statusOverlay.style.display = 'block';
                        statusOverlay.querySelector('p').textContent = 'Waiting for others to join...';
                        updateStatus('Waiting for others...');
                    }
                    break;
                case 'existing_participants':
                    // Received list of existing participants when joining
                    console.log('Existing participants:', msg.data || msg.participants);
                    if ((msg.data && msg.data.length > 0) || (msg.participants && msg.participants.length > 0)) {
                        const count = msg.data ? msg.data.length : msg.participants.length;
                        // There are already participants in the room
                        statusOverlay.querySelector('p').textContent = 'Connecting to ' + count + ' participant(s)...';
                    }
                    break;
            }
        }




        async function handleOffer(msg) {
            if (!pc) {
                console.error('No peer connection available');
                return;
            }
            
            try {
                console.log('Handling offer from SFU', { type: 'offer', sdpSnippet: msg.offer.substring(0, 200) + '...' });
                console.log('Current transceivers:', pc.getTransceivers().length);
                console.log('Current signaling state:', pc.signalingState);
                
                // Check if we need to restart ICE (for renegotiation)
                const offerDesc = new RTCSessionDescription({
                    type: 'offer',
                    sdp: msg.offer
                });
                
                // Set remote description
                console.log('setRemoteDescription (offer) about to be called...');
                await pc.setRemoteDescription(offerDesc);
                console.log('✓ Remote description (offer) set successfully');
                
                // CRITICAL FIX: Associate local tracks with transceivers after remote description is set
                // This ensures the answer will have sendrecv direction instead of recvonly
                if (localStream) {
                    console.log('Associating local tracks with transceivers...');
                    const transceivers = pc.getTransceivers();
                    const localTracks = localStream.getTracks();
                    
                    // First, ensure we have senders for our local tracks
                    const existingSenders = pc.getSenders();
                    const senderKinds = new Set();
                    existingSenders.forEach(sender => {
                        if (sender.track) {
                            senderKinds.add(sender.track.kind);
                        }
                    });
                    
                    // Add any missing tracks as senders first
                    localTracks.forEach(track => {
                        if (!senderKinds.has(track.kind)) {
                            console.log(`Adding missing ${track.kind} sender`);
                            try {
                                addLocalTrackToPeerConnection(track);
                            } catch (e) {
                                console.error(`Failed to add ${track.kind} track:`, e);
                            }
                        }
                    });
                    
                    // Now associate tracks with transceivers
                    transceivers.forEach((transceiver, index) => {
                        const kind = transceiver.receiver.track?.kind || transceiver.sender.track?.kind;
                        const direction = transceiver.direction;
                        console.log(`Transceiver[${index}] kind=${kind}, direction=${direction}, currentDirection=${transceiver.currentDirection}`);
                        
                        // Find matching local track
                        const localTrack = localTracks.find(t => t.kind === kind);
                        if (!localTrack) {
                            console.log(`  → No local ${kind} track available`);
                            return;
                        }
                        
                        // If transceiver is recvonly but we have a local track, change to sendrecv
                        if (direction === 'recvonly' && transceiver.sender) {
                            console.log(`  → Changing recvonly transceiver[${index}] to sendrecv (we have local ${kind} track)`);
                            transceiver.direction = 'sendrecv';
                        }
                        
                        // Associate the track with the sender
                        if (transceiver.sender) {
                            const currentSenderTrack = transceiver.sender.track;
                            if (!currentSenderTrack) {
                                console.log(`  → Setting sender track to local ${kind} track`);
                                transceiver.sender.replaceTrack(localTrack).then(() => {
                                    console.log(`  → ✓ Successfully associated local ${kind} track with transceiver[${index}]`);
                                }).catch(e => {
                                    console.error(`  → Failed to replace track:`, e);
                                });
                            } else if (currentSenderTrack.id !== localTrack.id) {
                                console.log(`  → Replacing existing sender track with local ${kind} track`);
                                transceiver.sender.replaceTrack(localTrack).then(() => {
                                    console.log(`  → ✓ Successfully replaced with local ${kind} track`);
                                }).catch(e => {
                                    console.error(`  → Failed to replace track:`, e);
                                });
                            } else {
                                console.log(`  → Sender already has correct ${kind} track`);
                            }
                        }
                    });
                }


                
                console.log('Remote description set, creating answer...');

                
                // Create answer
                const answer = await pc.createAnswer();
                console.log('Created local answer:', { type: answer.type, sdpSnippet: answer.sdp.substring(0, 200) + '...' });
                
                // Log answer directions for debugging
                const hasSendRecv = answer.sdp.includes('a=sendrecv');
                const hasSendOnly = answer.sdp.includes('a=sendonly');
                const hasRecvOnly = answer.sdp.includes('a=recvonly');
                console.log('Answer directions - sendrecv:', hasSendRecv, 'sendonly:', hasSendOnly, 'recvonly:', hasRecvOnly);
                
                if (!hasSendRecv && hasRecvOnly) {
                    console.warn('⚠️  WARNING: Answer is recvonly - local tracks may not be sending!');
                    console.warn('   This means video/audio packets will NOT flow to the server.');
                }

                
                // Set local description - this triggers ICE gathering
                console.log('setLocalDescription (answer) about to be called...');
                await pc.setLocalDescription(answer);
                console.log('✓ Local description (answer) set successfully, ICE gathering state:', pc.iceGatheringState);

                
                // Wait for ICE gathering to complete
                await waitForIceGathering();
                
                // Get the final SDP with ICE candidates
                const finalAnswer = pc.localDescription;
                
                if (!finalAnswer) {
                    throw new Error('Local description is null after ICE gathering');
                }
                
                console.log('Final answer SDP length:', finalAnswer.sdp.length);
                console.log('Answer has ice-ufrag:', finalAnswer.sdp.includes('ice-ufrag'));
                console.log('Answer has ice-pwd:', finalAnswer.sdp.includes('ice-pwd'));
                console.log('Answer has m-lines:', finalAnswer.sdp.includes('m='));
                
                // Validate answer has required ICE credentials
                if (!finalAnswer.sdp.includes('ice-ufrag') || !finalAnswer.sdp.includes('ice-pwd')) {
                    console.warn('Answer SDP missing ICE credentials, waiting longer...');
                    // Wait a bit more and try again
                    await new Promise(resolve => setTimeout(resolve, 1000));
                    
                    const retryAnswer = pc.localDescription;
                    if (retryAnswer && retryAnswer.sdp.includes('ice-ufrag')) {
                        console.log('ICE credentials found after retry');
                        sendSFUMessage({
                            type: 'answer',
                            answer: retryAnswer.sdp
                        });
                    } else {
                        throw new Error('Answer SDP still missing ICE credentials after retry');
                    }
                } else {
                    // Send answer back with complete ICE candidates
                    sendSFUMessage({
                        type: 'answer',
                        answer: finalAnswer.sdp
                    });
                }
                
                console.log('Sent answer to SFU');
            } catch (err) {
                console.error('Error handling offer:', err);
                // Send error to SFU so it knows something went wrong
                sendSFUMessage({
                    type: 'error',
                    error: err.message
                });
            }
        }


        
        // Wait for ICE gathering to complete using a more reliable method
        function waitForIceGathering() {
            return new Promise((resolve) => {
                // If already complete, resolve immediately
                if (pc.iceGatheringState === 'complete') {
                    console.log('ICE gathering already complete');
                    resolve();
                    return;
                }
                
                console.log('ICE gathering state:', pc.iceGatheringState);
                
                let checkInterval;
                let timeout;
                let iceCandidateTimeout;
                let hasReceivedCandidates = false;
                
                const cleanup = () => {
                    clearInterval(checkInterval);
                    clearTimeout(timeout);
                    clearTimeout(iceCandidateTimeout);
                };
                
                // Listen for ICE candidates to ensure we're actually gathering
                const onIceCandidate = (event) => {
                    if (event.candidate) {
                        hasReceivedCandidates = true;
                        console.log('Received ICE candidate:', event.candidate.candidate.substring(0, 50));
                    }
                };
                
                pc.addEventListener('icecandidate', onIceCandidate);
                
                // Check periodically
                checkInterval = setInterval(() => {
                    if (pc.iceGatheringState === 'complete') {
                        console.log('ICE gathering complete (interval check), had candidates:', hasReceivedCandidates);
                        cleanup();
                        pc.removeEventListener('icecandidate', onIceCandidate);
                        resolve();
                    }
                }, 100);
                
                // Also listen for the event
                const onIceGatheringChange = () => {
                    console.log('ICE gathering state changed to:', pc.iceGatheringState);
                    if (pc.iceGatheringState === 'complete') {
                        cleanup();
                        pc.removeEventListener('icegatheringstatechange', onIceGatheringChange);
                        pc.removeEventListener('icecandidate', onIceCandidate);
                        resolve();
                    }
                };
                
                pc.addEventListener('icegatheringstatechange', onIceGatheringChange);
                
                // If we haven't received any candidates within 3 seconds, proceed anyway
                // This handles cases where the browser doesn't need to gather candidates
                iceCandidateTimeout = setTimeout(() => {
                    if (!hasReceivedCandidates && pc.iceGatheringState === 'new') {
                        console.log('No ICE candidates needed, proceeding');
                        cleanup();
                        pc.removeEventListener('icegatheringstatechange', onIceGatheringChange);
                        pc.removeEventListener('icecandidate', onIceCandidate);
                        resolve();
                    }
                }, 3000);
                
                // Hard timeout after 10 seconds
                timeout = setTimeout(() => {
                    console.log('ICE gathering timeout - proceeding anyway, state:', pc.iceGatheringState);
                    cleanup();
                    pc.removeEventListener('icegatheringstatechange', onIceGatheringChange);
                    pc.removeEventListener('icecandidate', onIceCandidate);
                    resolve();
                }, 10000);
            });
        }

        async function handleAnswer(msg) {

            if (!pc) return;
            
            try {
                console.log('Received answer from SFU', { type: 'answer', sdpSnippet: msg.answer.substring(0, 200) + '...' });
                await pc.setRemoteDescription(new RTCSessionDescription({
                    type: 'answer',
                    sdp: msg.answer
                }));
                console.log('Set remote description (answer)');
                console.log('Received answer from SFU, connection established');
            } catch (err) {
                console.error('Error handling answer:', err);
            }
        }


        async function handleCandidate(msg) {
            if (pc && msg.candidate) {
                try {
                    await pc.addIceCandidate(new RTCIceCandidate(msg.candidate));
                    console.log('Added ICE candidate');
                } catch (err) {
                    console.error('Error adding ICE candidate:', err);
                }
            }
        }




        function formatBitrate(bps) {
