<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <title>Chat · Remainwith</title>

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&amp;family=Noto+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>

  <style>
    /* ==================================================
       Remainwith Theme Variables
       ================================================== */
    :root {
      --font-display: "Newsreader", serif;
      --font-sans: "Noto Sans", sans-serif;
      --radius-sm: 0.375rem;
      --radius-md: 0.5rem;
      --radius-lg: 0.75rem;
      --radius-xl: 1rem;
      --radius-full: 9999px;
      --sidebar-width: 300px;
      --header-height: 64px;
    }

    /* 1. LIGHT THEME */
    html[data-theme="light"] {
      --primary: #7d8471;
      --primary-soft: rgba(125, 132, 113, 0.12);
      --bg-body: #f7f7f7;
      --bg-sidebar: #f0efed;
      --card-bg: #ffffff;
      --card-border: #e7e5e4;
      --text-main: #292524;
      --text-muted: #57534e;
      --text-subtle: #a8a29e;
      --divider: #f5f5f4;
      --glow-from: #e7e5e4;
      --glow-to: #f5f5f4;
      --stone-200: #e7e5e4;
      --sent-bg: #7d8471;
      --sent-text: #ffffff;
      --received-bg: #ffffff;
      --received-text: #292524;
      --msg-area-bg: #f5f5f4;
      --input-bg: #ffffff;
      --overlay-bg: rgba(0, 0, 0, 0.5);
      --call-surface: rgba(0, 0, 0, 0.85);
      --danger: #dc2626;
      --success: #16a34a;
    }

    /* 2. DARK THEME */
    html[data-theme="dark"] {
      --primary: #9ca38f;
      --primary-soft: rgba(156, 163, 143, 0.15);
      --bg-body: #191a18;
      --bg-sidebar: #1c1b19;
      --card-bg: #1c1917;
      --card-border: #292524;
      --text-main: #e7e5e4;
      --text-muted: #a8a29e;
      --text-subtle: #78716c;
      --divider: #292524;
      --glow-from: #292524;
      --glow-to: #1c1917;
      --stone-200: #292524;
      --sent-bg: #9ca38f;
      --sent-text: #1c1917;
      --received-bg: #292524;
      --received-text: #e7e5e4;
      --msg-area-bg: #191a18;
      --input-bg: #292524;
      --overlay-bg: rgba(0, 0, 0, 0.7);
      --call-surface: rgba(0, 0, 0, 0.92);
      --danger: #ef4444;
      --success: #22c55e;
    }

    /* 3. SEPIA THEME */
    html[data-theme="sepia"] {
      --primary: #8a7356;
      --primary-soft: rgba(138, 115, 86, 0.12);
      --bg-body: #f4ecd8;
      --bg-sidebar: #efe7d2;
      --card-bg: #fdf6e3;
      --card-border: #e6dcc6;
      --text-main: #433422;
      --text-muted: #746351;
      --text-subtle: #a89984;
      --divider: #e6dcc6;
      --glow-from: #e6dcc6;
      --glow-to: #fdf6e3;
      --stone-200: #dccfb8;
      --sent-bg: #8a7356;
      --sent-text: #ffffff;
      --received-bg: #fdf6e3;
      --received-text: #433422;
      --msg-area-bg: #f4ecd8;
      --input-bg: #fdf6e3;
      --overlay-bg: rgba(0, 0, 0, 0.5);
      --call-surface: rgba(0, 0, 0, 0.85);
      --danger: #dc2626;
      --success: #16a34a;
    }

    /* 4. FOREST THEME */
    html[data-theme="forest"] {
      --primary: #76a881;
      --primary-soft: rgba(118, 168, 129, 0.15);
      --bg-body: #1a211e;
      --bg-sidebar: #1e2622;
      --card-bg: #222b26;
      --card-border: #2f3b34;
      --text-main: #dcece1;
      --text-muted: #8ca392;
      --text-subtle: #56695e;
      --divider: #2f3b34;
      --glow-from: #2f3b34;
      --glow-to: #222b26;
      --stone-200: #2f3b34;
      --sent-bg: #76a881;
      --sent-text: #1a211e;
      --received-bg: #2f3b34;
      --received-text: #dcece1;
      --msg-area-bg: #1a211e;
      --input-bg: #222b26;
      --overlay-bg: rgba(0, 0, 0, 0.6);
      --call-surface: rgba(0, 0, 0, 0.9);
      --danger: #ef4444;
      --success: #22c55e;
    }

    /* ==================================================
       Reset & Base
       ================================================== */
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font-sans);
      background: var(--bg-body);
      color: var(--text-main);
      height: 100dvh;
      min-height: 100dvh;
      overflow: hidden;
      display: flex;
      transition: background-color 0.4s ease, color 0.4s ease;
    }

    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--text-subtle); border-radius: 3px; opacity: 0.5; }
    ::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }

    ::selection { background-color: var(--primary); color: var(--bg-body); }

    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      vertical-align: middle;
    }

    /* ==================================================
       Chat Layout
       ================================================== */
    #chat-app {
      display: flex;
      width: 100%;
      height: 100dvh;
      min-height: 100dvh;
    }

    /* ==================================================
       Sidebar
       ================================================== */
    #sidebar {
      width: var(--sidebar-width);
      min-width: var(--sidebar-width);
      background: var(--bg-sidebar);
      border-right: 1px solid var(--card-border);
      display: flex;
      flex-direction: column;
      height: 100dvh;
      transition: background-color 0.4s ease, border-color 0.4s ease;
    }

    .sidebar-header {
      padding: 1.25rem 1.25rem 0.75rem;
      flex-shrink: 0;
    }

    .sidebar-back {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 500;
      margin-bottom: 1.25rem;
      transition: color 0.2s;
    }
    .sidebar-back:hover { color: var(--primary); }
    .sidebar-back .material-symbols-outlined { font-size: 18px; }

    .sidebar-title {
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: 600;
      margin-bottom: 0.25rem;
      color: var(--text-main);
    }
    .sidebar-subtitle {
      font-size: 0.82rem;
      color: var(--text-subtle);
      font-style: italic;
      font-family: var(--font-display);
    }

    /* New Chat / Group button */
    .sidebar-actions {
      padding: 0.75rem 1.25rem;
      display: flex;
      gap: 0.5rem;
      flex-shrink: 0;
    }

    .btn-new-chat {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      padding: 0.6rem 0.75rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--card-border);
      background: var(--card-bg);
      color: var(--text-main);
      font-family: var(--font-sans);
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-new-chat:hover {
      border-color: var(--primary);
      color: var(--primary);
      background: var(--primary-soft);
    }
    .btn-new-chat .material-symbols-outlined { font-size: 18px; }

    /* Conversation List */
    .sidebar-section-label {
      padding: 1.25rem 1.25rem 0.35rem;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .badge {
      font-size: 0.65rem;
      padding: 0.1rem 0.4rem;
      border-radius: var(--radius-sm);
      font-weight: 600;
      text-transform: uppercase;
    }
    .badge-public { background: var(--primary-soft); color: var(--primary); }
    .badge-private { background: var(--divider); color: var(--text-muted); }

    .btn-join {
      padding: 0.25rem 0.6rem;
      font-size: 0.75rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--primary);
      background: transparent;
      color: var(--primary);
      cursor: pointer;
      font-weight: 600;
      transition: all 0.2s;
    }
    .btn-join:hover { background: var(--primary); color: #fff; }

    .conversation-list {
      flex: 1;
      overflow-y: auto;
      padding: 0 0.75rem 1rem;
    }

    .conv-item {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.7rem 0.65rem;
      border-radius: var(--radius-md);
      border: none;
      background: transparent;
      color: var(--text-main);
      font-family: var(--font-sans);
      font-size: 0.88rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      text-align: left;
    }
    .conv-item:hover { background: var(--primary-soft); }
    .conv-item.active {
      background: var(--primary-soft);
      color: var(--primary);
      font-weight: 600;
    }

    .conv-avatar {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-full);
      background: var(--stone-200);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--text-muted);
    }
    .conv-avatar.group-avatar {
      background: var(--primary-soft);
      color: var(--primary);
    }
    .conv-avatar .material-symbols-outlined { font-size: 20px; }

    .conv-info {
      flex: 1;
      min-width: 0;
    }
    .conv-name {
      display: block;
      font-weight: inherit;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .conv-preview {
      display: block;
      font-size: 0.75rem;
      color: var(--text-subtle);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-top: 0.1rem;
    }

    /* ==================================================
       Main Chat Panel
       ================================================== */
    #main-panel {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
      min-height: 0;
      height: 100dvh;
    }

    /* Chat Header */
    .chat-header {
      height: var(--header-height);
      min-height: var(--header-height);
      padding: 0 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--card-border);
      background: var(--card-bg);
      transition: all 0.4s ease;
    }

    .chat-header-left {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
    }

    .mobile-menu-btn {
      display: none;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border: none;
      border-radius: var(--radius-md);
      background: transparent;
      color: var(--text-muted);
      cursor: pointer;
    }
    .mobile-sidebar-close {
      display: none;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      border: none;
      border-radius: 0.8rem;
      background: rgba(255,255,255,0.04);
      color: var(--text-muted);
      cursor: pointer;
      margin-left: auto;
      flex-shrink: 0;
    }

    .chat-header-avatar {
      width: 38px;
      height: 38px;
      border-radius: var(--radius-full);
      background: var(--stone-200);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .chat-header-avatar.is-group {
      background: var(--primary-soft);
      color: var(--primary);
    }
    .chat-header-avatar .material-symbols-outlined { font-size: 20px; }

    .chat-header-info {
      min-width: 0;
    }
    .chat-header-name {
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .chat-header-status {
      font-size: 0.75rem;
      color: var(--text-subtle);
      font-style: italic;
    }

    .chat-header-right {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    .header-action-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border: none;
      border-radius: var(--radius-full);
      background: transparent;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
    }
    .header-action-btn:hover {
      background: var(--primary-soft);
      color: var(--primary);
    }
    .header-action-btn .material-symbols-outlined { font-size: 22px; }

    /* ==================================================
       Video / Call Area (Collapsible)
       ================================================== */
    #call-area {
      max-height: 0;
      overflow: hidden;
      background: var(--call-surface);
      transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    #call-area.active {
      max-height: 620px;
    }

    .call-shell {
      margin: 1rem;
      border-radius: var(--radius-xl);
      overflow: hidden;
      border: 1px solid var(--card-border);
      background:
        radial-gradient(circle at top left, rgba(118, 168, 129, 0.18), transparent 32%),
        linear-gradient(135deg, rgba(13, 16, 15, 0.96), rgba(26, 33, 30, 0.92));
      box-shadow: 0 20px 60px rgba(0,0,0,0.28);
      min-height: 520px;
      display: flex;
      flex-direction: column;
    }

    .call-shell-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.95rem 1.1rem;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      color: #f2f5f3;
      background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.01));
    }
    .call-shell-title {
      font-weight: 700;
      font-size: 0.95rem;
    }
    .call-shell-subtitle {
      font-size: 0.78rem;
      color: rgba(255,255,255,0.72);
      margin-top: 0.15rem;
    }
    .call-shell-actions {
      display: flex;
      align-items: center;
      gap: 0.55rem;
    }
    .call-shell-btn {
      height: 38px;
      border-radius: var(--radius-full);
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.08);
      color: #fff;
      padding: 0 0.95rem;
      font-family: var(--font-sans);
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.2s, background 0.2s;
    }
    .call-shell-btn:hover {
      transform: translateY(-1px);
      background: rgba(255,255,255,0.14);
    }
    .call-shell-btn.danger {
      background: rgba(220, 38, 38, 0.2);
      border-color: rgba(220, 38, 38, 0.45);
    }
    .call-shell-btn.danger:hover {
      background: rgba(220, 38, 38, 0.3);
    }
    .call-embed-frame {
      width: 100%;
      height: 100%;
      min-height: 540px;
      border: 0;
      background: #111;
      display: block;
    }

    /* Incoming call banner */
    .incoming-call-banner {
      display: none;
      align-items: center;
      gap: 1rem;
      padding: 0.85rem 1.25rem;
      background: var(--card-bg);
      border-bottom: 1px solid var(--card-border);
      animation: slideDown 0.3s ease-out;
    }
    .incoming-call-banner.visible { display: flex; }
    .incoming-call-info {
      flex: 1;
      font-size: 0.9rem;
      font-weight: 500;
    }
    .incoming-call-info small {
      display: block;
      font-size: 0.75rem;
      color: var(--text-subtle);
      font-weight: 400;
    }
    .call-accept-btn, .call-reject-btn {
      width: 38px;
      height: 38px;
      border-radius: var(--radius-full);
      border: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s;
    }
    .call-accept-btn { background: var(--success); color: #fff; }
    .call-accept-btn:hover { opacity: 0.85; }
    .call-reject-btn { background: var(--danger); color: #fff; }
    .call-reject-btn:hover { opacity: 0.85; }

    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ==================================================
       Messages Area
       ================================================== */
    #messages {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      background: var(--msg-area-bg);
      transition: background-color 0.4s ease;
    }

    .msg-bubble {
      max-width: 65%;
      padding: 0.7rem 1rem;
      border-radius: var(--radius-lg);
      font-size: 0.9rem;
      line-height: 1.5;
      position: relative;
      animation: msgIn 0.25s ease-out;
      word-break: break-word;
    }
    .msg-actions {
      position: absolute;
      top: 0.38rem;
      right: 0.38rem;
      display: flex;
      gap: 0.25rem;
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    .msg-bubble:hover .msg-actions {
      opacity: 1;
    }
    .msg-action-btn {
      width: 28px;
      height: 28px;
      border: none;
      border-radius: 999px;
      background: rgba(0,0,0,0.14);
      color: inherit;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(8px);
    }
    .msg-bubble.received .msg-action-btn {
      background: rgba(0,0,0,0.06);
    }
    .msg-action-btn .material-symbols-outlined {
      font-size: 16px;
    }
    .msg-action-btn.copied {
      background: rgba(22, 163, 74, 0.22);
    }

    @keyframes msgIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .msg-bubble.sent {
      align-self: flex-end;
      background: var(--sent-bg);
      color: var(--sent-text);
      border-bottom-right-radius: var(--radius-sm);
    }
    .msg-bubble.received {
      align-self: flex-start;
      background: var(--received-bg);
      color: var(--received-text);
      border: 1px solid var(--card-border);
      border-bottom-left-radius: var(--radius-sm);
    }
    .msg-bubble.pending {
      opacity: 0.78;
    }
    .msg-bubble.pending::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      border: 1px dashed rgba(255,255,255,0.2);
      pointer-events: none;
    }
    .msg-bubble.received.pending::after {
      border-color: rgba(0,0,0,0.12);
    }

    .msg-sender {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      margin-bottom: 0.2rem;
      opacity: 0.7;
    }

    .msg-text { white-space: pre-wrap; }

    .msg-time {
      display: inline-flex;
      align-items: center;
      gap: 0.22rem;
      font-size: 0.65rem;
      margin-top: 0.35rem;
      opacity: 0.5;
      justify-content: flex-end;
      width: 100%;
    }
    .msg-status {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: 0.9;
    }
    .msg-status .material-symbols-outlined {
      font-size: 14px;
      line-height: 1;
    }
    .msg-status.pending {
      gap: 0.32rem;
      opacity: 1;
    }
    .msg-status.pending .material-symbols-outlined {
      animation: pendingPulse 1s linear infinite;
    }
    .msg-status-text {
      display: inline-flex;
      align-items: center;
      gap: 0.28rem;
      font-size: 0.64rem;
      font-weight: 700;
      opacity: 0.92;
    }
    .msg-status-text.failed {
      color: #fecaca;
    }
    .msg-bubble.received .msg-status-text.failed {
      color: var(--danger);
    }
    .msg-status-label {
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }
    @keyframes pendingPulse {
      0% { opacity: 0.4; }
      50% { opacity: 1; }
      100% { opacity: 0.4; }
    }
    .spin {
      animation: spinTurn 0.95s linear infinite;
    }
    @keyframes spinTurn {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .msg-media-card {
      margin-top: 0.55rem;
      border-radius: 1.35rem;
      overflow: hidden;
      background: transparent;
      border: none;
      min-width: 260px;
      max-width: min(470px, 76vw);
      box-shadow: none;
    }
    .msg-media {
      width: 100%;
      max-width: 100%;
      display: block;
      background: #0f1110;
    }
    .msg-media.img,
    .msg-media.vid {
      max-height: 340px;
      object-fit: cover;
    }
    .msg-media.img { cursor: pointer; }
    .msg-media-frame {
      position: relative;
      background:
        radial-gradient(circle at top left, rgba(255,255,255,0.12), transparent 28%),
        linear-gradient(180deg, rgba(255,255,255,0.04), rgba(0,0,0,0.18));
      padding: 0.32rem;
      border-radius: 0.95rem;
    }
    .msg-media-frame .msg-media.vid {
      border-radius: 0.95rem;
      overflow: hidden;
      box-shadow: 0 12px 26px rgba(0,0,0,0.22);
      border: 1px solid rgba(255,255,255,0.08);
    }
    .msg-video-badge {
      position: absolute;
      top: 1.45rem;
      left: 1.45rem;
      z-index: 1;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.42rem 0.7rem;
      border-radius: var(--radius-full);
      background: rgba(8, 10, 9, 0.6);
      color: #fff;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      backdrop-filter: blur(10px);
    }
    .msg-audio-player {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      padding: 0.95rem;
      min-width: 280px;
      background:
        radial-gradient(circle at top left, rgba(255,255,255,0.16), transparent 34%),
        linear-gradient(135deg, rgba(255,255,255,0.08), rgba(0,0,0,0.12));
      border-radius: 1rem;
    }
    .msg-video-shell {
      display: flex;
      flex-direction: column;
      gap: 0.42rem;
      border-radius: 1rem;
      overflow: hidden;
      background:
        radial-gradient(circle at top left, rgba(255,255,255,0.16), transparent 34%),
        linear-gradient(135deg, rgba(255,255,255,0.08), rgba(0,0,0,0.12));
      padding: 0.24rem;
    }
    .msg-video-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.8rem;
      padding: 0.25rem 0.2rem 0.15rem;
    }
    .msg-video-title-wrap {
      min-width: 0;
      flex: 1;
    }
    .msg-video-title {
      font-size: 0.92rem;
      font-weight: 700;
      line-height: 1.35;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .msg-video-subtitle {
      font-size: 0.7rem;
      opacity: 0.72;
      margin-top: 0.16rem;
    }
    .msg-file-card {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding: 0.85rem;
      border-radius: 1rem;
      background:
        radial-gradient(circle at top left, rgba(255,255,255,0.14), transparent 30%),
        linear-gradient(135deg, rgba(255,255,255,0.08), rgba(0,0,0,0.1));
    }
    .msg-image-shell {
      border-radius: 1rem;
      overflow: hidden;
      background:
        radial-gradient(circle at top left, rgba(255,255,255,0.16), transparent 34%),
        linear-gradient(135deg, rgba(255,255,255,0.08), rgba(0,0,0,0.12));
      padding: 0.24rem;
    }
    .msg-image-shell .msg-media.img {
      border-radius: 0.92rem;
      display: block;
      width: 100%;
    }
    .msg-file-icon {
      width: 44px;
      height: 44px;
      border-radius: 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(255,255,255,0.14);
      flex-shrink: 0;
    }
    .msg-bubble.received .msg-file-icon {
      background: rgba(0,0,0,0.06);
    }
    .msg-file-info {
      min-width: 0;
      flex: 1;
    }
    .msg-file-title {
      font-size: 0.9rem;
      font-weight: 700;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .msg-file-subtitle {
      font-size: 0.72rem;
      opacity: 0.74;
      margin-top: 0.14rem;
    }
    .msg-file-link {
      text-decoration: none;
      color: inherit;
    }
    .msg-file-open {
      width: 36px;
      height: 36px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(255,255,255,0.16);
      color: inherit;
      flex-shrink: 0;
    }
    .msg-bubble.received .msg-file-open {
      background: rgba(0,0,0,0.07);
    }
    .image-lightbox {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 120;
      background: rgba(6, 8, 7, 0.88);
      backdrop-filter: blur(10px);
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }
    .image-lightbox.visible {
      display: flex;
    }
    .image-lightbox-content {
      max-width: min(92vw, 1100px);
      max-height: 92vh;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }
    .image-lightbox-img {
      max-width: 100%;
      max-height: calc(92vh - 70px);
      object-fit: contain;
      border-radius: 1rem;
      box-shadow: 0 24px 60px rgba(0,0,0,0.35);
    }
    .image-lightbox-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      color: #fff;
    }
    .image-lightbox-name {
      font-size: 0.95rem;
      font-weight: 700;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .msg-audio-top {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .msg-audio-icon {
      width: 44px;
      height: 44px;
      border-radius: 14px;
      background: rgba(255,255,255,0.14);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      flex-shrink: 0;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
    }
    .msg-bubble.received .msg-audio-icon {
      color: var(--text-main);
      background: rgba(0,0,0,0.06);
    }
    .msg-audio-info {
      min-width: 0;
      flex: 1;
    }
    .msg-audio-title {
      font-size: 0.84rem;
      font-weight: 700;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .msg-audio-subtitle {
      font-size: 0.68rem;
      opacity: 0.72;
      margin-top: 0.16rem;
    }
    .msg-audio-controls {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .msg-audio-btn {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: none;
      background: rgba(255,255,255,0.16);
      color: inherit;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: transform 0.2s, background 0.2s;
    }
    .msg-audio-btn:hover {
      transform: scale(1.04);
      background: rgba(255,255,255,0.24);
    }
    .msg-bubble.received .msg-audio-btn {
      background: rgba(0,0,0,0.07);
    }
    .msg-audio-btn .material-symbols-outlined {
      font-size: 18px;
    }
    .msg-audio-seek {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 5px;
      border-radius: 999px;
      background: rgba(255,255,255,0.18);
      outline: none;
      cursor: pointer;
    }
    .msg-bubble.received .msg-audio-seek {
      background: rgba(0,0,0,0.1);
    }
    .msg-audio-seek::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 13px;
      height: 13px;
      border-radius: 50%;
      background: currentColor;
      border: none;
      box-shadow: 0 0 0 3px rgba(255,255,255,0.12);
    }
    .msg-audio-progress {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }
    .msg-audio-time {
      font-size: 0.7rem;
      font-variant-numeric: tabular-nums;
      opacity: 0.82;
      min-width: 38px;
      text-align: right;
    }
    .msg-media-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.9rem 0.2rem 0.15rem;
      font-size: 0.72rem;
      color: rgba(255,255,255,0.82);
    }
    .msg-bubble.received .msg-media-meta {
      color: var(--text-muted);
    }
    .msg-media-name {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-weight: 600;
      font-size: 0.92rem;
      line-height: 1.35;
      flex: 1;
    }
    .msg-media-time {
      font-size: 0.78rem;
      font-weight: 600;
      opacity: 0.82;
      min-width: 38px;
      text-align: right;
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
    }

    .system-msg {
      align-self: center;
      font-size: 0.72rem;
      color: var(--text-subtle);
      background: var(--divider);
      padding: 0.25rem 0.85rem;
      border-radius: var(--radius-full);
      margin: 0.5rem 0;
      font-weight: 500;
    }

    .empty-state {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      color: var(--text-subtle);
      text-align: center;
      padding: 2rem;
    }
    .empty-state .material-symbols-outlined { font-size: 48px; opacity: 0.4; }
    .empty-state h3 {
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--text-muted);
    }
    .empty-state p { font-size: 0.88rem; font-style: italic; font-family: var(--font-display); }

    /* ==================================================
       File Preview Strip
       ================================================== */
    #file-preview {
      display: none;
      padding: 0.6rem 1.25rem;
      border-top: 1px solid var(--card-border);
      background: var(--card-bg);
      align-items: center;
      gap: 0.75rem;
      position: sticky;
      bottom: calc(64px + env(safe-area-inset-bottom, 0px));
      z-index: 3;
    }
    #file-preview.visible { display: flex; }

    .file-preview-thumb {
      width: 48px;
      height: 48px;
      border-radius: var(--radius-md);
      background: var(--stone-200);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
    }
    .file-preview-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .file-preview-thumb .material-symbols-outlined { font-size: 24px; color: var(--text-subtle); }

    .file-preview-info {
      flex: 1;
      min-width: 0;
    }
    .file-preview-name {
      font-size: 0.82rem;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .file-preview-size {
      font-size: 0.72rem;
      color: var(--text-subtle);
    }
    .file-preview-size.is-processing {
      color: var(--primary);
      font-weight: 600;
    }
    .file-preview-remove {
      width: 30px;
      height: 30px;
      border-radius: var(--radius-full);
      border: none;
      background: transparent;
      color: var(--text-subtle);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }
    .file-preview-remove:hover { background: var(--divider); color: var(--danger); }

    /* ==================================================
       Input Bar
       ================================================== */
    .input-bar {
      padding: 0.85rem 1.25rem;
      background: var(--card-bg);
      border-top: 1px solid var(--card-border);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.4s ease;
      flex-shrink: 0;
      position: sticky;
      bottom: 0;
      z-index: 4;
      padding-bottom: calc(0.85rem + env(safe-area-inset-bottom, 0px));
    }

    .input-attach-btn {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-full);
      border: none;
      background: transparent;
      color: var(--text-muted);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      transition: all 0.2s;
      flex-shrink: 0;
    }
    .input-attach-btn:hover { background: var(--primary-soft); color: var(--primary); }
    .input-attach-btn input[type="file"] {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
    }

    #msgInput {
      flex: 1;
      padding: 0.65rem 1rem;
      border: 1px solid var(--card-border);
      border-radius: var(--radius-full);
      background: var(--input-bg);
      color: var(--text-main);
      font-family: var(--font-sans);
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    #msgInput::placeholder { color: var(--text-subtle); }
    #msgInput:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-soft);
    }

    .input-send-btn {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-full);
      border: none;
      background: var(--primary);
      color: var(--sent-text);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
      flex-shrink: 0;
    }
    .input-send-btn:hover { opacity: 0.85; transform: scale(1.05); }
    .input-send-btn .material-symbols-outlined { font-size: 20px; }
    .input-send-btn.is-busy {
      opacity: 0.9;
      transform: none;
      cursor: wait;
    }
    .input-send-btn.is-busy .material-symbols-outlined {
      animation: pendingPulse 1s linear infinite;
    }
    .input-send-btn:disabled,
    #msgInput:disabled {
      cursor: not-allowed;
      opacity: 0.72;
    }
    .input-attach-btn.is-disabled {
      cursor: not-allowed;
      opacity: 0.62;
    }
    .input-attach-btn.is-disabled input[type="file"] {
      pointer-events: none;
    }

    /* ==================================================
       Create Group Modal
       ================================================== */
    .modal-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: var(--overlay-bg);
      z-index: 100;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(4px);
    }
    .modal-backdrop.visible { display: flex; }

    .modal-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      width: 380px;
      max-width: 92vw;
      padding: 1.75rem;
      box-shadow: 0 20px 50px rgba(0,0,0,0.2);
      animation: modalIn 0.25s ease-out;
    }
    @keyframes modalIn {
      from { opacity: 0; transform: scale(0.95) translateY(10px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .modal-title {
      font-family: var(--font-display);
      font-size: 1.3rem;
      font-weight: 600;
      margin-bottom: 0.25rem;
    }
    .modal-desc {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 1.25rem;
      font-style: italic;
      font-family: var(--font-display);
    }

    .modal-input {
      width: 100%;
      padding: 0.65rem 1rem;
      border: 1px solid var(--card-border);
      border-radius: var(--radius-md);
      background: var(--input-bg);
      color: var(--text-main);
      font-family: var(--font-sans);
      font-size: 0.9rem;
      outline: none;
      margin-bottom: 1rem;
      transition: border-color 0.2s;
    }
    .modal-input:focus { border-color: var(--primary); }

    .modal-actions.danger {
      justify-content: flex-end;
    }

    .modal-user-list {
      max-height: 200px;
      overflow-y: auto;
      margin-bottom: 1.25rem;
    }

    .modal-user-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 0.25rem;
      cursor: pointer;
      border-radius: var(--radius-md);
      transition: background 0.15s;
    }
    .modal-user-item:hover { background: var(--primary-soft); }

    .modal-user-check {
      width: 18px;
      height: 18px;
      border-radius: 4px;
      border: 2px solid var(--card-border);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all 0.15s;
    }
    .modal-user-item.selected .modal-user-check {
      background: var(--primary);
      border-color: var(--primary);
    }
    .modal-user-check .material-symbols-outlined {
      font-size: 14px;
      color: #fff;
      display: none;
    }
    .modal-user-item.selected .modal-user-check .material-symbols-outlined { display: block; }

    .modal-user-name { font-size: 0.88rem; font-weight: 500; }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.6rem;
    }

    .btn-modal-cancel {
      padding: 0.55rem 1rem;
      border: none;
      border-radius: var(--radius-md);
      background: transparent;
      color: var(--text-subtle);
      font-family: var(--font-sans);
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      transition: color 0.2s;
    }
    .btn-modal-cancel:hover { color: var(--text-main); }

    .btn-modal-create {
      padding: 0.55rem 1.25rem;
      border: none;
      border-radius: var(--radius-md);
      background: var(--primary);
      font-family: var(--font-sans);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    html[data-theme="light"] .btn-modal-create,
    html[data-theme="sepia"] .btn-modal-create { color: #fff; }
    html[data-theme="dark"] .btn-modal-create { color: #1c1917; }
    html[data-theme="forest"] .btn-modal-create { color: #1a211e; }
    .btn-modal-create:hover { opacity: 0.85; }

    /* ==================================================
       Responsive
       ================================================== */
    @media (max-width: 768px) {
      #sidebar {
        position: fixed;
        left: -100%;
        top: 0;
        width: min(100vw, 360px);
        min-width: min(100vw, 360px);
        height: 100dvh;
        z-index: 50;
        box-shadow: 4px 0 20px rgba(0,0,0,0.15);
        transition: left 0.3s ease;
      }
      #sidebar.open { left: 0; }

      .mobile-menu-btn { display: inline-flex; }
      .mobile-sidebar-close { display: inline-flex; }

      .sidebar-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.3);
        z-index: 40;
      }
      .sidebar-overlay.visible { display: block; }

      .chat-header {
        padding: 0 0.85rem;
        gap: 0.75rem;
      }
      .chat-header-right {
        gap: 0.35rem;
      }
      .header-action-btn {
        width: 38px;
        height: 38px;
      }
      .mobile-menu-btn {
        width: 40px;
        height: 40px;
        border-radius: 0.8rem;
        background: rgba(255,255,255,0.04);
      }
      #messages {
        padding: 1rem 0.75rem;
        gap: 0.7rem;
      }
      .msg-bubble {
        max-width: 90%;
        padding: 0.65rem 0.85rem;
      }
      .msg-actions {
        opacity: 1;
        position: static;
        justify-content: flex-end;
        margin-bottom: 0.35rem;
      }
      .msg-action-btn {
        width: 34px;
        height: 34px;
      }
      .msg-media-card {
        min-width: 0;
        max-width: 100%;
      }
      .msg-audio-player,
      .msg-file-card {
        min-width: 0;
      }
      .msg-audio-top,
      .msg-file-card,
      .msg-video-footer,
      .msg-media-meta,
      .call-shell-header,
      .call-shell-actions,
      .input-bar {
        flex-wrap: wrap;
      }
      .msg-audio-controls {
        margin-left: auto;
      }
      .msg-audio-progress {
        width: 100%;
      }
      .msg-audio-time {
        min-width: 44px;
      }
      .msg-file-open {
        width: 32px;
        height: 32px;
      }
      .call-shell {
        margin: 0.65rem;
        min-height: 440px;
      }
      .call-shell-header {
        padding: 0.8rem 0.85rem;
      }
      .call-shell-btn {
        flex: 1 1 0;
        min-width: 0;
        height: 36px;
        padding: 0 0.75rem;
      }
      .call-embed-frame {
        min-height: 450px;
      }
      .input-bar {
        padding: 0.65rem 0.75rem;
        gap: 0.55rem;
        padding-bottom: calc(0.8rem + env(safe-area-inset-bottom, 0px));
      }
      .input-attach-btn,
      .input-send-btn {
        flex-shrink: 0;
      }
      #file-preview {
        padding: 0.55rem 0.75rem;
        bottom: calc(72px + env(safe-area-inset-bottom, 0px));
      }
      #msgInput {
        min-width: 0;
        flex: 1 1 140px;
      }
      .modal-card {
        width: min(92vw, 380px);
        padding: 1.1rem;
      }
      .modal-actions {
        flex-wrap: wrap;
      }
      .btn-modal-cancel,
      .btn-modal-create,
      .call-shell-btn {
        width: 100%;
        justify-content: center;
      }
      .image-lightbox {
        padding: 1rem;
      }
      .image-lightbox-bar {
        flex-wrap: wrap;
      }
    }

    @media (max-width: 520px) {
      #sidebar {
        width: 100vw;
        min-width: 100vw;
      }
      .sidebar-header,
      .sidebar-actions {
        padding-left: 0.9rem;
        padding-right: 0.9rem;
      }
      .sidebar-header {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 0.5rem;
      }
      .sidebar-back,
      .sidebar-title,
      .sidebar-subtitle {
        width: 100%;
      }
      .chat-header-avatar {
        width: 34px;
        height: 34px;
      }
      .chat-header-name {
        font-size: 1rem;
      }
      .chat-header-status {
        display: none;
      }
      .msg-bubble {
        max-width: 96%;
        padding: 0.62rem 0.78rem;
      }
      .msg-media-card {
        border-radius: 1.05rem;
      }
      .msg-video-shell,
      .msg-image-shell,
      .msg-audio-player,
      .msg-file-card {
        border-radius: 0.85rem;
      }
      .msg-video-title,
      .msg-media-name,
      .msg-file-title,
      .msg-audio-title {
        font-size: 0.85rem;
      }
      .msg-video-subtitle,
      .msg-file-subtitle,
      .msg-audio-subtitle {
        font-size: 0.64rem;
      }
      .msg-media-time,
      .msg-audio-time {
        font-size: 0.68rem;
      }
      .msg-video-badge {
        top: 0.7rem;
        left: 0.7rem;
        font-size: 0.72rem;
      }
      .msg-action-btn {
        width: 30px;
        height: 30px;
      }
      .input-bar {
        padding: 0.6rem;
        padding-bottom: calc(0.72rem + env(safe-area-inset-bottom, 0px));
      }
      #file-preview {
        bottom: calc(70px + env(safe-area-inset-bottom, 0px));
      }
      .call-shell {
        margin: 0.5rem;
        min-height: 380px;
      }
      .call-embed-frame {
        min-height: 390px;
      }
    }

    /* Switch Slider */
    .slider:before {
      position: absolute;
      content: "";
      height: 18px;
      width: 18px;
      left: 3px;
      bottom: 3px;
      background-color: white;
      transition: .4s;
      border-radius: 50%;
    }
    input:checked + .slider { background-color: var(--primary); }
    input:checked + .slider:before { transform: translateX(20px); }
  </style>
</head>
<body>

  <!-- Sidebar Overlay (mobile) -->
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

  <div id="chat-app">
    <!-- ===== SIDEBAR ===== -->
    <aside id="sidebar">
      <div class="sidebar-header">
        <button class="mobile-sidebar-close" onclick="closeSidebar()" aria-label="Back to chat">
          <span class="material-symbols-outlined">arrow_back</span>
        </button>
        <a href="/campfire" class="sidebar-back">
          <span class="material-symbols-outlined">arrow_back</span>
          Back to Campfire
        </a>
        <h2 class="sidebar-title">Conversations</h2>
        <p class="sidebar-subtitle">Speak freely, stay present.</p>
      </div>
      <div class="sidebar-actions">
        <button class="btn-new-chat" onclick="openGroupModal()">
          <span class="material-symbols-outlined">group_add</span>
          New Group
        </button>
        <button class="btn-new-chat" onclick="openJoinCodeModal()">
          <span class="material-symbols-outlined">key</span>
          Join Code
        </button>
      </div>

      <div class="conversation-list" id="conversationList">
        <div class="sidebar-section-label">General</div>
        <button class="conv-item active" id="conv-all" onclick="setReceiver('all', 'Campfire', true)">
          <div class="conv-avatar group-avatar">
            <span class="material-symbols-outlined">local_fire_department</span>
          </div>
          <div class="conv-info">
            <span class="conv-name">Campfire</span>
            <span class="conv-preview">Global broadcast</span>
          </div>
        </button>

        <div class="sidebar-section-label">My Groups</div>
        {{range .UserGroups}}
        <button class="conv-item" data-groupid="{{.ID}}" onclick="setReceiver('group_{{.ID}}', '{{.Name}}', true, {{.IsPrivate}})">
          <div class="conv-avatar">{{slice .Name 0 1}}</div>
          <div class="conv-info">
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <span class="conv-name">{{.Name}}</span>
              {{if .IsPrivate}}
              <span class="badge badge-private">Private</span>
              {{else}}
              <span class="badge badge-public">Public</span>
              {{end}}
            </div>
            <span class="conv-preview">Click to chat</span>
          </div>
        </button>
        {{end}}

        <div class="sidebar-section-label">Public Groups</div>
        {{range .PublicGroups}}
        <div class="conv-item" style="cursor: default;">
          <div class="conv-avatar">{{slice .Name 0 1}}</div>
          <div class="conv-info">
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <span class="conv-name">{{.Name}}</span>
              <button class="btn-join" onclick="joinGroup('{{.ID}}')">Join</button>
            </div>
            <span class="conv-preview">Public conversation</span>
          </div>
        </div>
        {{end}}

        <div class="sidebar-section-label">People</div>
        {{range .SuggestedUsers}}
        <button class="conv-item" data-userid="{{.ID}}" onclick="setReceiver('{{.ID}}', '{{.Name}}', false)">
          <div class="conv-avatar">{{slice .Name 0 1}}</div>
          <div class="conv-info">
            <span class="conv-name">{{.Name}}</span>
            <span class="conv-preview">Start a conversation</span>
          </div>
        </button>
        {{end}}
      </div>

    </aside>

    <!-- ===== MAIN PANEL ===== -->
    <main id="main-panel">
      <!-- Chat Header -->
      <header class="chat-header">
        <div class="chat-header-left">
          <button class="mobile-menu-btn" onclick="toggleSidebar()">
            <span class="material-symbols-outlined">menu</span>
          </button>
          <div class="chat-header-avatar is-group" id="chatAvatar">
            <span class="material-symbols-outlined">local_fire_department</span>
          </div>
          <div class="chat-header-info">
            <div class="chat-header-name" id="chatName">Campfire</div>
            <div class="chat-header-status" id="chatStatus">Group · Everyone welcome</div>
          </div>
        </div>
        <div class="chat-header-right">
          <button class="header-action-btn" onclick="startCall(false)" title="Audio Call" id="btnAudioCall">
            <span class="material-symbols-outlined">call</span>
          </button>
          <button class="header-action-btn" onclick="startCall(true)" title="Video Call" id="btnVideoCall">
            <span class="material-symbols-outlined">videocam</span>
          </button>
        </div>
      </header>

      <!-- Incoming Call Banner -->
      <div class="incoming-call-banner" id="incomingCallBanner">
        <span class="material-symbols-outlined" style="color: var(--success); font-size: 28px;">ring_volume</span>
        <div class="incoming-call-info">
          <span id="callerName">Someone</span> is calling...
          <small id="callType">Audio call</small>
        </div>
        <button class="call-accept-btn" onclick="acceptCall()">
          <span class="material-symbols-outlined" style="font-size: 20px;">call</span>
        </button>
        <button class="call-reject-btn" onclick="rejectCall()">
          <span class="material-symbols-outlined" style="font-size: 20px;">call_end</span>
        </button>
      </div>

      <!-- Call / Video Area -->
      <div id="call-area">
        <div class="call-shell">
          <div class="call-shell-header">
            <div>
              <div class="call-shell-title" id="embeddedCallTitle">Call</div>
              <div class="call-shell-subtitle" id="embeddedCallSubtitle">Join the ongoing room without leaving chat.</div>
            </div>
            <div class="call-shell-actions">
              <button class="call-shell-btn" onclick="reloadEmbeddedCall()">Refresh</button>
              <button class="call-shell-btn danger" onclick="endCall()">Close</button>
            </div>
          </div>
          <iframe id="callEmbedFrame" class="call-embed-frame" title="Embedded call"></iframe>
        </div>
      </div>

      <!-- Messages -->
      <div id="messages">
        <div class="empty-state" id="emptyState">
          <span class="material-symbols-outlined">forum</span>
          <h3>No messages yet</h3>
          <p>Say something. This space is yours.</p>
        </div>
      </div>

      <!-- File Preview -->
      <div id="file-preview">
        <div class="file-preview-thumb" id="fileThumb">
          <span class="material-symbols-outlined">description</span>
        </div>
        <div class="file-preview-info">
          <div class="file-preview-name" id="fileName">file.png</div>
          <div class="file-preview-size" id="fileSize">2.3 MB</div>
        </div>
        <button class="file-preview-remove" onclick="clearFilePreview()">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <!-- Input Bar -->
      <div class="input-bar">
        <label class="input-attach-btn" title="Attach file">
          <span class="material-symbols-outlined">attach_file</span>
          <input type="file" id="fileInput" accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.txt" onchange="handleFileSelect(event)">
        </label>
        <input type="text" id="msgInput" placeholder="Write a message...">
        <button class="input-send-btn" onclick="sendMessage()" title="Send">
          <span class="material-symbols-outlined">send</span>
        </button>
      </div>
    </main>
  </div>

  <!-- Create Group Modal -->
  <div class="modal-backdrop" id="groupModal">
    <div class="modal-card">
      <h3 class="modal-title">Create a Group</h3>
      <p class="modal-desc">Gather people for a shared conversation.</p>
      <input type="text" class="modal-input" id="groupNameInput" placeholder="Group name">
      
      <div style="margin-bottom: 1rem; display: flex; align-items: center; gap: 0.75rem;">
        <label class="switch" style="position: relative; display: inline-block; width: 44px; height: 24px;">
          <input type="checkbox" id="groupPrivateToggle" style="opacity: 0; width: 0; height: 0;">
          <span class="slider" style="position: absolute; cursor: pointer; inset: 0; background: var(--divider); border-radius: 24px; transition: .4s;"></span>
        </label>
        <span style="font-size: 0.88rem; font-weight: 500;">Private Group</span>
      </div>
      <p id="privateNote" style="display: none; font-size: 0.75rem; color: var(--text-subtle); margin-bottom: 1rem; font-style: italic;">
        Private groups require a 6-digit code to join.
      </p>

      <div class="modal-actions">
        <button class="btn-modal-cancel" onclick="closeGroupModal()">Cancel</button>
        <button class="btn-modal-create" onclick="createNewGroup()">Create</button>
      </div>
    </div>
  </div>

  <!-- Join Code Modal -->
  <div class="modal-backdrop" id="joinCodeModal">
    <div class="modal-card">
      <h3 class="modal-title">Join with Code</h3>
      <p class="modal-desc">Enter the 6-digit invite code.</p>
      <input type="text" class="modal-input" id="joinCodeInput" placeholder="Invite code (e.g. ABCDEF)" maxlength="6" style="text-transform: uppercase; text-align: center; font-size: 1.25rem; letter-spacing: 0.2em;">
      <div class="modal-actions">
        <button class="btn-modal-cancel" onclick="closeJoinCodeModal()">Cancel</button>
        <button class="btn-modal-create" onclick="joinByCode()">Join Group</button>
      </div>
    </div>
  </div>

  <div class="modal-backdrop" id="confirmModal">
    <div class="modal-card">
      <h3 class="modal-title" id="confirmTitle">Confirm action</h3>
      <p class="modal-desc" id="confirmMessage">Are you sure?</p>
      <div class="modal-actions danger">
        <button class="btn-modal-cancel" id="confirmCancelBtn">Cancel</button>
        <button class="btn-modal-create" id="confirmOkBtn">Continue</button>
      </div>
    </div>
  </div>

  <div class="modal-backdrop" id="shareModal">
    <div class="modal-card">
      <h3 class="modal-title">Share</h3>
      <p class="modal-desc" id="shareModalDesc">Choose how you want to share this message.</p>
      <div class="modal-actions" style="justify-content: stretch; gap: 0.75rem; flex-wrap: wrap;">
        <button class="btn-modal-create" id="shareCopyBtn" style="flex: 1; min-width: 140px;">Copy</button>
        <button class="btn-modal-cancel" id="shareOpenBtn" style="flex: 1; min-width: 140px;">Open</button>
        <button class="btn-modal-cancel" id="shareEmailBtn" style="flex: 1; min-width: 140px;">Email</button>
      </div>
      <div class="modal-actions" style="margin-top: 0.75rem;">
        <button class="btn-modal-cancel" id="shareCancelBtn">Close</button>
      </div>
    </div>
  </div>

  <div class="image-lightbox" id="imageLightbox">
    <div class="image-lightbox-content">
      <img id="imageLightboxImg" class="image-lightbox-img" alt="Expanded preview">
      <div class="image-lightbox-bar">
        <div id="imageLightboxName" class="image-lightbox-name">Image</div>
        <button class="call-shell-btn danger" onclick="closeImageLightbox()">Close</button>
      </div>
    </div>
  </div>

  <!-- Group Info Side Panel -->
  <div id="groupInfoPanel" style="position: fixed; right: -320px; top: 0; bottom: 0; width: 320px; background: var(--bg-sidebar); border-left: 1px solid var(--card-border); z-index: 60; transition: right 0.3s ease; display: flex; flex-direction: column;">
    <div style="padding: 1.5rem; border-bottom: 1px solid var(--card-border); display: flex; align-items: center; justify-content: space-between;">
      <h3 class="modal-title" style="margin: 0;">Group Info</h3>
      <button class="file-preview-remove" onclick="closeGroupInfo()">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    <div style="flex: 1; overflow-y: auto; padding: 1.5rem;">
      <div style="text-align: center; margin-bottom: 1.5rem;">
        <div class="chat-header-avatar is-group" style="width: 64px; height: 64px; margin: 0 auto 1rem;">
          <span class="material-symbols-outlined" style="font-size: 32px;">group</span>
        </div>
        <h4 id="infoGroupName" style="font-family: var(--font-display); font-size: 1.25rem;">Group Name</h4>
        <span id="infoGroupBadge" class="badge">Public</span>
      </div>

      <div id="adminControls" style="display: none; margin-bottom: 1.5rem; padding: 1rem; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: var(--radius-md);">
        <h5 style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-subtle); margin-bottom: 0.75rem;">Admin Controls</h5>
        <div id="inviteCodeDisplay" style="margin-bottom: 1rem; display: none;">
          <p style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.4rem;">Invite Code:</p>
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <code id="infoInviteCode" style="font-size: 1.1rem; font-weight: 700; color: var(--primary); background: var(--primary-soft); padding: 0.2rem 0.6rem; border-radius: 4px; letter-spacing: 0.1em;">ABCDEF</code>
            <button class="btn-join" onclick="regenerateCode()">New</button>
          </div>
        </div>
        <button class="btn-modal-cancel" style="width: 100%; text-align: left; padding: 0.5rem 0;" onclick="deleteGroup()">
          <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: middle; margin-right: 0.4rem; color: var(--danger);">delete</span>
          Delete Group
        </button>
      </div>

      <div id="memberControls" style="margin-bottom: 1.5rem;">
        <button class="btn-modal-cancel" style="width: 100%; text-align: left; padding: 0.5rem 0;" onclick="leaveGroup()">
          <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: middle; margin-right: 0.4rem;">logout</span>
          Leave Group
        </button>
      </div>

      <h5 class="sidebar-section-label" style="padding: 0; margin-bottom: 0.75rem;">Members</h5>
      <div id="groupMemberList" style="display: flex; flex-direction: column; gap: 0.5rem;">
        <!-- Members injected here -->
      </div>
    </div>
  </div>

  <!-- ===== SCRIPTS ===== -->
  <script>
    // ── Theme Loader ──
    (function() {
      const storageKey = 'remainwith-theme';
      function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
      }
      const saved = getCookie(storageKey);
      if (saved) document.documentElement.setAttribute('data-theme', saved);
    })();

    // ── State ──
    const currentUserID = {{.UserID}};
    let receiverID = 'all';
    let isGroupChat = true;
    let activeChatName = 'Campfire';
    let activeGroupPrivate = false;
    let selectedFile = null;
    let localStream = null;
    let peerConnection = null;
    let micEnabled = true;
    let camEnabled = true;
    let inCall = false;
    let pendingSignal = null;
    const conversationMessages = {};
    const conversationHistoryLoaded = {};
    let confirmResolver = null;
    let selectedFileQuality = '';
    let mediaPlayerCounter = 0;
    let currentSharePayload = null;
    let pendingMessageCounter = 0;
    let composerBusy = false;
    let historyRequestController = null;

    const rtcConfig = { iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] };

    // Group state
    let activeGroupInfo = null;
    const groupPrivateToggle = document.getElementById('groupPrivateToggle');
    const privateNote = document.getElementById('privateNote');
    if (groupPrivateToggle) {
      groupPrivateToggle.onchange = (e) => {
        privateNote.style.display = e.target.checked ? 'block' : 'none';
      };
    }

    // ── WebSocket ──
    const wsProtocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const socket = new WebSocket(wsProtocol + '//' + window.location.host + '/ws/chat');

    socket.onopen = () => console.log('WebSocket connected');
    socket.onerror = (e) => console.error('WebSocket error:', e);
    socket.onclose = () => {
      console.log('WebSocket closed');
      addSystemMessage('Connection lost. Please refresh.');
    };

    socket.onmessage = async (event) => {
      const msg = JSON.parse(event.data);

      // Handle user count updates from the hub
      if (msg.type === 'user_count_update') {
        return;
      }

      if (msg.type === 'signal') {
        await handleSignaling(msg);
      } else {
        if (!reconcilePendingMessage(msg)) {
          appendMessageToConversation(msg);
        }
      }
    };

    // ── Sidebar / Navigation ──
    function getConversationKey() {
      return receiverID;
    }

    function getConversationKeyForMessage(msg) {
      const msgReceiverID = msg.receiverID || msg.ReceiverID;
      const msgSenderID = msg.senderID || msg.SenderID;

      if (msgReceiverID === 'all') return 'all';
      if (typeof msgReceiverID === 'string' && msgReceiverID.startsWith('group_')) return msgReceiverID;
      if (String(msgSenderID) === String(currentUserID)) return String(msgReceiverID);
      return String(msgSenderID);
    }

    function renderEmptyState() {
      const container = document.getElementById('messages');
      container.innerHTML = `
        <div class="empty-state" id="emptyState">
          <span class="material-symbols-outlined">forum</span>
          <h3>No messages yet</h3>
          <p>Say something. This space is yours.</p>
        </div>
      `;
    }

    function renderLoadingState() {
      const container = document.getElementById('messages');
      container.innerHTML = `
        <div class="empty-state" id="emptyState">
          <span class="material-symbols-outlined spin">progress_activity</span>
          <h3>Loading conversation</h3>
          <p>Pulling the latest messages for this chat.</p>
        </div>
      `;
    }

    function setComposerBusy(isBusy, statusText = '') {
      composerBusy = isBusy;

      const sendBtn = document.querySelector('.input-send-btn');
      const attachBtn = document.querySelector('.input-attach-btn');
      const input = document.getElementById('msgInput');
      const icon = sendBtn?.querySelector('.material-symbols-outlined');
      const sizeEl = document.getElementById('fileSize');

      if (sendBtn) {
        sendBtn.disabled = isBusy;
        sendBtn.classList.toggle('is-busy', isBusy);
        sendBtn.title = isBusy ? (statusText || 'Working...') : 'Send';
      }
      if (attachBtn) attachBtn.classList.toggle('is-disabled', isBusy);
      if (input) input.disabled = isBusy;
      if (icon) icon.textContent = isBusy ? 'hourglass_top' : 'send';

      if (sizeEl && selectedFile) {
        sizeEl.textContent = statusText || (formatFileSize(selectedFile.size) + (selectedFileQuality ? ` · ${selectedFileQuality}` : ''));
        sizeEl.classList.toggle('is-processing', Boolean(statusText));
      }
    }

    function createPendingMessage({ type, content = '', mediaType = '', fileName = '', pendingLabel = 'Sending' }) {
      return {
        clientTempID: `pending-${Date.now()}-${++pendingMessageCounter}`,
        type,
        senderID: currentUserID,
        senderName: 'You',
        receiverID: receiverID,
        content,
        mediaType,
        fileName,
        createdAt: new Date().toISOString(),
        pendingLabel,
        pendingState: 'pending',
        isGroup: isGroupChat
      };
    }

    function updatePendingMessage(clientTempID, updates = {}) {
      Object.keys(conversationMessages).forEach((key) => {
        const messages = conversationMessages[key];
        if (!Array.isArray(messages)) return;
        const index = messages.findIndex((msg) => msg.clientTempID === clientTempID);
        if (index === -1) return;
        messages[index] = { ...messages[index], ...updates };
      });

      if (getConversationKey() && document.getElementById('messages')) {
        renderCurrentConversation();
      }
    }

    function samePayload(pendingMsg, incomingMsg) {
      const pendingType = pendingMsg.type || pendingMsg.Type || 'text';
      const incomingType = incomingMsg.type || incomingMsg.Type || 'text';
      const pendingMediaType = pendingMsg.mediaType || pendingMsg.MediaType || '';
      const incomingMediaType = incomingMsg.mediaType || incomingMsg.MediaType || '';
      const pendingContent = pendingMsg.content || pendingMsg.Content || '';
      const incomingContent = incomingMsg.content || incomingMsg.Content || incomingMsg.mediaURL || incomingMsg.MediaURL || '';
      const pendingFileName = pendingMsg.fileName || pendingMsg.FileName || '';
      const incomingFileName = incomingMsg.fileName || incomingMsg.FileName || '';

      if (pendingType !== incomingType) return false;
      if (pendingMediaType !== incomingMediaType) return false;
      if (pendingMsg.receiverID !== (incomingMsg.receiverID || incomingMsg.ReceiverID)) return false;

      if (pendingType === 'media' || pendingMediaType) {
        return pendingFileName === incomingFileName && pendingContent === incomingContent;
      }
      return pendingContent === incomingContent;
    }

    function reconcilePendingMessage(msg) {
      const key = getConversationKeyForMessage(msg);
      const messages = conversationMessages[key] || [];
      const index = messages.findIndex((item) => item.clientTempID && String(item.senderID || item.SenderID) === String(currentUserID) && samePayload(item, msg));
      if (index === -1) return false;

      messages[index] = msg;
      if (key === getConversationKey()) renderCurrentConversation();
      return true;
    }

    function renderCurrentConversation() {
      const container = document.getElementById('messages');
      const key = getConversationKey();
      const messages = conversationMessages[key] || [];

      container.innerHTML = '';
      if (!messages.length) {
        renderEmptyState();
        return;
      }

      messages.forEach((msg) => renderMessageBubble(msg));
    }

    async function loadConversationHistory(force = false) {
      const key = getConversationKey();
      if (!force && conversationHistoryLoaded[key]) {
        renderCurrentConversation();
        return;
      }

      if (!conversationMessages[key]?.length) {
        renderLoadingState();
      }

      if (historyRequestController) {
        historyRequestController.abort();
      }
      historyRequestController = new AbortController();

      const params = new URLSearchParams({ limit: '30' });
      if (receiverID === 'all') {
        params.set('receiver', 'all');
      } else if (receiverID.startsWith('group_')) {
        params.set('group', receiverID.replace('group_', ''));
      } else {
        params.set('receiver', receiverID);
      }

      try {
        const res = await fetch(`/api/chat/history?${params.toString()}`, {
          signal: historyRequestController.signal
        });
        if (!res.ok) throw new Error('Failed to load messages');

        const messages = await res.json();
        conversationMessages[key] = Array.isArray(messages) ? messages : [];
        conversationHistoryLoaded[key] = true;
        if (key === getConversationKey()) {
          renderCurrentConversation();
        }
      } catch (err) {
        if (err.name === 'AbortError') {
          return;
        }
        addSystemMessage(err.message || 'Failed to load messages.');
      } finally {
        if (historyRequestController && !historyRequestController.signal.aborted) {
          historyRequestController = null;
        }
      }
    }

    function openConfirmModal(title, message, confirmLabel = 'Continue') {
      const modal = document.getElementById('confirmModal');
      document.getElementById('confirmTitle').textContent = title;
      document.getElementById('confirmMessage').textContent = message;
      document.getElementById('confirmOkBtn').textContent = confirmLabel;
      modal.classList.add('visible');
    }

    function closeConfirmModal(result = false) {
      document.getElementById('confirmModal').classList.remove('visible');
      if (confirmResolver) {
        confirmResolver(result);
        confirmResolver = null;
      }
    }

    function confirmAction(title, message, confirmLabel = 'Continue') {
      openConfirmModal(title, message, confirmLabel);
      return new Promise((resolve) => {
        confirmResolver = resolve;
      });
    }

    function openImageLightbox(src, name = 'Image') {
      document.getElementById('imageLightboxImg').src = src;
      document.getElementById('imageLightboxName').textContent = name;
      document.getElementById('imageLightbox').classList.add('visible');
    }

    function closeImageLightbox() {
      const img = document.getElementById('imageLightboxImg');
      img.src = '';
      document.getElementById('imageLightbox').classList.remove('visible');
    }

    async function deleteMessage(messageID) {
      if (!messageID) return;
      if (!await confirmAction('Delete Message', 'Delete this message for you and other participants?', 'Delete')) return;

      try {
        const numericMessageID = Number(messageID);
        if (!Number.isFinite(numericMessageID) || numericMessageID <= 0) {
          throw new Error('Invalid message ID');
        }

        const res = await fetch('/api/chat/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messageID: numericMessageID })
        });
        if (!res.ok) {
          const errText = await res.text();
          throw new Error(errText || 'Failed to delete message');
        }

        const key = getConversationKey();
        conversationMessages[key] = (conversationMessages[key] || []).filter((msg) => String(msg.id || msg.ID) !== String(numericMessageID));
        renderCurrentConversation();
      } catch (err) {
        alert(err.message);
      }
    }

    function getSharePayload(msg) {
      const content = msg.content || msg.Content || msg.mediaURL || msg.MediaURL || '';
      const fileName = msg.fileName || msg.FileName || 'attachment';
      const mediaType = msg.mediaType || msg.MediaType || '';
      const isMedia = (msg.type || msg.Type) === 'media' || !!mediaType;

      if (isMedia) {
        return {
          title: fileName,
          text: fileName,
          url: content
        };
      }

      return {
        title: 'Message',
        text: content
      };
    }

    function dataUrlToFile(dataUrl, fileName) {
      const match = dataUrl.match(/^data:([^;]+);base64,(.*)$/);
      if (!match) return null;
      const mime = match[1];
      const bin = atob(match[2]);
      const len = bin.length;
      const bytes = new Uint8Array(len);
      for (let i = 0; i < len; i++) bytes[i] = bin.charCodeAt(i);
      return new File([bytes], fileName || 'attachment', { type: mime });
    }

    function openShareModal(payload) {
      currentSharePayload = payload;
      document.getElementById('shareModalDesc').textContent = payload.url
        ? 'Native sharing is unavailable here. You can still copy, open, or email this attachment.'
        : 'Share this message by copying it or opening your email app.';
      document.getElementById('shareOpenBtn').style.display = payload.url ? 'inline-flex' : 'none';
      document.getElementById('shareModal').classList.add('visible');
    }

    function closeShareModal() {
      document.getElementById('shareModal').classList.remove('visible');
      currentSharePayload = null;
    }

    async function copyMessageContent(msg, button) {
      const content = msg.content || msg.Content || msg.mediaURL || msg.MediaURL || '';
      const fileName = msg.fileName || msg.FileName || '';
      const mediaType = msg.mediaType || msg.MediaType || '';
      const isMedia = (msg.type || msg.Type) === 'media' || !!mediaType;
      const payload = isMedia ? `${fileName || 'Attachment'}\n${content}` : content;

      try {
        await navigator.clipboard.writeText(payload);
        if (button) {
          button.classList.add('copied');
          const icon = button.querySelector('.material-symbols-outlined');
          const oldText = icon?.textContent;
          if (icon) icon.textContent = 'check';
          setTimeout(() => {
            button.classList.remove('copied');
            if (icon && oldText) icon.textContent = oldText;
          }, 1200);
        }
      } catch (err) {
        alert('Copy failed. Your browser blocked clipboard access.');
      }
    }

    async function shareMessageContent(msg) {
      const payload = getSharePayload(msg);
      const fileName = msg.fileName || msg.FileName || 'attachment';
      const file = payload.url && payload.url.startsWith('data:') ? dataUrlToFile(payload.url, fileName) : null;

      try {
        if (navigator.share) {
          if (file && navigator.canShare && navigator.canShare({ files: [file] })) {
            await navigator.share({ title: payload.title, text: payload.text, files: [file] });
            return;
          }
          if (!file) {
            await navigator.share(payload);
            return;
          }
        }
      } catch (err) {
        if (err && err.name === 'AbortError') return;
      }

      openShareModal(payload);
    }

    function setReceiver(id, name, isGroup, isPrivate = false) {
      receiverID = id;
      isGroupChat = isGroup;
      activeChatName = name;
      activeGroupPrivate = isPrivate;

