    // ── Messages ──
    function renderMessageBubble(msg) {
      const msgReceiverID = msg.receiverID || msg.ReceiverID;
      const msgSenderID = msg.senderID || msg.SenderID;
      const content = msg.content || msg.Content || msg.mediaURL || msg.MediaURL || '';
      const senderName = msg.senderName || msg.SenderName || `User ${msgSenderID || ''}`.trim();
      const isSent = String(msgSenderID) === String(currentUserID);

      // Filtering Logic
      let shouldShow = false;
      if (receiverID === 'all' && msgReceiverID === 'all') {
        shouldShow = true;
      } else if (receiverID.startsWith('group_') && msgReceiverID === receiverID) {
        shouldShow = true;
      } else if (!receiverID.startsWith('group_') && receiverID !== 'all') {
        // 1-to-1 mode: Show if sent by me to receiver, OR sent by receiver to me
        if (isSent && String(msgReceiverID) === String(receiverID)) shouldShow = true;
        if (!isSent && String(msgSenderID) === String(receiverID)) shouldShow = true;
      }

      if (!shouldShow) return;

      const container = document.getElementById('messages');
      const emptyState = document.getElementById('emptyState');
      if (emptyState) emptyState.remove();

      const pendingState = msg.pendingState || '';
      const isPending = Boolean(pendingState);
      const div = document.createElement('div');
      div.className = `msg-bubble ${isSent ? 'sent' : 'received'}${isPending ? ' pending' : ''}`;

      const createdAt = msg.createdAt || msg.CreatedAt;
      const ts = createdAt ? new Date(createdAt) : new Date();
      const time = ts.getHours().toString().padStart(2, '0') + ':' + ts.getMinutes().toString().padStart(2, '0');
      const fileName = msg.fileName || msg.FileName || '';
      const messageID = msg.id || msg.ID || '';
      const playerId = `media-${++mediaPlayerCounter}`;
      const pendingLabel = msg.pendingLabel || 'Sending';
      let statusHtml = '';
      if (isSent) {
        if (pendingState === 'failed') {
          statusHtml = `<span class="msg-status-text failed" title="Failed"><span class="material-symbols-outlined">error</span>${escapeHtml(pendingLabel)}</span>`;
        } else if (pendingState) {
          statusHtml = `<span class="msg-status pending" title="${escapeHtml(pendingLabel)}"><span class="material-symbols-outlined">schedule</span><span class="msg-status-label">${escapeHtml(pendingLabel)}</span></span>`;
        } else {
          statusHtml = `<span class="msg-status" title="Delivered"><span class="material-symbols-outlined">done_all</span></span>`;
        }
      }

      let html = '';
      html += `<div class="msg-actions"></div>`;
      if (!isSent) {
        html += `<span class="msg-sender">${escapeHtml(senderName)}</span>`;
      }

      // Check for media
      const msgType = msg.type || msg.Type || 'text';
      const mediaType = msg.mediaType || msg.MediaType || '';

      if (msgType === 'media' || mediaType) {
        if (pendingState && !content) {
          const pendingTitle = mediaType === 'video'
            ? (fileName || 'Video')
            : mediaType === 'audio'
              ? (fileName || 'Audio')
              : mediaType === 'image'
                ? (fileName || 'Image')
                : (fileName || 'Attachment');
          const pendingSubtitle = pendingLabel || 'Sending';
          html += `<div class="msg-media-card"><div class="msg-file-card"><div class="msg-file-icon"><span class="material-symbols-outlined">${mediaType === 'video' ? 'movie' : mediaType === 'audio' ? 'audio_file' : mediaType === 'image' ? 'image' : 'description'}</span></div><div class="msg-file-info"><div class="msg-file-title">${escapeHtml(pendingTitle)}</div><div class="msg-file-subtitle">${escapeHtml(pendingSubtitle)}</div></div><div class="msg-file-open"><span class="material-symbols-outlined spin">progress_activity</span></div></div><div class="msg-media-meta"><span class="msg-media-name">${escapeHtml(pendingTitle)}</span><span class="msg-media-time">${time}${statusHtml}</span></div></div>`;
        } else if (mediaType === 'image') {
          html += `<div class="msg-media-card"><div class="msg-image-shell"><img src="${content}" class="msg-media img" onclick="openImageLightbox('${content}', '${escapeHtml(fileName || 'Image').replace(/'/g, '&#39;')}')"></div><div class="msg-media-meta"><span class="msg-media-name">${escapeHtml(fileName || 'Image')}</span><span class="msg-media-time">${time}${statusHtml}</span></div></div>`;
        } else if (mediaType === 'video') {
          html += `<div class="msg-media-card"><div class="msg-video-shell"><div class="msg-media-frame"><span class="msg-video-badge"><span class="material-symbols-outlined" style="font-size:14px;">videocam</span>Video</span><video src="${content}" controls preload="metadata" class="msg-media vid"></video></div><div class="msg-video-footer"><div class="msg-video-title-wrap"><div class="msg-video-title">${escapeHtml(fileName || 'Video')}</div><div class="msg-video-subtitle">Native playback controls preserved</div></div><span class="msg-media-time">${time}${statusHtml}</span></div></div></div>`;
        } else if (mediaType === 'audio') {
          html += `<div class="msg-media-card"><div class="msg-audio-player" data-player-id="${playerId}"><audio src="${content}" preload="metadata"></audio><div class="msg-audio-top"><div class="msg-audio-icon"><span class="material-symbols-outlined">graphic_eq</span></div><div class="msg-audio-info"><div class="msg-audio-title">${escapeHtml(fileName || 'Audio')}</div><div class="msg-audio-subtitle">Voice and audio clip</div></div><div class="msg-audio-controls"><button class="msg-audio-btn" type="button" data-action="play"><span class="material-symbols-outlined">play_arrow</span></button><button class="msg-audio-btn" type="button" data-action="mute"><span class="material-symbols-outlined">volume_up</span></button></div></div><div class="msg-audio-progress"><input class="msg-audio-seek" type="range" min="0" max="100" value="0" step="0.1"><span class="msg-audio-time">0:00</span></div></div><div class="msg-media-meta"><span class="msg-media-name">${escapeHtml(fileName || 'Audio')}</span><span class="msg-media-time">${time}${statusHtml}</span></div></div>`;
        } else {
          html += `<div class="msg-media-card"><a class="msg-file-link" href="${content}" download="${escapeHtml(fileName || 'attachment')}"><div class="msg-file-card"><div class="msg-file-icon"><span class="material-symbols-outlined">description</span></div><div class="msg-file-info"><div class="msg-file-title">${escapeHtml(fileName || 'Attachment')}</div><div class="msg-file-subtitle">Open or download file</div></div><div class="msg-file-open"><span class="material-symbols-outlined">download</span></div></div></a><div class="msg-media-meta"><span class="msg-media-name">${escapeHtml(fileName || 'File')}</span><span class="msg-media-time">${time}${statusHtml}</span></div></div>`;
        }
      } else {
        html += `<span class="msg-text">${escapeHtml(content)}</span>`;
        html += `<span class="msg-time">${time}${statusHtml}</span>`;
      }
      div.innerHTML = html;
      const actions = div.querySelector('.msg-actions');
      if (actions) {
        const copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'msg-action-btn';
        copyBtn.title = 'Copy';
        copyBtn.innerHTML = '<span class="material-symbols-outlined">content_copy</span>';
        copyBtn.onclick = () => copyMessageContent(msg, copyBtn);
        actions.appendChild(copyBtn);

        const shareBtn = document.createElement('button');
        shareBtn.type = 'button';
        shareBtn.className = 'msg-action-btn';
        shareBtn.title = 'Share';
        shareBtn.innerHTML = '<span class="material-symbols-outlined">share</span>';
        shareBtn.onclick = () => shareMessageContent(msg);
        actions.appendChild(shareBtn);

        if (isSent && messageID && !pendingState) {
          const deleteBtn = document.createElement('button');
          deleteBtn.type = 'button';
          deleteBtn.className = 'msg-action-btn';
          deleteBtn.title = 'Delete message';
          deleteBtn.innerHTML = '<span class="material-symbols-outlined">delete</span>';
          deleteBtn.onclick = () => deleteMessage(messageID);
          actions.appendChild(deleteBtn);
        }
      }
      container.appendChild(div);
      const audioPlayer = div.querySelector('.msg-audio-player');
      if (audioPlayer) {
        setupAudioPlayer(audioPlayer);
      }
      container.scrollTop = container.scrollHeight;
    }

    function formatAudioTime(seconds) {
      if (!Number.isFinite(seconds)) return '0:00';
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60).toString().padStart(2, '0');
      return `${mins}:${secs}`;
    }

    function setupAudioPlayer(player) {
      const audio = player.querySelector('audio');
      const playBtn = player.querySelector('[data-action="play"]');
      const muteBtn = player.querySelector('[data-action="mute"]');
      const seek = player.querySelector('.msg-audio-seek');
      const timeEl = player.querySelector('.msg-audio-time');
      if (!audio || !playBtn || !muteBtn || !seek || !timeEl) return;

      const playIcon = playBtn.querySelector('.material-symbols-outlined');
      const muteIcon = muteBtn.querySelector('.material-symbols-outlined');

      const syncProgress = () => {
        const progress = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
        seek.value = String(progress);
        timeEl.textContent = formatAudioTime(audio.currentTime);
      };

      audio.addEventListener('loadedmetadata', () => {
        timeEl.textContent = formatAudioTime(audio.duration || 0);
      });
      audio.addEventListener('timeupdate', syncProgress);
      audio.addEventListener('play', () => {
        playIcon.textContent = 'pause';
      });
      audio.addEventListener('pause', () => {
        playIcon.textContent = 'play_arrow';
      });
      audio.addEventListener('ended', () => {
        audio.currentTime = 0;
        seek.value = '0';
        playIcon.textContent = 'play_arrow';
        timeEl.textContent = formatAudioTime(audio.duration || 0);
      });

      playBtn.addEventListener('click', () => {
        if (audio.paused) {
          document.querySelectorAll('.msg-audio-player audio').forEach((other) => {
            if (other !== audio) other.pause();
          });
          audio.play();
        } else {
          audio.pause();
        }
      });

      muteBtn.addEventListener('click', () => {
        audio.muted = !audio.muted;
        muteIcon.textContent = audio.muted ? 'volume_off' : 'volume_up';
      });

      seek.addEventListener('input', () => {
        if (!audio.duration) return;
        audio.currentTime = (Number(seek.value) / 100) * audio.duration;
        syncProgress();
      });
    }

    function appendMessageToConversation(msg) {
      const key = getConversationKeyForMessage(msg);
      if (!conversationMessages[key]) {
        conversationMessages[key] = [];
      }
      conversationMessages[key].push(msg);

      if (key === getConversationKey()) {
        renderMessageBubble(msg);
      }
    }

    function addSystemMessage(text) {
      const container = document.getElementById('messages');
      const emptyState = document.getElementById('emptyState');
      if (emptyState) emptyState.remove();

      const div = document.createElement('div');
      div.className = 'system-msg';
      div.textContent = text;
      container.appendChild(div);
      container.scrollTop = container.scrollHeight;
    }

    function escapeHtml(text) {
      const d = document.createElement('div');
      d.textContent = text;
      return d.innerHTML;
    }

    // ── Send Message ──
    async function sendMessage() {
      const input = document.getElementById('msgInput');
      if (composerBusy) return;

      if (selectedFile) {
        await sendFileMessage();
        return;
      }

      const text = input.value.trim();
      if (!text) return;

      const msg = {
        type: 'text',
        receiverID: receiverID,
        content: text,
        senderID: currentUserID,
        isGroup: isGroupChat
      };

      const pendingMsg = createPendingMessage({
        type: 'text',
        content: text,
        pendingLabel: 'Sending'
      });
      appendMessageToConversation(pendingMsg);

      if (socket.readyState !== WebSocket.OPEN) {
        updatePendingMessage(pendingMsg.clientTempID, { pendingState: 'failed', pendingLabel: 'Failed' });
        addSystemMessage('Message could not be sent because the connection is offline.');
        return;
      }

      try {
        socket.send(JSON.stringify(msg));
      } catch (err) {
        updatePendingMessage(pendingMsg.clientTempID, { pendingState: 'failed', pendingLabel: 'Failed' });
        addSystemMessage(err?.message || 'Message could not be sent.');
        return;
      }

      input.value = '';
      input.focus();
    }

    // ── File Handling ──
    async function handleFileSelect(event) {
      const file = event.target.files[0];
      if (!file) return;

      selectedFileQuality = '';
      selectedFile = file;

      // Show preview
      const preview = document.getElementById('file-preview');
      const thumb = document.getElementById('fileThumb');
      const nameEl = document.getElementById('fileName');
      const sizeEl = document.getElementById('fileSize');

      nameEl.textContent = selectedFile.name;
      sizeEl.classList.remove('is-processing');
      sizeEl.textContent = formatFileSize(selectedFile.size) + (selectedFileQuality ? ` · ${selectedFileQuality}` : '');
      sizeEl.classList.remove('is-processing');

      // Thumbnail
      if (selectedFile.type.startsWith('image/')) {
        const reader = new FileReader();
        reader.onload = (e) => {
          thumb.innerHTML = `<img src="${e.target.result}">`;
        };
        reader.readAsDataURL(selectedFile);
      } else if (selectedFile.type.startsWith('video/')) {
        thumb.innerHTML = '<span class="material-symbols-outlined">movie</span>';
      } else if (selectedFile.type.startsWith('audio/')) {
        thumb.innerHTML = '<span class="material-symbols-outlined">audio_file</span>';
      } else {
        thumb.innerHTML = '<span class="material-symbols-outlined">description</span>';
      }

      preview.classList.add('visible');
    }

    function clearFilePreview() {
      selectedFile = null;
      selectedFileQuality = '';
      document.getElementById('file-preview').classList.remove('visible');
      document.getElementById('fileInput').value = '';
      document.getElementById('fileSize')?.classList.remove('is-processing');
    }

    async function compressVideoFile(file) {
      if (!window.MediaRecorder) {
        throw new Error('MediaRecorder is not available');
      }

      const objectUrl = URL.createObjectURL(file);
      const video = document.createElement('video');
      video.src = objectUrl;
      video.muted = true;
      video.playsInline = true;
      video.preload = 'metadata';

      const waitForVideoReady = (element, timeoutMs = 12000) => new Promise((resolve, reject) => {
        const timer = setTimeout(() => {
          cleanup();
          reject(new Error('Timed out while preparing the selected video'));
        }, timeoutMs);

        const cleanup = () => {
          clearTimeout(timer);
          element.onloadedmetadata = null;
          element.oncanplay = null;
          element.onerror = null;
        };

        if (element.readyState >= 2 && element.videoWidth > 0 && element.videoHeight > 0) {
          cleanup();
          resolve();
          return;
        }

        element.onloadedmetadata = () => {
          if (element.readyState >= 2) {
            cleanup();
            resolve();
          }
        };
        element.oncanplay = () => {
          cleanup();
          resolve();
        };
        element.onerror = () => {
          cleanup();
          reject(new Error('Could not prepare selected video'));
        };
      });

      await waitForVideoReady(video);

      const maxWidth = 1280;
      const scale = Math.min(1, maxWidth / (video.videoWidth || maxWidth));
      const width = Math.max(2, Math.round((video.videoWidth || 1280) * scale));
      const height = Math.max(2, Math.round((video.videoHeight || 720) * scale));

      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');
      if (!ctx) {
        URL.revokeObjectURL(objectUrl);
        throw new Error('Canvas rendering is unavailable');
      }

      const stream = canvas.captureStream(24);

      const chunks = [];
      const mimeType = MediaRecorder.isTypeSupported('video/webm;codecs=vp9')
        ? 'video/webm;codecs=vp9'
        : (MediaRecorder.isTypeSupported('video/webm;codecs=vp8')
          ? 'video/webm;codecs=vp8'
          : 'video/webm');

      const recorder = new MediaRecorder(stream, {
        mimeType,
        videoBitsPerSecond: 1200000
      });

      recorder.ondataavailable = (event) => {
        if (event.data && event.data.size > 0) chunks.push(event.data);
      };

      const stopPromise = new Promise((resolve, reject) => {
        recorder.onstop = resolve;
        recorder.onerror = () => reject(new Error('Compression recorder failed'));
      });

      const drawFrame = () => {
        if (video.paused || video.ended) return;
        ctx.drawImage(video, 0, 0, width, height);
        requestAnimationFrame(drawFrame);
      };

      recorder.start(250);
      await video.play();
      ctx.drawImage(video, 0, 0, width, height);
      drawFrame();

      await new Promise((resolve, reject) => {
        const timer = setTimeout(() => {
          reject(new Error('Compression timed out before playback finished'));
        }, Math.max(15000, Math.ceil((video.duration || 0) * 1000) + 4000));

        video.onended = () => {
          clearTimeout(timer);
          resolve();
        };
        video.onerror = () => {
          clearTimeout(timer);
          reject(new Error('Video playback failed during compression'));
        };
      });

      recorder.stop();
      await stopPromise;
      video.pause();
      stream.getTracks().forEach((track) => track.stop());
      URL.revokeObjectURL(objectUrl);

      const blob = new Blob(chunks, { type: mimeType });
      if (!blob.size) {
        throw new Error('Compressed output was empty');
      }

      const finalFile = new File([blob], file.name.replace(/\.[^.]+$/, '.webm'), {
        type: blob.type || 'video/webm',
        lastModified: Date.now()
      });
      if (!finalFile.size) {
        throw new Error('Compressed file could not be created');
      }

      // If compression does not actually reduce size, keep the original upload path.
      if (finalFile.size >= file.size) {
        return file;
      }
      return finalFile;
    }

    function readFileAsDataURL(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = () => reject(new Error('Failed to read the selected file'));
        reader.readAsDataURL(file);
      });
    }

    async function sendFileMessage() {
      if (!selectedFile) return;
      if (composerBusy) return;

      let mediaType = 'file';
      if (selectedFile.type.startsWith('image/')) mediaType = 'image';
      else if (selectedFile.type.startsWith('video/')) mediaType = 'video';
      else if (selectedFile.type.startsWith('audio/')) mediaType = 'audio';

      const originalFile = selectedFile;
      const previewURL = URL.createObjectURL(originalFile);
      const pendingMsg = createPendingMessage({
        type: 'media',
        content: previewURL,
        mediaType,
        fileName: originalFile.name,
        pendingLabel: mediaType === 'video' ? 'Reading video' : 'Reading file'
      });
      pendingMsg.objectURL = previewURL;
      appendMessageToConversation(pendingMsg);
      setComposerBusy(true, mediaType === 'video' ? 'Reading video...' : 'Reading file...');

      try {
        const uploadFile = originalFile;
        const content = await readFileAsDataURL(uploadFile);
        updatePendingMessage(pendingMsg.clientTempID, {
          content,
          fileName: uploadFile.name,
          pendingLabel: 'Sending'
        });

        if (socket.readyState !== WebSocket.OPEN) {
          throw new Error('Connection is offline');
        }

        socket.send(JSON.stringify({
          type: 'media',
          receiverID: receiverID,
          content,
          mediaType,
          fileName: uploadFile.name,
          senderID: currentUserID,
          isGroup: isGroupChat
        }));

        clearFilePreview();
      } catch (err) {
        updatePendingMessage(pendingMsg.clientTempID, {
          pendingState: 'failed',
          pendingLabel: err?.message || 'Failed'
        });
        addSystemMessage(err?.message || 'File could not be sent.');
      } finally {
        setComposerBusy(false);
      }
    }

    function formatFileSize(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / 1048576).toFixed(1) + ' MB';
    }

    // ── Audio / Video Calls ──
    function buildCallRoomName() {
      if (receiverID === 'all') return 'campfire-main';
      if (receiverID.startsWith('group_')) return `chat-${receiverID}`;

      const ids = [String(currentUserID), String(receiverID)].sort();
      return `chat-dm-${ids.join('-')}`;
    }

    function getEmbeddedCallURL(withVideo) {
      const roomName = buildCallRoomName();
      const params = new URLSearchParams({
        room_name: roomName,
        room_label: activeChatName,
        mode: withVideo ? 'video' : 'audio'
      });
      return `/campfire/video?${params.toString()}`;
    }

    async function startCall(withVideo) {
      const frame = document.getElementById('callEmbedFrame');
      document.getElementById('embeddedCallTitle').textContent = `${withVideo ? 'Video' : 'Audio'} call · ${activeChatName}`;
      document.getElementById('embeddedCallSubtitle').textContent = 'Shared room embedded in chat. Anyone from this conversation can join while it stays active.';
      frame.src = getEmbeddedCallURL(withVideo);
      document.getElementById('call-area').classList.add('active');
      inCall = true;
    }

    function reloadEmbeddedCall() {
      const frame = document.getElementById('callEmbedFrame');
      if (!frame.src) return;
      frame.src = frame.src;
    }

    function initPeerConnection() {
      peerConnection = new RTCPeerConnection(rtcConfig);

      peerConnection.onicecandidate = (event) => {
        if (event.candidate) {
          socket.send(JSON.stringify({
            type: 'signal',
            receiverID: receiverID,
            signal: { candidate: event.candidate }
          }));
        }
      };

      peerConnection.ontrack = (event) => {
        document.getElementById('remoteVideo').srcObject = event.streams[0];
      };

      peerConnection.onconnectionstatechange = () => {
        if (peerConnection.connectionState === 'disconnected' || peerConnection.connectionState === 'failed') {
          addSystemMessage('Call ended.');
          endCall();
        }
      };
    }

    async function handleSignaling(msg) {
      const data = msg.signal || msg.Signal;
      const senderID = msg.senderID || msg.SenderID;
      const callType = msg.callType || 'audio';

      if (data.sdp && data.sdp.type === 'offer') {
        // Incoming call
        pendingSignal = msg;
        const banner = document.getElementById('incomingCallBanner');
        document.getElementById('callerName').textContent = 'User ' + senderID;
        document.getElementById('callType').textContent = callType === 'video' ? 'Video call' : 'Audio call';
        banner.classList.add('visible');
        return;
      }

      if (!peerConnection) initPeerConnection();

      if (data.sdp) {
        await peerConnection.setRemoteDescription(new RTCSessionDescription(data.sdp));
      } else if (data.candidate) {
        await peerConnection.addIceCandidate(new RTCIceCandidate(data.candidate));
      }
    }

    async function acceptCall() {
      if (!pendingSignal) return;
      const msg = pendingSignal;
      const callType = msg.callType || 'audio';
      pendingSignal = null;
      document.getElementById('incomingCallBanner').classList.remove('visible');
      startCall(callType === 'video');
    }

    function rejectCall() {
      pendingSignal = null;
      document.getElementById('incomingCallBanner').classList.remove('visible');
      addSystemMessage('Call declined');
    }

    function endCall() {
      if (peerConnection) {
        peerConnection.close();
        peerConnection = null;
      }
      if (localStream) {
        localStream.getTracks().forEach(t => t.stop());
        localStream = null;
      }
      const frame = document.getElementById('callEmbedFrame');
      if (frame) frame.src = 'about:blank';
      document.getElementById('call-area').classList.remove('active');
      inCall = false;
      micEnabled = true;
      camEnabled = true;
      updateCallButtons();
    }

    function toggleMic() {
      if (!localStream) return;
      micEnabled = !micEnabled;
      localStream.getAudioTracks().forEach(t => t.enabled = micEnabled);
      updateCallButtons();
    }

    function toggleCam() {
      if (!localStream) return;
      camEnabled = !camEnabled;
      localStream.getVideoTracks().forEach(t => t.enabled = camEnabled);
      updateCallButtons();
    }

    function updateCallButtons() {
      const micBtn = document.getElementById('btnMuteMic');
      const camBtn = document.getElementById('btnToggleCam');
      if (!micBtn || !camBtn) return;
      micBtn.className = `call-ctrl-btn ${micEnabled ? '' : 'toggled-off'}`;
      micBtn.querySelector('.material-symbols-outlined').textContent = micEnabled ? 'mic' : 'mic_off';
      camBtn.className = `call-ctrl-btn ${camEnabled ? '' : 'toggled-off'}`;
      camBtn.querySelector('.material-symbols-outlined').textContent = camEnabled ? 'videocam' : 'videocam_off';
    }

    // ── Group Management ──
    function openGroupModal() {
      const modal = document.getElementById('groupModal');
      const input = document.getElementById('groupNameInput');
      const toggle = document.getElementById('groupPrivateToggle');
      if (!modal || !input || !toggle) return;

      input.value = '';
      toggle.checked = false;
      if (privateNote) privateNote.style.display = 'none';
      modal.classList.add('visible');
      input.focus();
    }

    function closeGroupModal() {
      document.getElementById('groupModal').classList.remove('visible');
    }

    async function createNewGroup() {
      const name = document.getElementById('groupNameInput').value.trim();
      const isPrivate = document.getElementById('groupPrivateToggle').checked;

      if (!name) {
        alert('Group name is required.');
        return;
      }

      try {
        const res = await fetch('/api/groups/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, isPrivate })
        });
        if (!res.ok) throw new Error('Failed to create group');
        
        const g = await res.json();
        closeGroupModal();
        addSystemMessage(`Group "${g.name}" created!`);
        window.location.reload(); // Refresh to show in sidebar
      } catch (err) {
        alert(err.message);
      }
    }

    async function joinGroup(groupID) {
      try {
        const res = await fetch('/api/groups/join', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ groupID: parseInt(groupID) })
        });
        if (!res.ok) throw new Error('Failed to join group');
        
        window.location.reload();
      } catch (err) {
        alert(err.message);
      }
    }

    function openJoinCodeModal() {
      document.getElementById('joinCodeModal').classList.add('visible');
      document.getElementById('joinCodeInput').focus();
    }
    function closeJoinCodeModal() {
      document.getElementById('joinCodeModal').classList.remove('visible');
    }

    async function joinByCode() {
      const code = document.getElementById('joinCodeInput').value.trim().toUpperCase();
      if (code.length !== 6) {
        alert('Enter a valid 6-digit code.');
        return;
      }

      try {
        const res = await fetch('/api/groups/join-code', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code })
        });
        if (!res.ok) throw new Error('Invalid code or group not found');
        
        window.location.reload();
      } catch (err) {
        alert(err.message);
      }
    }

    async function openGroupInfo(groupID) {
      try {
        const res = await fetch(`/api/groups/members?groupID=${groupID}`);
        if (!res.ok) throw new Error('Failed to fetch members');
        const members = await res.json();
        
        // Find group details from UserGroups or PublicGroups (using state or re-fetching)
        // For simplicity, we use the active receiver info
        document.getElementById('infoGroupName').textContent = activeChatName;
        const badge = document.getElementById('infoGroupBadge');
        badge.textContent = activeGroupPrivate ? 'Private' : 'Public';
        badge.className = `badge ${activeGroupPrivate ? 'badge-private' : 'badge-public'}`;

        const list = document.getElementById('groupMemberList');
        list.innerHTML = '';
        
        let amAdmin = false;
        members.forEach(m => {
          if (m.user_id === currentUserID && m.role === 'admin') amAdmin = true;
          
          const div = document.createElement('div');
          div.style = 'display: flex; align-items: center; justify-content: space-between; padding: 0.5rem; background: var(--card-bg); border-radius: var(--radius-sm);';
          div.innerHTML = `
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <div class="conv-avatar" style="width: 28px; height: 28px; font-size: 0.7rem;">${m.user_name.charAt(0)}</div>
              <span style="font-size: 0.88rem; font-weight: 500;">${escapeHtml(m.user_name)}</span>
              ${m.role === 'admin' ? '<span class="badge badge-public" style="font-size: 0.6rem;">Admin</span>' : ''}
            </div>
          `;
          
          if (amAdmin && m.user_id !== currentUserID) {
            const remBtn = document.createElement('button');
            remBtn.className = 'header-action-btn';
            remBtn.style = 'width: 24px; height: 24px; color: var(--danger);';
            remBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 16px;">person_remove</span>';
            remBtn.onclick = () => removeMember(groupID, m.user_id);
            div.appendChild(remBtn);
          }
          
          list.appendChild(div);
        });

        const adminCtrls = document.getElementById('adminControls');
        adminCtrls.style.display = amAdmin ? 'block' : 'none';
        
        if (amAdmin && activeGroupPrivate) {
          const codeRes = await fetch(`/api/groups/my`); // Re-fetch to get invite code
          const myGroups = await codeRes.json();
          const g = myGroups.find(x => x.id == groupID);
          if (g && g.invite_code) {
             document.getElementById('inviteCodeDisplay').style.display = 'block';
             document.getElementById('infoInviteCode').textContent = g.invite_code;
          }
        } else {
          document.getElementById('inviteCodeDisplay').style.display = 'none';
        }

        activeGroupInfo = { id: groupID, members };
        document.getElementById('groupInfoPanel').style.right = '0';
      } catch (err) {
        alert(err.message);
      }
    }

    function closeGroupInfo() {
      document.getElementById('groupInfoPanel').style.right = '-320px';
    }

    async function removeMember(groupID, targetUserID) {
      if (!await confirmAction('Remove Member', 'Remove this member from the group?', 'Remove')) return;
      try {
        const res = await fetch('/api/groups/remove-member', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ groupID: parseInt(groupID), targetUserID })
        });
        if (!res.ok) throw new Error('Failed to remove member');
        openGroupInfo(groupID); // Refresh list
      } catch (err) {
        alert(err.message);
      }
    }

    async function regenerateCode() {
      if (!activeGroupInfo) return;
      try {
        const res = await fetch('/api/groups/regenerate-code', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ groupID: parseInt(activeGroupInfo.id) })
        });
        if (!res.ok) throw new Error('Failed to regenerate code');
        const data = await res.json();
        document.getElementById('infoInviteCode').textContent = data.code;
      } catch (err) {
        alert(err.message);
      }
    }

    async function deleteGroup() {
      if (!activeGroupInfo) return;
      if (!await confirmAction('Delete Group', 'Permanently delete this group and all its messages?', 'Delete')) return;
      try {
        const res = await fetch('/api/groups/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ groupID: parseInt(activeGroupInfo.id) })
        });
        if (!res.ok) throw new Error('Failed to delete group');
        window.location.reload();
      } catch (err) {
        alert(err.message);
      }
    }

    async function leaveGroup() {
      if (!activeGroupInfo) return;
      if (!await confirmAction('Leave Group', 'You will leave this conversation and stop receiving new messages from it.', 'Leave')) return;
      try {
        const res = await fetch('/api/groups/leave', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ groupID: parseInt(activeGroupInfo.id) })
        });
        if (!res.ok) throw new Error('Failed to leave group');
        window.location.reload();
      } catch (err) {
        alert(err.message);
      }
    }

    document.getElementById('msgInput')?.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' || event.shiftKey) return;
      event.preventDefault();
      sendMessage();
    });

    document.getElementById('groupNameInput')?.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      createNewGroup();
    });

    document.getElementById('joinCodeInput')?.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      joinByCode();
    });

    document.getElementById('groupModal')?.addEventListener('click', (event) => {
      if (event.target.id === 'groupModal') closeGroupModal();
    });

    document.getElementById('joinCodeModal')?.addEventListener('click', (event) => {
      if (event.target.id === 'joinCodeModal') closeJoinCodeModal();
    });

    document.getElementById('confirmModal')?.addEventListener('click', (event) => {
      if (event.target.id === 'confirmModal') closeConfirmModal(false);
    });
    document.getElementById('confirmCancelBtn')?.addEventListener('click', () => closeConfirmModal(false));
    document.getElementById('confirmOkBtn')?.addEventListener('click', () => closeConfirmModal(true));
    document.getElementById('shareModal')?.addEventListener('click', (event) => {
      if (event.target.id === 'shareModal') closeShareModal();
    });
    document.getElementById('shareCancelBtn')?.addEventListener('click', closeShareModal);
    document.getElementById('shareCopyBtn')?.addEventListener('click', async () => {
      if (!currentSharePayload) return;
      try {
        await navigator.clipboard.writeText(currentSharePayload.url || currentSharePayload.text || '');
        closeShareModal();
        addSystemMessage('Content copied.');
      } catch (err) {
        addSystemMessage('Copy failed on this browser.');
      }
    });
    document.getElementById('shareOpenBtn')?.addEventListener('click', () => {
      if (!currentSharePayload?.url) return;
      const a = document.createElement('a');
      a.href = currentSharePayload.url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.click();
      closeShareModal();
    });
    document.getElementById('shareEmailBtn')?.addEventListener('click', () => {
      if (!currentSharePayload) return;
      const subject = encodeURIComponent(currentSharePayload.title || 'Shared from chat');
      const body = encodeURIComponent(currentSharePayload.url || currentSharePayload.text || '');
      window.location.href = `mailto:?subject=${subject}&body=${body}`;
      closeShareModal();
    });
    document.getElementById('imageLightbox')?.addEventListener('click', (event) => {
      if (event.target.id === 'imageLightbox') closeImageLightbox();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closeGroupModal();
      closeJoinCodeModal();
      closeGroupInfo();
      closeConfirmModal(false);
      closeShareModal();
      closeImageLightbox();
    });

    loadConversationHistory();
  </script>
</body>
</html>
