<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <title>Chat · Remainwith</title>

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&amp;family=Noto+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>

  <style>
    /* ==================================================
       Remainwith Theme Variables
       ================================================== */

    :root {
      --font-display: "Newsreader", serif;
      --font-sans: "Noto Sans", sans-serif;
      --radius-sm: 0.375rem;
      --radius-md: 0.5rem;
      --radius-lg: 1rem;
      --radius-xl: 1.5rem;
      --radius-full: 9999px;
      
      /* Shared spacing */
      --header-height: 70px;
      --input-height: 80px;
    }

    /* 1. LIGHT THEME */
    html[data-theme="light"] {
      --primary: #7d8471;
      --primary-fg: #ffffff; /* Text color on primary bg */
      --bg-body: #f3f4f1;
      --card-bg: #ffffff;
      --card-border: #e7e5e4;
      --text-main: #292524;
      --text-muted: #57534e;
      --text-subtle: #a8a29e;
      --divider: #e5e5e5;
      --input-bg: #ffffff;
      --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
      --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.05);
      --bubble-self: #7d8471;
      --bubble-self-text: #ffffff;
      --bubble-other: #ffffff;
    }

    /* 2. DARK THEME */
    html[data-theme="dark"] {
      --primary: #9ca38f;
      --primary-fg: #1c1917;
      --bg-body: #191a18;
      --card-bg: #262321;
      --card-border: #292524;
      --text-main: #e7e5e4;
      --text-muted: #a8a29e;
      --text-subtle: #57534e;
      --divider: #292524;
      --input-bg: #262321;
      --shadow-sm: 0 1px 2px rgba(0,0,0,0.3);
      --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.4);
      --bubble-self: #9ca38f;
      --bubble-self-text: #191a18;
      --bubble-other: #262321;
    }

    /* 3. SEPIA THEME */
    html[data-theme="sepia"] {
      --primary: #8a7356;
      --primary-fg: #fdf6e3;
      --bg-body: #f4ecd8;
      --card-bg: #fdf6e3;
      --card-border: #e6dcc6;
      --text-main: #433422;
      --text-muted: #746351;
      --text-subtle: #b8ad9e;
      --divider: #e6dcc6;
      --input-bg: #fdf6e3;
      --shadow-sm: 0 1px 2px rgba(67, 52, 34, 0.05);
      --shadow-md: 0 4px 6px -1px rgba(67, 52, 34, 0.05);
      --bubble-self: #8a7356;
      --bubble-self-text: #fdf6e3;
      --bubble-other: #fdf6e3;
    }

    /* 4. FOREST THEME */
    html[data-theme="forest"] {
      --primary: #76a881;
      --primary-fg: #0f1a15;
      --bg-body: #1a211e;
      --card-bg: #222b26;
      --card-border: #2f3b34;
      --text-main: #dcece1;
      --text-muted: #8ca392;
      --text-subtle: #4a5c52;
      --divider: #2f3b34;
      --input-bg: #222b26;
      --shadow-sm: 0 1px 2px rgba(0,0,0,0.3);
      --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.4);
      --bubble-self: #76a881;
      --bubble-self-text: #111a15;
      --bubble-other: #222b26;
      
    }

    /* ==================================================
       Reset & Base
       ================================================== */
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg-body);
      color: var(--text-main);
      font-family: var(--font-sans); /* Default to Sans for UI */
      height: 100dvh; /* Dynamic Viewport Height for mobile */
      overflow: hidden; /* Prevent body scroll */
    }

    h1, h2, h3 { font-family: var(--font-display); }

    /* ==================================================
       Layout Container
       ================================================== */
    .app-layout {
      max-width: 900px;
      margin: 0 auto;
      height: 100%;
      display: flex;
      flex-direction: column;
      background: var(--bg-body);
      position: relative;
    }

    /* ==================================================
       Header
       ================================================== */
    .chat-header {
      height: var(--header-height);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.5rem;
      border-bottom: 1px solid var(--divider);
      background: var(--bg-body);
      z-index: 10;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .back-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      color: var(--text-muted);
      text-decoration: none;
      transition: background 0.2s, color 0.2s;
    }

    .back-btn:hover {
      background: var(--divider);
      color: var(--primary);
    }

    .header-info h1 {
      font-size: 1.25rem;
      font-weight: 600;
      line-height: 1.2;
    }

    .header-info p {
      font-size: 0.85rem;
      color: var(--text-muted);
      transition: color 0.3s ease;
    }

    .header-actions {
      position: relative; /* For menu positioning */
    }
    .theme-selector-wrapper { position: relative; display: inline-flex; align-items: center; width: fit-content; }
    .icon-palette {
        position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
        font-size: 18px !important; color: var(--text-muted); pointer-events: none; z-index: 2;
    }
    .theme-select {
        appearance: none; -webkit-appearance: none; cursor: pointer;
        background-color: var(--card-bg); color: var(--text-main);
        border: 1px solid var(--card-border); border-radius: var(--radius-full);
        padding: 0.6rem 2.5rem 0.6rem 38px;
        font-size: 0.9rem; font-family: var(--font-sans); font-weight: 500;
        transition: all 0.2s ease-in-out; z-index: 1;

    }
    .icon-chevron {
        position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
        font-size: 20px !important; color: var(--text-muted); pointer-events: none; z-index: 2;
    }
    .theme-select:hover { border-color: var(--primary); background-color: var(--divider); }
    .theme-selector-wrapper:hover .material-symbols-outlined { color: var(--primary); }

    /* ==================================================
       Suggested Users Section
       ================================================== */
    .suggested-users-section {
      padding: 1rem 1.5rem;
      border-bottom: 1px solid var(--divider);
      background: var(--card-bg);
    }

    .suggested-users-section h3 {
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 0.75rem;
    }

    .suggested-users-list {
      display: flex;
      gap: 0.75rem;
      overflow-x: auto; /* Allow horizontal scrolling on mobile */
      padding-bottom: 0.5rem; /* Space for scrollbar */
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; /* Firefox */
    }
    .suggested-users-list::-webkit-scrollbar {
      display: none; /* Chrome, Safari */
    }

    .suggested-user {
      background: var(--card-bg);
      color: var(--text-muted);
      padding: 0.35rem 1rem;
      border-radius: var(--radius-full);
      font-size: 0.85rem;
      font-weight: 500;
      border: 1px solid var(--card-border);
      cursor: pointer;
      transition: all 0.2s ease;
      flex-shrink: 0; /* Prevent buttons from shrinking */
    }
    .suggested-user:hover, .suggested-user.active {
      background: var(--primary);
      color: var(--primary-fg);
      border-color: var(--primary);
      transform: translateY(-1px);
    }

    /* ==================================================
       Messages Area
       ================================================== */
    .messages-viewport {
      flex: 1;
      overflow-y: auto;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      scroll-behavior: smooth;
    }

    /* Scrollbar Styling */
    .messages-viewport::-webkit-scrollbar { width: 6px; }
    .messages-viewport::-webkit-scrollbar-track { background: transparent; }
    .messages-viewport::-webkit-scrollbar-thumb { background-color: var(--divider); border-radius: 20px; }

    /* Date Divider */
    .date-divider {
      text-align: center;
      font-size: 0.75rem;
      color: var(--text-subtle);
      margin: 0.5rem 0;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .date-divider::before, .date-divider::after {
      content: "";
      height: 1px;
      background: var(--divider);
      width: 30px;
      margin: 0 10px;
    }

    /* Message Styles */
    .message {
      display: flex;
      align-items: flex-end;
      gap: 0.75rem;
      max-width: 85%;
      animation: fadeIn 0.3s ease;
    }

    .message.own {
      align-self: flex-end;
      flex-direction: row-reverse;
    }

    .avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--card-border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      flex-shrink: 0;
      border: 2px solid var(--bg-body); /* slight border */
    }

    .bubble {
      padding: 0.75rem 1rem;
      border-radius: var(--radius-lg);
      font-size: 0.95rem;
      line-height: 1.5;
      position: relative;
      box-shadow: var(--shadow-sm);
    }

    /* Other's Bubble */
    .message:not(.own) .bubble {
      background: var(--bubble-other);
      border: 1px solid var(--card-border);
      color: var(--text-main);
      border-bottom-left-radius: 4px; /* Asymmetric shape */
    }

    /* Own Bubble */
    .message.own .bubble {
      background: var(--bubble-self);
      color: var(--bubble-self-text);
      border: 1px solid transparent;
      border-bottom-right-radius: 4px; /* Asymmetric shape */
    }

    /* Bubble tails for classic chat look */
    .bubble::before {
      content: '';
      position: absolute;
      bottom: 0px;
      width: var(--bubble-tail-size);
      height: 20px;
    }

    .message:not(.own) .bubble::before {
      left: -5px;
      background: var(--bubble-other);
      border-bottom-right-radius: 15px 10px;
      border-left: 1px solid var(--card-border);
      border-bottom: 1px solid var(--card-border);
    }

    .message.own .bubble::before {
      right: -5px;
      background: var(--bubble-self);
      border-bottom-left-radius: 15px 10px;
    }

    .meta {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: 4px;
      font-size: 0.7rem;
      opacity: 0.8;
    }

    .message.own .meta {
      justify-content: flex-end;
      color: var(--bubble-self-text);
      opacity: 0.7;
    }

    .message:not(.own) .meta {
      color: var(--text-subtle);
    }

    .author-name {
      font-weight: 600;
      font-size: 0.75rem;
      margin-bottom: 2px;
      display: block;
      color: var(--text-muted);
    }

    .message.own .author-name { display: none; } /* Hide own name for private messages */
    .message.own.group .author-name { display: block; } /* Show "You" for group messages */

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ==================================================
       Input Area
       ================================================== */
    .input-area {
      padding: 0.75rem 1.5rem 1.5rem 1.5rem;
      background: var(--bg-body);
      border-top: 1px solid var(--divider);
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .recipient-picker {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.25rem 0.5rem 0.25rem 1rem;
      background: var(--input-bg);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-full);
      font-size: 0.9rem;
      box-shadow: var(--shadow-sm);
    }
    .recipient-picker .material-symbols-outlined {
      font-size: 18px;
      color: var(--text-subtle);
    }
    #receiverSelect {
      flex-grow: 1;
      background: transparent;
      border: none;
      color: var(--text-main);
      font-family: var(--font-sans);
      cursor: pointer;
      outline: none;
      -webkit-appearance: none;
      appearance: none;
      padding: 0.4rem;
    }
    #receiverSelect:invalid {
      color: var(--text-subtle);
    }
    #receiverSelect option {
      background: var(--card-bg);
      color: var(--text-main);
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: flex-end;
      gap: 0.75rem;
      background: var(--input-bg);
      border: 1px solid var(--card-border);
      border-radius: 26px; /* Pill shape */
      padding: 0.5rem 0.5rem 0.5rem 1.25rem;
      transition: border-color 0.2s, box-shadow 0.2s;
      box-shadow: var(--shadow-sm);
    }

    .input-wrapper:focus-within {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(125, 132, 113, 0.1); /* Subtle glow using primary-ish color */
    }

    textarea {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      resize: none;
      min-height: 24px;
      max-height: 120px;
      font-family: var(--font-sans);
      font-size: 1rem;
      color: var(--text-main);
      padding: 0.6rem 0;
    }

    textarea::placeholder {
      color: var(--text-subtle);
    }

    .send-btn {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: var(--primary);
      color: var(--primary-fg);
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: transform 0.1s, opacity 0.2s;
      flex-shrink: 0;
    }

    .send-btn:hover {
      opacity: 0.9;
    }
    
    .send-btn:active {
      transform: scale(0.95);
    }
    
    .send-btn span {
        font-size: 20px;
        margin-left: 2px; /* Visual optical alignment */
    }

    /* Mobile adjustments */
    @media (max-width: 600px) {
      .chat-header { padding: 0 1rem; }
      .messages-viewport { padding: 1rem; }
      .input-area { padding: 0.75rem 1rem 1rem 1rem; }
      .message { max-width: 90%; }
    }

  </style>
</head>

<body>

  <div class="app-layout">
    <!-- Header -->
    <header class="chat-header">
      <div class="header-left">
        <a href="/campfire" class="back-btn" aria-label="Go back">
          <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <div class="header-info">
          <h1>Campfire Chat</h1>
          <p id="online-status">Connecting...</p>
        </div>
      </div>
      <div class="header-actions">
        <div class="theme-selector-wrapper">
            <span class="material-symbols-outlined icon-palette">palette</span>
            <select class="theme-select" id="theme-select" aria-label="Select Theme">
                <option value="light">Light</option>
                <option value="dark">Dark</option>
                <option value="sepia">Sepia</option>
                <option value="forest">Forest</option>
            </select>
            <span class="material-symbols-outlined icon-chevron">expand_more</span>
        </div>
      </div>
    </header>

    {{if .SuggestedUsers}}
    <!-- Suggested Users Section -->
    <section class="suggested-users-section">
      <h3>People with similar interests</h3>
      <div class="suggested-users-list">
        {{range .SuggestedUsers}}
        <button class="suggested-user" data-user-id="{{.ID}}" data-user-name="{{.Name}}">{{.Name}}</button>
        {{end}}
      </div>
    </section>
    {{end}}

    <!-- Messages Container -->
    <div class="messages-viewport" id="messages">
      <div class="date-divider">Today</div>
    </div>

    <!-- Input Area -->
    <div class="input-area">
      <div class="recipient-picker">
        <span class="material-symbols-outlined">alternate_email</span>
        <select id="receiverSelect" required>
          <option value="" disabled selected>Choose a recipient...</option>
          <option value="all">Campfire (Group Chat)</option>
          {{range .SuggestedUsers}}
          <option value="{{.ID}}">{{.Name}}</option>
          {{end}}
        </select>
      </div>
      <div class="input-wrapper">
      <textarea
        id="messageInput"
        placeholder="Type a message..."
        rows="1"
        oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'"
      ></textarea>
      <button class="send-btn" id="sendButton">
        <span class="material-symbols-outlined">send</span>
      </button>
      </div>
    </div>
  </div>

  <script>
    const htmlElement = document.documentElement;
    const storageKey = 'remainwith-theme';

    function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
    }

    function setCookie(name, value, days) {
        let expires = "";
        if (days) {
            const date = new Date();
            date.setTime(date.getTime() + (days*24*60*60*1000));
            expires = "; expires=" + date.toUTCString();
        }
        document.cookie = name + "=" + (value || "")  + expires + "; path=/";
    }

    const themeSelect = document.getElementById('theme-select');

    function setTheme(theme) {
        htmlElement.setAttribute('data-theme', theme);
        if (themeSelect) themeSelect.value = theme;
    }

    function loadTheme() {
        const savedTheme = getCookie(storageKey);
        if (savedTheme) {
            setTheme(savedTheme);
        } else {
            const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            setTheme(systemDark ? 'dark' : 'light');
        }
    }
    loadTheme();

    const messageInput = document.getElementById('messageInput');
    const sendButton = document.getElementById('sendButton');
    const messagesContainer = document.getElementById('messages');
    const receiverSelect = document.getElementById('receiverSelect');
    const suggestedUserButtons = document.querySelectorAll('.suggested-user');
    const userID = {{.UserID}};

    // WebSocket connection
    let ws = null;
    let reconnectAttempts = 0;
    const maxReconnectAttempts = 5;

    // Auto-scroll to bottom on load
    messagesContainer.scrollTop = messagesContainer.scrollHeight;

    function connectWebSocket() {
      if (ws && ws.readyState === WebSocket.OPEN) return;

      // Use the current page's protocol and host for WebSocket connection
      const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
      const wsUrl = `${protocol}//${window.location.host}/ws`;
      ws = new WebSocket(wsUrl);

      ws.onopen = function(event) {
        console.log('WebSocket connected');
        reconnectAttempts = 0;
      };

      ws.onmessage = function(event) {
        try {
          const message = JSON.parse(event.data);
          console.log('Received data:', message); // Debug logging

          if (message.type === 'user_count_update') {
            updateOnlineCount(message.count);
            return;
          }

          const isOwn = message.SenderID === userID.toString();
          addMessage(message, isOwn); // Add received message
        } catch (e) {
          console.error('Error parsing message:', e);
        }
      };

      ws.onclose = function(event) {
        console.log('WebSocket disconnected');
        if (reconnectAttempts < maxReconnectAttempts) {
          reconnectAttempts++;
          setTimeout(connectWebSocket, 1000 * reconnectAttempts);
        }
      };

      ws.onerror = function(error) {
        console.error('WebSocket error:', error);
      };
    }

    function updateOnlineCount(count) {
        const statusElement = document.getElementById('online-status');
        if (!statusElement) return;

        if (count > 1) {
            statusElement.textContent = `${count} people online`;
            statusElement.style.color = 'var(--primary)';
        } else if (count === 1) {
            statusElement.textContent = `You're the only one here`;
            statusElement.style.color = 'var(--text-muted)';
        } else {
            statusElement.textContent = `Connecting...`;
            statusElement.style.color = 'var(--text-subtle)';
        }
    }

    function getInitials(name) {
        if (!name || typeof name !== 'string') return '?';
        const parts = name.trim().split(' ').filter(Boolean);
        if (parts.length > 1) {
            return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
        }
        if (parts.length === 1 && parts[0].length > 1) {
            return parts[0].substring(0, 2).toUpperCase();
        }
        return name.substring(0, 1).toUpperCase();
    }

    function addMessage(message, isOwn = true, messageId = null) {
      const content = typeof message === 'string' ? message : message.Content;
      const isGroup = typeof message === 'object' && message.IsGroup;
      const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      const senderName = message.SenderName || 'Guest';

      const messageDiv = document.createElement('div');
      messageDiv.className = isOwn ? 'message own' : 'message';
      if (isGroup) messageDiv.classList.add('group');
      if (messageId) messageDiv.id = `msg-${messageId}`;

      let authorName = '';
      if (isGroup) {
        authorName = isOwn ? '<span class="author-name">You</span>' : `<span class="author-name">${senderName}</span>`;
      } else if (!isOwn) {
        authorName = `<span class="author-name">${senderName}</span>`;
      }

      // Status icon: clock for pending, check for sent
      const statusIcon = isOwn ? '<span class="material-symbols-outlined status-icon" style="font-size:12px">schedule</span>' : '';

      // Structure logic
      const innerContent = `
        <div class="avatar">${isOwn ? 'You' : getInitials(senderName)}</div>
        <div>
          ${authorName}
          <div class="bubble">
            ${content}
            <div class="meta">
                ${time}
                ${statusIcon}
            </div>
          </div>
        </div>
      `;

      messageDiv.innerHTML = innerContent;
      messagesContainer.appendChild(messageDiv);

      // Smooth scroll to bottom
      messagesContainer.scrollTo({
        top: messagesContainer.scrollHeight,
        behavior: 'smooth'
      });

      return messageDiv;
    }

    function updateMessageStatus(messageElement, success = true) {
      const statusIcon = messageElement.querySelector('.status-icon');
      if (statusIcon) {
        statusIcon.textContent = success ? 'done' : 'error';
        statusIcon.style.color = success ? 'var(--primary)' : '#ff6b6b';
      }
    }

    function sendMessage(content, receiverID) {
      if (!ws || ws.readyState !== WebSocket.OPEN) {
        console.error('WebSocket not connected');
        return false;
      }

      const message = {
        SenderID: userID.toString(),
        ReceiverID: receiverID,
        Content: content,
        IsGroup: receiverID === 'all',
        CreatedAt: new Date().toISOString()
      };

      try {
        ws.send(JSON.stringify(message));
        return true;
      } catch (e) {
        console.error('Error sending message:', e);
        return false;
      }
    }

    function handleSend() {
      const content = messageInput.value.trim();
      const receiverID = receiverSelect.value;
      if (!content || !receiverID) return;

      // Create message object for UI
      const messageObj = {
        Content: content,
        IsGroup: receiverID === 'all'
      };

      // Add message to UI immediately with pending status
      const messageElement = addMessage(messageObj, true);

      // Send via WebSocket
      const sent = sendMessage(content, receiverID);

      if (sent) {
        // Update status to sent after a brief delay to show the transition
        setTimeout(() => updateMessageStatus(messageElement, true), 100);
      } else {
        // Show error status
        setTimeout(() => updateMessageStatus(messageElement, false), 100);
      }

      // Clear input
      messageInput.value = '';
      messageInput.style.height = 'auto';
      messageInput.focus();
    }

    // Connect to WebSocket when page loads
    connectWebSocket();

    sendButton.addEventListener('click', handleSend);

    messageInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        handleSend();
      }
    });

    suggestedUserButtons.forEach(button => {
      button.addEventListener('click', () => {
        const userId = button.dataset.userId;
        receiverSelect.value = userId;

        // Update active state for visual feedback
        suggestedUserButtons.forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');

        // Optional: give focus to input
        messageInput.focus();
      });
    });

    // Theme Switcher Logic
    if (themeSelect) {
      themeSelect.addEventListener('change', (e) => {
            const theme = e.target.value;
            setTheme(theme);
            setCookie(storageKey, theme, 365); // Save theme choice for 1 year
      });
    }
  </script>
</body>
</html>