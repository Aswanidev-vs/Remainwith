<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Your Password - Remainwith</title>
    <style>
        /* Base reset */
        body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
        img { -ms-interpolation-mode: bicubic; }

        /* Typography & Core Styles */
        body {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            background-color: #FAF7F2; /* --bg */
            font-family: "Iowan Old Style", "Apple Garamond", "Baskerville", "Times New Roman", serif;
            color: #3E3A2F; /* --ink */
            -webkit-font-smoothing: antialiased;
        }

        .wrapper {
            width: 100%;
            table-layout: fixed;
            background-color: #FAF7F2;
            padding-bottom: 40px;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #FAF7F2;
        }

        /* Hero / Logo */
        .header {
            padding: 40px 0 20px 0;
            text-align: center;
        }

        .logo {
            width: 180px;
            height: auto;
            display: inline-block;
        }

        /* Content Card */
        .card {
            background-color: #E8E2D8; /* --soft */
            margin: 0 20px;
            padding: 40px 30px;
            border-radius: 8px;
            box-shadow: 0 4px 20px -5px rgba(62, 58, 47, 0.05);
            text-align: center;
        }

        h1 {
            font-size: 24px;
            font-weight: 400;
            margin-bottom: 20px;
            color: #3E3A2F;
            letter-spacing: -0.01em;
        }

        p {
            font-size: 18px;
            line-height: 1.6;
            margin-bottom: 30px;
            color: #3E3A2F;
        }

        /* Action Button */
        .btn-container {
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            background-color: #3E3A2F; /* --ink */
            color: #FAF7F2 !important; /* --bg */
            padding: 14px 32px;
            text-decoration: none;
            border-radius: 50px;
            font-size: 16px;
            font-weight: 400;
            transition: transform 0.2s ease;
        }

        /* Security Note */
        .footer {
            padding: 40px 20px;
            text-align: center;
            font-size: 14px;
            color: #7A7466; /* --muted */
        }

        .link-fallback {
            word-break: break-all;
            color: #D98A3A; /* --accent */
            text-decoration: none;
            font-size: 13px;
        }

        hr {
            border: 0;
            border-top: 1px solid #D98A3A; /* --accent */
            margin: 30px 0;
            opacity: 0.2;
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="container">
            <div class="header">
                <div style="color: #D98A3A; font-family: serif; font-size: 24px; letter-spacing: 4px; text-transform: uppercase; font-weight: 300;">
                    Remainwith
                </div>
                <div style="height: 1px; width: 40px; background-color: #D98A3A; margin: 15px auto; opacity: 0.3;"></div>
            </div>
            
            <div class="card">
                <h1>Password Reset Requested</h1>
                <p>
                    A password reset was requested for your account. If you did not request this, you can safely ignore this message.
                </p>
                
                <div class="btn-container">
                    <a href="{{.ResetLink}}" class="btn">Reset Password</a>
                </div>
                
                <p style="font-size: 15px; font-style: italic; color: #7A7466;">
                    This link is valid for 15 minutes.
                </p>
            </div>
            
            <div class="footer">
                &copy; {{.Year}} Remainwith. All rights reserved.<br>
                <em>Humanist connection, digitally preserved.</em>
            </div>
        </div>
    </div>
</body>
</html>